---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import { formatPrix, getPrestation } from "../data/tarifs";

const choix = getPrestation("choix-nouveau-velo");
const etude3D = getPrestation("etude-posturale-3d");

const faqItems = [
  {
    question: "Combien coûte un rendez-vous pour choisir un nouveau vélo ?",
    answer: `Le rendez-vous coûte ${formatPrix(choix.price)} et dure ${choix.duration}.`,
  },
  {
    question: "Dois-je venir avec le vélo que j'envisage d'acheter ?",
    answer:
      "Idéalement oui : nous validons alors directement la taille et l'ergonomie du modèle. Si le vélo n'est pas disponible, venez avec ses caractéristiques précises (taille, géométrie, longueur de potence) et votre vélo actuel comme point de comparaison.",
  },
  {
    question: "Ce rendez-vous remplace-t-il une étude posturale ?",
    answer: `Non. Il sert à sécuriser votre achat avant de commander le vélo. Une fois le vélo acquis, une étude posturale complète (${formatPrix(etude3D.price)} en 3D) permet de régler finement votre position.`,
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Aide au choix d'un nouveau vélo",
  serviceType: "Conseil à l'achat vélo",
  provider: { "@id": "https://id-postur.fr/#business" },
  areaServed: [
    { "@type": "City", name: "Rennes" },
    { "@type": "AdministrativeArea", name: "Ille-et-Vilaine" },
  ],
  description:
    "Validation de la taille et de l'ergonomie d'un vélo avant l'achat, à Rennes.",
  url: "https://id-postur.fr/choix-nouveau-velo",
  offers: {
    "@type": "Offer",
    price: String(choix.price),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: "https://id-postur.fr/choix-nouveau-velo",
  },
};
---

<BaseLayout
  title="Choisir son nouveau vélo à Rennes – Conseil avant achat | ID Postur"
  description={`Hésitation avant d'acheter un nouveau vélo ? ID Postur valide à Rennes la taille et l'ergonomie idéales avant l'achat. Rendez-vous de ${choix.duration} à ${formatPrix(choix.price)}.`}
  ogImage="/images/id-postur-img-1.webp"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema)}
    slot="head"
  />

  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-img-1.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white px-4">
      <h1 class="text-center">
        Choisissez votre nouveau vélo en toute confiance
      </h1>
      <div
        class="h-[3px] w-24 bg-rouge mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        Avant d'investir dans un nouveau vélo, <strong>ID Postur</strong> vous accompagne
        à Rennes pour valider la taille, l'ergonomie et la compatibilité avec votre
        morphologie. Un conseil éclairé qui évite les mauvais achats et prépare votre
        future étude posturale.
      </p>
    </div>
  </div>

  <section class="py-16">
    <div class="container px-5 mx-auto">
      <h2>
        Un rendez-vous court pour sécuriser votre achat
      </h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-10 rounded-full"></div>
      <div class="max-w-md">
        <Formulecomponent prestation={choix} highlight />
      </div>
    </div>
  </section>

  <AutresPrestations exclude="choix-nouveau-velo" />

  <section class="relative px-6 pb-16 overflow-hidden">
    <div class="relative max-w-5xl mx-auto text-center">
      <h2 id="faq" class="mb-4">
        En savoir plus
      </h2>
      <div class="h-[3px] w-24 bg-rouge mx-auto mb-6"></div>

      <div class="space-y-6 text-left">
        {
          faqItems.map((item) => (
            <details class="group bg-white border border-hairline rounded-xs p-6 transition">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <h3>{item.question}</h3>
                <span class="text-rouge transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none">
                  +
                </span>
              </summary>
              <p class="mt-4 leading-relaxed">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
