---
import Roll from "../components/Roll.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Formulecomponent from "../components/formulecomponent.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import { formatPrix, getPrestation } from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { SITE_URL } from "../data/entreprise";

const choix = getPrestation("choix-nouveau-velo");
const etude3D = getPrestation("etude-posturale-3d");

const faqItems = [
  {
    question: "Combien coûte un rendez-vous pour choisir un nouveau vélo ?",
    answer: `Le rendez-vous coûte ${formatPrix(choix.price)} et dure ${choix.duration}.`,
  },
  {
    question: "Dois-je venir avec le vélo que j'envisage d'acheter ?",
    answer:
      "Non, pas besoin : la séance se fait sur le Zwift Ride du studio, que Romain ajuste à vos mesures pour trouver la taille et l'ergonomie qui vous conviennent. Venez en tenue avec vos chaussures et vos cales. Si vous avez déjà repéré un modèle, apportez ses caractéristiques (taille, géométrie) pour qu'on les compare.",
  },
  {
    question: "Ce rendez-vous remplace-t-il une étude posturale ?",
    answer: `Non. Il sert à sécuriser votre achat avant de commander le vélo. Une fois le vélo acquis, une étude posturale complète (${formatPrix(etude3D.price)} en 3D) permet de régler finement votre position.`,
  },
];

const services = [
  noeudService({
    id: "choix-nouveau-velo",
    name: "Aide au choix d'un nouveau vélo",
    serviceType: "Conseil à l'achat vélo",
    description:
      "Validation de la taille et de l'ergonomie d'un vélo avant l'achat, à Rennes, par un spécialiste de l'étude posturale.",
    page: "/choix-nouveau-velo",
    prestations: [choix],
    image: `${SITE_URL}/images/choix-nouveau-velo-reglage.webp`,
  }),
];
---

<BaseLayout
  title="Choisir son nouveau vélo à Rennes – Conseil avant achat | ID Postur"
  description={`Hésitation avant d'acheter un nouveau vélo ? ID Postur valide à Rennes la taille et l'ergonomie idéales avant l'achat. Rendez-vous de ${choix.duration} à ${formatPrix(choix.price)}.`}
  ogImage="/images/choix-nouveau-velo-reglage.webp"
  faq={faqItems}
  schema={services}
>

  <PageHero
    ariane="Choix d'un nouveau vélo"
    pastille="Conseil avant l'achat à Rennes"
    titre={["Choisissez votre vélo ", "en confiance", "."]}
    intro="Avant d'investir dans un nouveau vélo, ID Postur vous accompagne sur le Zwift Ride du studio pour définir la taille, l'ergonomie et la compatibilité avec votre morphologie. Un conseil éclairé qui évite les mauvais achats et prépare votre future étude posturale."
    image="/images/choix-nouveau-velo-reglage.webp"
    alt="Validation de la taille d'un nouveau vélo chez ID Postur"
    puces={[`${formatPrix(choix.price)} · ${choix.duration}`, choix.disciplines]}
    ctas={[
      { href: "#formule", label: "Voir la formule" },
      { href: "/etudes-posturales", label: "Voir les études", secondaire: true },
    ]}
  />

  <section id="formule" class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-24 flex flex-col gap-10">
      <div class="flex flex-col gap-4">
        <p class="pastille bg-white">La formule</p>
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
          Un rendez-vous court pour <span class="accent">sécuriser</span> votre achat
        </h2>
      </div>
      <div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
        <Formulecomponent prestation={choix} ctaHref="/reserver?besoin=taille-velo" />
        <div class="flex flex-col gap-5 lg:self-start lg:sticky lg:top-24">
          <a href="/etudes-posturales" class="carte-survol sur-fond-sombre group flex grow flex-col gap-4 rounded-md bg-encre p-7 md:p-8">
            <h3 class="text-2xl md:text-[1.75rem] leading-tight tracking-[-0.03em] text-white">
              Et une fois le vélo <span class="accent">acheté</span> ?
            </h3>
            <p class="text-[15px] leading-relaxed text-[#b4b4bc]">
              L'étude posturale règle ensuite votre position sur votre nouveau vélo, au millimètre, avec la capture de mouvement STT.
            </p>
            <span class="mt-auto inline-flex items-center gap-2 text-[15px] font-medium text-white">
              <Roll texte="Découvrir les études" fleche="↗" />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <AutresPrestations exclude="choix-nouveau-velo" />

  <FaqListe items={faqItems} />
</BaseLayout>
