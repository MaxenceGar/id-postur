---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
---

<BaseLayout
  title="Rendez-vous divers à Rennes – Révision et réglage vélo | ID Postur"
  description="Besoin d'une révision rapide, d'un micro-réglage ou d'un conseil technique ponctuel sur votre vélo ? ID Postur propose 3 formules à Rennes : 15 min (25€), 30 min (50€) ou 1h (100€)."
  ogImage="/images/id-postur-interieur.jpg"
>
  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-interieur.jpg')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white px-4">
      <h1 class="text-3xl md:text-4xl font-bold text-center">
        Rendez-vous divers à Rennes
      </h1>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        Besoin d'une <strong>vérification rapide</strong>, d'un <strong
          >micro-réglage</strong
        > ou d'un <strong>conseil technique</strong> ponctuel ? Choisissez la durée
        qui correspond à votre besoin.
      </p>
    </div>
  </div>

  <section class="py-2 md:py-16">
    <div class="container px-2 md:px-5 py-2 md:py-24 mx-auto">
      <div>
        <h2 class="text-xl md:text-4xl font-bold">
          Trois formules pour répondre à votre besoin
        </h2>
        <div
          class="h-[3px] w-24 bg-id-postur-dark mt-4 mb-0 md:mb-10 rounded-full"
        >
        </div>
      </div>
      <div class="grid gap-8 md:grid-cols-3 py-10">
        <Formulecomponent
          baseline="Intervention rapide"
          title="RDV divers — 15 min"
          description="Vérification rapide, conseil technique ou micro-réglage sans test en pédalage."
          price="25€"
          time="15 minutes"
          link="https://calendly.com/idpostur/rendez-vous-divers-15-min"
          stack1="• Vélo"
          stack2=""
          stack3=""
          stack4=""
          stack5=""
        />
        <Formulecomponent
          baseline="Intervention étendue"
          title="RDV divers — 30 min"
          description="Révision ou réglage ponctuel avec test en pédalage pour valider la sensation en conditions réelles."
          price="50€"
          time="30 minutes"
          link="https://calendly.com/idpostur/rendez-vous-divers-30-min"
          stack1="• Vélo"
          stack2="• Chaussures"
          stack3="• Cuissard"
          stack4="• Tenue complète"
          stack5=""
        />
        <Formulecomponent
          baseline="Intervention complète"
          title="RDV divers — 1h"
          description="Session complète pour une révision approfondie, plusieurs réglages ou un accompagnement détaillé avec test en pédalage."
          price="100€"
          time="1 heure"
          link="https://calendly.com/idpostur/rendez-vous-divers-1h"
          stack1="• Vélo"
          stack2="• Chaussures"
          stack3="• Cuissard"
          stack4="• Tenue complète"
          stack5=""
        />
      </div>
    </div>
  </section>

  <div class="w-full flex justify-center pb-12">
    <a href="/" rel="nofollow">
      <button
        class="cursor-pointer inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
      >
        Revenir à l'accueil
      </button>
    </a>
  </div>
</BaseLayout>
