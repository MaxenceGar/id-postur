---
import Roll from "../components/Roll.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Formulecomponent from "../components/formulecomponent.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import { formatPrix, getPrestation } from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { SITE_URL } from "../data/entreprise";

const rdv = getPrestation("rendez-vous-divers");

const faqItems = [
  {
    question: "Que peut-on faire en 20 minutes ?",
    answer:
      "Une vérification rapide de votre position, un micro-réglage (hauteur de selle, recul, potence), un contrôle après un changement de composant ou une question technique précise sur votre vélo.",
  },
  {
    question: "Combien coûte un rendez-vous divers ?",
    answer: `Le rendez-vous coûte ${formatPrix(rdv.price)} pour ${rdv.duration}.`,
  },
  {
    question: "Quand faut-il plutôt une étude posturale complète ?",
    answer:
      "Dès qu'il s'agit de douleurs persistantes, d'un nouveau vélo ou d'une refonte de votre position. Le rendez-vous de 20 minutes sert aux ajustements ponctuels, pas à une analyse complète.",
  },
];

const services = [
  noeudService({
    id: "rendez-vous-divers",
    name: "Rendez-vous vélo ponctuel",
    serviceType: "Réglage vélo",
    description:
      "Rendez-vous court à Rennes pour un micro-réglage, une vérification rapide ou un conseil technique sur votre vélo.",
    page: "/rendez-vous-divers",
    prestations: [rdv],
    image: `${SITE_URL}/images/rendez-vous-ajustement-selle.webp`,
  }),
];
---

<BaseLayout
  title="Rendez-vous vélo à Rennes – Révision et micro-réglage | ID Postur"
  description={`Besoin d'une vérification rapide, d'un micro-réglage ou d'un conseil technique sur votre vélo ? ID Postur propose à Rennes un rendez-vous de ${rdv.duration} à ${formatPrix(rdv.price)}.`}
  ogImage="/images/rendez-vous-ajustement-selle.webp"
  faq={faqItems}
  schema={services}
>

  <PageHero
    ariane="Rendez-vous divers"
    pastille="Rendez-vous court à Rennes"
    titre={["Un réglage vélo ", "ponctuel", " à Rennes ?"]}
    intro="Besoin d'une vérification rapide, d'un micro-réglage ou d'un conseil technique ponctuel ? ID Postur vous reçoit pour un rendez-vous court, sans passer par une étude complète."
    image="/images/rendez-vous-ajustement-selle.webp"
    alt="Ajustement de la selle d'un vélo lors d'un rendez-vous court chez ID Postur"
    puces={[`${formatPrix(rdv.price)} · ${rdv.duration}`, rdv.disciplines]}
    ctas={[
      { href: "#formule", label: "Voir la formule" },
      { href: "/etudes-posturales", label: "Voir les études", secondaire: true },
    ]}
  />

  <section id="formule" class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-24 flex flex-col gap-10">
      <div class="flex flex-col gap-4">
        <p class="pastille bg-white">La formule</p>
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
          Un créneau court pour un <span class="accent">besoin précis</span>
        </h2>
      </div>
      <div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
        <Formulecomponent prestation={rdv} ctaHref="/reserver?besoin=micro-reglage" />
        <div class="flex flex-col gap-5 lg:self-start lg:sticky lg:top-24">
          <a href="/etudes-posturales" class="carte-survol sur-fond-sombre group flex grow flex-col gap-4 rounded-md bg-encre p-7 md:p-8">
            <h3 class="text-2xl md:text-[1.75rem] leading-tight tracking-[-0.03em] text-white">
              Besoin d'une <span class="accent">analyse complète</span> ?
            </h3>
            <p class="text-[15px] leading-relaxed text-[#b4b4bc]">
              L'étude posturale mesure votre position en 3D ou en 2D, puis règle entièrement votre vélo.
            </p>
            <span class="mt-auto inline-flex items-center gap-2 text-[15px] font-medium text-white">
              <Roll texte="Découvrir les études" fleche="↗" />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <AutresPrestations exclude="rendez-vous-divers" />

  <FaqListe items={faqItems} />
</BaseLayout>
