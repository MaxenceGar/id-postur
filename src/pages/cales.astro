---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout>
  <h3 class="text-center my-8 text-2xl font-bold">
    Nos offres pour le réglage de vos cales
  </h3>

  <div
    class="grid md:grid-cols-1 lg:grid-cols-2 gap-8 container px-5 py-24 mx-auto"
  >
    <!-- Début de widget en ligne Calendly -->
    <div
      class="calendly-inline-widget"
      data-url="https://calendly.com/idpostur/etude-posturale-complete-clone"
      style="min-width:320px;height:700px;"
    >
    </div>
    <script
      type="text/javascript"
      src="https://assets.calendly.com/assets/external/widget.js"
      async></script>
    <!-- Fin de widget en ligne Calendly -->
    <!-- Réglages cales -->
    <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
      <div class="p-6 flex-1 flex flex-col">
        <h3 class="text-xl font-semibold text-gray-900 mb-2">Réglages cales</h3>
        <p class="text-sm text-gray-500 mb-4">
          Positionnement précis de vos cales pour un pédalage fluide et
          efficace.
        </p>
        <div class="mb-4">
          <span class="text-3xl font-bold text-gray-900">50€</span>
        </div>
        <p class="text-sm font-medium text-gray-700 mb-4">
          ⏱ Durée : <span class="font-semibold">30 minutes</span>
        </p>
        <ul class="text-sm text-gray-600 space-y-1 mb-6">
          <li>Équipement à apporter :</li>
          <li>• Vélo</li>
          <li>• Chaussures</li>
          <li>• Cuissard</li>
          <li>• Maillot</li>
          <li>• Pièces spécifiques à votre vélo</li>
        </ul>
        <div class="mt-auto">
          <button
            class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
          >
            Prendre rendez-vous
          </button>
        </div>
      </div>
    </div>

    <!-- Réglages changement de cales / nouvelles chaussures -->
    <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
      <div class="p-6 flex-1 flex flex-col">
        <h3 class="text-xl font-semibold text-gray-900 mb-2">
          Nouvelles cales ou nouvelles chaussures
        </h3>
        <p class="text-sm text-gray-500 mb-4">
          Ajustement après changement de matériel.
        </p>
        <div class="mb-4">
          <span class="text-3xl font-bold text-gray-900">30€</span>
        </div>
        <p class="text-sm font-medium text-gray-700 mb-4">
          ⏱ Durée : <span class="font-semibold">20 minutes</span>
        </p>
        <ul class="text-sm text-gray-600 space-y-1 mb-6">
          <li>Équipement à apporter :</li>
          <li>• Vélo</li>
          <li>• Chaussures</li>
          <li>• Cuissard</li>
          <li>• Maillot</li>
          <li>• Pièces spécifiques à votre vélo</li>
        </ul>
        <div class="mt-auto">
          <button
            class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
          >
            Ajuster mes nouvelles cales
          </button>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
