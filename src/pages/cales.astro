---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import { formatPrix, getPrestation } from "../data/tarifs";

const cales = getPrestation("reglage-cales");

const faqItems = [
  {
    question: "Combien de temps dure le réglage des cales ?",
    answer: `Le réglage des cales dure ${cales.duration}.`,
  },
  {
    question: "Quel est le prix pour le réglage des cales ?",
    answer: `Le réglage de vos cales coûte ${formatPrix(cales.price)}, quel que soit le nombre de vos passages chez ID Postur.`,
  },
  {
    question: "Avec quel équipement dois-je venir ?",
    answer:
      "Le jour du rendez-vous, venez avec votre vélo, votre paire de chaussures, vos cales à régler ainsi que votre tenue de vélo.",
  },
  {
    question: "Le réglage des cales est-il inclus dans l'étude posturale ?",
    answer:
      "Oui. Le positionnement des cales fait partie intégrante de l'étude posturale 3D comme de l'étude posturale 2D. Ce rendez-vous de 20 minutes s'adresse à ceux qui souhaitent uniquement régler leurs cales, par exemple après un changement de chaussures.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: { "@type": "Answer", text: item.answer },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Réglage des cales de vélo",
  serviceType: "Réglage des cales cycliste",
  provider: { "@id": "https://id-postur.fr/#business" },
  areaServed: [
    { "@type": "City", name: "Rennes" },
    { "@type": "AdministrativeArea", name: "Ille-et-Vilaine" },
  ],
  description:
    "Réglage des cales de vélo à Rennes, au millimètre près. Positionnement précis pour route, VTT, gravel et chrono.",
  url: "https://id-postur.fr/cales",
  offers: {
    "@type": "Offer",
    price: String(cales.price),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: "https://id-postur.fr/cales",
  },
};
---

<BaseLayout
  title="Réglage des cales vélo à Rennes | ID Postur"
  description={`Réglage professionnel des cales de vélo à Rennes, au millimètre près. Positionnement précis pour route, VTT, gravel et chrono. ${formatPrix(cales.price)} pour ${cales.duration}.`}
  ogImage="/images/id-postur-cales.webp"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema)}
    slot="head"
  />

  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-cales.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white px-4">
      <h1 class="text-center">
        Réglage des cales vélo à Rennes
      </h1>
      <div
        class="h-[3px] w-24 bg-rouge mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        <span class="font-bold">ID Postur</span> vous aide à trouver le positionnement
        idéal de vos <span class="font-bold">cales</span>, au millimètre près. Que vous pratiquiez la
        <span class="font-bold">route, le VTT, le gravel ou le chrono</span>, un
        réglage précis améliore votre confort, votre efficacité de pédalage et
        limite les risques de blessures.
      </p>
      <div class="inline-block mx-auto">
        <a
          class="btn-primaire btn-fleche"
          href="/etudes-posturales"
        >
          Voir les études posturales
        </a>
      </div>
    </div>
  </div>

  <section class="py-16">
    <div class="container px-5 mx-auto">
      <h2>Le réglage des cales</h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-10 rounded-full"></div>
      <div class="max-w-md">
        <Formulecomponent prestation={cales} highlight />
      </div>
    </div>
  </section>

  <AutresPrestations exclude="reglage-cales" />

  <section class="relative px-6 pb-16 overflow-hidden">
    <div class="relative max-w-5xl mx-auto text-center">
      <h2 id="faq" class="mb-4">
        En savoir plus
      </h2>
      <div class="h-[3px] w-24 bg-rouge mx-auto mb-6"></div>

      <div class="space-y-6 text-left">
        {
          faqItems.map((item) => (
            <details class="group bg-white border border-hairline rounded-xs p-6 transition">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <h3>{item.question}</h3>
                <span class="text-rouge transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none">
                  +
                </span>
              </summary>
              <p class="mt-4 leading-relaxed">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
