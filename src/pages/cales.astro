---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout>
  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-cales.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white">
      <h3 class="text-3xl md:text-4xl font-bold text-center">
        Nos offres pour le réglage de vos cales
      </h3>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        Grâce à la technologie <span class="font-bold">ID Match</span>,
        <span class="font-bold">ID Postur</span> vous aide à trouver le positionnement
        idéal de vos <span class="font-bold">cales</span>. Que vous pratiquiez
        la <span class="font-bold"
          >Route, le VTT, le Gravel ou le Triathlon</span
        >, un réglage précis améliore votre confort, votre efficacité de
        pédalage et limite les risques de blessures.
      </p>
      <div class="inline-block mx-auto">
        <a
          class="text-center inline-block px-6 py-2 bg-id-postur-dark text-white font-medium hover:opacity-90 transition duration-300 cursor-pointer"
          href="/etudes-posturales"
          rel="nofollow"
        >
          Étude Posturale
        </a>
      </div>
    </div>
  </div>

  <div
    class="grid md:grid-cols-1 lg:grid-cols-2 gap-8 container px-5 py-24 mx-auto"
  >
    <div class="p-6 flex-1 flex flex-col border-1 border-gray-100">
      <h3 class="text-xl font-semibold text-gray-900 mb-2">
        Réglages cales/chaussures
      </h3>
      <p class="text-sm text-gray-500 mb-4">
        Positionnement précis de vos cales pour un pédalage fluide et efficace.
      </p>
      <div class="mb-4">
        <span class="text-3xl font-bold text-gray-900">50€</span>
      </div>
      <p class="text-sm font-medium text-gray-700 mb-4">
        ⏱ Durée : <span class="font-semibold">30 minutes</span>
      </p>
      <ul class="text-base text-gray-950 space-y-1 mb-6">
        <li>Équipement à apporter :</li>
        <li>• Chaussures</li>
        <li>• Vélo</li>
        <li>• Cales</li>
        <li>• Tenue de vélo</li>
      </ul>
      <div class="mt-auto">
        <a
          href="https://calendly.com/idpostur/reglage-des-cales"
          rel="nofollow"
        >
          <button
            class="cursor-pointer w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
          >
            Prendre rendez-vous
          </button>
        </a>
      </div>
    </div>

    <div class="p-6 flex-1 flex flex-col border-1 border-gray-100">
      <h3 class="text-xl font-semibold text-gray-900 mb-2">
        Réglages nouvelles cales/chaussures
      </h3>
      <p class="text-sm text-gray-500 mb-4">
        Re-positionnement précis de vos cales/chaussures
      </p>
      <div class="mb-4">
        <span class="text-3xl font-bold text-gray-900">20€</span>
      </div>
      <p class="text-sm font-medium text-gray-700 mb-4">
        ⏱ Durée : <span class="font-semibold">30 minutes</span>
      </p>
      <ul class="text-base text-gray-950 space-y-1 mb-6">
        <li>Équipement à apporter :</li>
        <li>• Nouvelles chaussures</li>
        <li>• Nouvelles cales</li>
        <li>• Vélo</li>
        <li>• Cales</li>
        <li>• Tenue de vélo</li>
      </ul>
      <div class="mt-auto">
        <a
          href="https://calendly.com/idpostur/reglages-nouvelles-cales-chaussures"
          rel="nofollow"
        >
          <button
            class="cursor-pointer w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
          >
            Prendre rendez-vous
          </button>
        </a>
      </div>
    </div>
  </div>

  <section class="relative px-6 overflow-hidden">
    <div class="relative max-w-5xl mx-auto text-center">
      <h2 id="faq" class="text-3xl md:text-4xl font-extrabold mb-4">
        En savoir plus
      </h2>
      <div class="h-[3px] w-24 bg-id-postur-dark mx-auto mb-6"></div>

      <!-- Bloc FAQ -->
      <div class="space-y-6 text-left">
        <!-- Question 1 -->
        <details class="group bg-white border border-gray-200 p-6 transition">
          <summary
            class="flex items-center justify-between cursor-pointer list-none"
          >
            <h3 class="text-lg font-semibold">
              Combien de temps dure un le réglage des cales ?
            </h3>
            <span
              class="text-[#F80000] transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none"
              >+</span
            >
          </summary>
          <p class="mt-4 leading-relaxed">
            La durée des réglages des cales est de 30 minutes.
          </p>
        </details>

        <!-- Question 2 -->
        <details class="group bg-white border border-gray-200 p-6 transition">
          <summary
            class="flex items-center justify-between cursor-pointer list-none"
          >
            <h3 class="text-lg font-semibold">
              Quelle est le prix pour le réglage des cales ?
            </h3>
            <span
              class="text-[#F80000] transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none"
              >+</span
            >
          </summary>
          <p>Le prix pour réaliser le réglage de vos cales de 50€.</p>
        </details>

        <!-- Question 3 -->
        <details class="group bg-white border border-gray-200 p-6 transition">
          <summary
            class="flex items-center justify-between cursor-pointer list-none"
          >
            <h3 class="text-lg font-semibold">
              Avec quel équipement dois-je venir ?
            </h3>
            <span
              class="text-[#F80000] transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none"
              >+</span
            >
          </summary>
          <p class="mt-4 leading-relaxed">
            Le jour du rendez-vous, venez avec votre vélo, votre paire de
            chaussure et vos cales que vous souhaitez régler ainsi que votre
            tenue de vélo.
          </p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
