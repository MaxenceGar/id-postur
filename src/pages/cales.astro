---
import Roll from "../components/Roll.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Formulecomponent from "../components/formulecomponent.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import { formatPrix, getPrestation } from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { SITE_URL } from "../data/entreprise";

const cales = getPrestation("reglage-cales");

const faqItems = [
  {
    question: "Combien de temps dure le réglage des cales ?",
    answer: `Le réglage des cales dure ${cales.duration}.`,
  },
  {
    question: "Quel est le prix pour le réglage des cales ?",
    answer: `Le réglage de vos cales coûte ${formatPrix(cales.price)}, quel que soit le nombre de vos passages chez ID Postur.`,
  },
  {
    question: "Avec quel équipement dois-je venir ?",
    answer:
      "Le jour du rendez-vous, venez avec votre vélo, votre paire de chaussures, vos cales à régler ainsi que votre tenue de vélo.",
  },
  {
    question: "Le réglage des cales est-il inclus dans l'étude posturale ?",
    answer:
      "Oui. Le positionnement des cales fait partie intégrante de l'étude posturale 3D comme de l'étude posturale 2D. Ce rendez-vous de 20 minutes s'adresse à ceux qui souhaitent uniquement régler leurs cales, par exemple après un changement de chaussures.",
  },
];

const services = [
  noeudService({
    id: "reglage-cales",
    name: "Réglage des cales de vélo",
    serviceType: "Réglage des cales cycliste",
    description:
      "Réglage des cales de vélo à Rennes, au millimètre près. Positionnement précis pour la route, le VTT, le gravel et le chrono.",
    page: "/cales",
    prestations: [cales],
    image: `${SITE_URL}/images/reglage-cales-pedale.webp`,
  }),
];
---

<BaseLayout
  title="Réglage des cales vélo à Rennes | ID Postur"
  description={`Réglage professionnel des cales de vélo à Rennes, au millimètre près. Positionnement précis pour route, VTT, gravel et chrono. ${formatPrix(cales.price)} pour ${cales.duration}.`}
  ogImage="/images/reglage-cales-pedale.webp"
  faq={faqItems}
  schema={services}
>

  <PageHero
    ariane="Réglage des cales"
    pastille="Réglage des cales vélo à Rennes"
    titre={["Vos cales, ", "au millimètre", "."]}
    intro="ID Postur vous aide à trouver le positionnement idéal de vos cales. Que vous pratiquiez la route, le VTT, le gravel ou le chrono, un réglage précis améliore votre confort, votre efficacité de pédalage et limite les risques de blessure."
    image="/images/reglage-cales-pedale.webp"
    alt="Réglage des cales d'un cycliste sur la pédale, chez ID Postur"
    puces={[`${formatPrix(cales.price)} · ${cales.duration}`, cales.disciplines]}
    ctas={[
      { href: "#formule", label: "Voir la formule" },
      { href: "/etudes-posturales", label: "Voir les études", secondaire: true },
    ]}
  />

  <section id="formule" class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-24 flex flex-col gap-10">
      <div class="flex flex-col gap-4">
        <p class="pastille bg-white">Le réglage</p>
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
          Le réglage des <span class="accent">cales</span>
        </h2>
      </div>
      <div class="grid gap-5 lg:grid-cols-[1.4fr_1fr]">
        <Formulecomponent prestation={cales} />
        <div class="flex flex-col gap-5 lg:self-start lg:sticky lg:top-24">
          <a href="/etudes-posturales" class="carte-survol sur-fond-sombre group flex grow flex-col gap-4 rounded-md bg-encre p-7 md:p-8">
            <h3 class="text-2xl md:text-[1.75rem] leading-tight tracking-[-0.03em] text-white">
              Déjà inclus dans <span class="accent">l'étude posturale</span>.
            </h3>
            <p class="text-[15px] leading-relaxed text-[#b4b4bc]">
              Le positionnement des cales fait partie de l'étude 3D comme de l'étude 2D. Ce rendez-vous de 20 minutes s'adresse à ceux qui veulent uniquement régler leurs cales, par exemple après un changement de chaussures.
            </p>
            <span class="mt-auto inline-flex items-center gap-2 text-[15px] font-medium text-white">
              <Roll texte="Découvrir les études" fleche="↗" />
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <AutresPrestations exclude="reglage-cales" />

  <FaqListe items={faqItems} />
</BaseLayout>
