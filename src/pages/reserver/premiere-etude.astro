---
import { ENTREPRISE } from "../../data/entreprise";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import Formulecomponent from "../../components/formulecomponent.astro";
import {
  ETUDES_PREMIERE_VISITE,
  OFFRES_PARTICULIERES,
} from "../../data/tarifs";

/** Étape finale du parcours de réservation — noindex, cf. /reserver. */
---

<BaseLayout
  title="Première étude posturale – Réserver | ID Postur"
  description="Formules d'étude posturale 3D et 2D pour une première venue chez ID Postur."
  noindex={true}
>
  <section class="bg-brume">
    <div class="max-w-5xl mx-auto px-5 md:px-8 py-12 md:py-20">
      <nav aria-label="Fil d'ariane" class="mb-8 flex items-center gap-2 text-[13px] font-medium text-encre-3">
        <a href="/reserver" class="hover:text-encre transition-colors"
          >Réserver</a
        > <span aria-hidden="true">/</span> <span class="text-encre">Première étude posturale</span>
      </nav>

      <h1 class="text-3xl md:text-5xl leading-[1.06] tracking-[-0.035em] mb-4">
        Votre première <span class="accent">étude posturale</span>
      </h1>
      <p class="text-encre-2 mb-12 max-w-2xl">
        Deux formats au choix. L'étude 3D couvre toutes les disciplines, chrono
        et triathlon compris&nbsp;; l'étude 2D s'adresse à la route, au VTT et au
        gravel. Dans les deux cas, venez avec votre vélo et votre tenue
        complète.
      </p>

      <div class="grid gap-5 md:grid-cols-2">
        {
          ETUDES_PREMIERE_VISITE.map((prestation, index) => (
            <Formulecomponent prestation={prestation} highlight={index === 0} />
          ))
        }
      </div>

      <section class="mt-16">
        <h2 class="text-2xl md:text-4xl leading-[1.1] tracking-[-0.03em] mb-3">Offre <span class="accent">particulière</span></h2>
        <p class="text-encre-2 mb-8 max-w-2xl">
          Une formule à tarif unique pour les jeunes cyclistes, réalisée avec
          la technologie d'analyse 2D sur une séance d'1h30.
        </p>

        <div class="grid gap-5 md:grid-cols-2">
          {
            OFFRES_PARTICULIERES.map((prestation) => (
              <Formulecomponent prestation={prestation} />
            ))
          }
        </div>
      </section>

      <div class="mt-12 text-center text-sm text-encre-2">
        <p>
          Vous êtes déjà venu chez ID Postur&nbsp;? <a
            href="/reserver/deja-client"
            class="text-encre font-semibold underline underline-offset-4 hover:opacity-80"
            >Accédez au tarif réduit</a
          >.
        </p>
        <p class="mt-4">
          Une question avant de réserver&nbsp;? Écrivez-nous à <a
            href={`mailto:${ENTREPRISE.email}`}
            class="text-encre font-semibold">{ENTREPRISE.email}</a
          >.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
