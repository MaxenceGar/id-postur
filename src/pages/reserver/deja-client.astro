---
import { ENTREPRISE } from "../../data/entreprise";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import Formulecomponent from "../../components/formulecomponent.astro";
import { ETUDES_DEJA_CLIENT } from "../../data/tarifs";

/** Étape finale du parcours de réservation — noindex, cf. /reserver. */
---

<BaseLayout
  title="Étude posturale – tarif client existant | ID Postur"
  description="Formules d'étude posturale 3D et 2D au tarif réduit, réservées aux cyclistes déjà venus chez ID Postur."
  noindex={true}
>
  <section class="bg-brume">
    <div class="max-w-5xl mx-auto px-5 md:px-8 py-12 md:py-20">
      <nav aria-label="Fil d'ariane" class="mb-8 flex items-center gap-2 text-[13px] font-medium text-encre-3">
        <a href="/reserver" class="hover:text-encre transition-colors"
          >Réserver</a
        > <span aria-hidden="true">/</span> <span class="text-encre">Déjà client</span>
      </nav>

      <h1 class="text-3xl md:text-5xl leading-[1.06] tracking-[-0.035em] mb-4">
        Votre nouvelle <span class="accent">étude posturale</span>
      </h1>
      <p class="text-encre-2 mb-6 max-w-2xl">
        Nous disposons déjà de vos mesures&nbsp;: vous bénéficiez du tarif réduit,
        sans limite de temps depuis votre première étude.
      </p>

      <!--
        Garde-fou&nbsp;: des cyclistes qui venaient pour la première fois
        réservaient ce créneau au tarif réduit. Les boutons de réservation
        restent masqués tant que la case n'est pas cochée (CSS seul,
        cf. .cta-verrouille dans global.css).
      -->
      <div class="rounded-md bg-white p-6 md:p-8 mb-10">
        <h2 class="font-id-postur text-xl font-semibold tracking-[-0.02em] text-encre mb-3">
          Avant de réserver, vérifions votre situation
        </h2>
        <p class="text-sm text-encre-2 mb-3">
          Le tarif réduit est réservé aux cyclistes qui ont déjà réalisé une
          <strong>étude posturale complète (3D ou 2D) chez ID Postur</strong>, à
          La Mézière.
        </p>
        <p class="text-sm text-encre-2 mb-5">
          <strong>Ne compte pas&nbsp;:</strong> une étude posturale faite ailleurs, un
          réglage de cales, un conseil avant l'achat d'un vélo ou un rendez-vous
          court.
        </p>

        <label
          for="confirmation-deja-client"
          class="flex items-start gap-3 cursor-pointer rounded bg-brume border border-filet p-4 transition-colors has-[:checked]:border-encre has-[:checked]:bg-rose"
        >
          <input
            type="checkbox"
            id="confirmation-deja-client"
            class="mt-0.5 size-5 shrink-0 accent-[#161616]"
          />
          <span class="text-sm font-semibold text-encre">
            Je confirme avoir déjà réalisé une étude posturale complète chez ID
            Postur.
          </span>
        </label>

        <p class="text-sm text-encre-2 mt-5">
          Ce n'est pas votre cas&nbsp;?
          <a
            href="/reserver/premiere-etude"
            class="text-encre font-semibold underline underline-offset-4 hover:opacity-80"
            >Réservez une première étude posturale</a
          > : le protocole et la durée ne sont pas les mêmes.
        </p>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        {
          ETUDES_DEJA_CLIENT.map((prestation, index) => (
            <Formulecomponent
              prestation={prestation}
              highlight={index === 0}
              verrouille
            />
          ))
        }
      </div>

      <div class="mt-12 text-center text-sm text-encre-2">
        <p>
          Un doute sur votre situation&nbsp;? Appelez-nous au <a
            href={`tel:${ENTREPRISE.telephone}`}
            class="text-encre font-semibold">{ENTREPRISE.telephoneAffiche}</a
          > avant de bloquer un créneau.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
