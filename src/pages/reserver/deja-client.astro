---
import { ENTREPRISE } from "../../data/entreprise";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import Formulecomponent from "../../components/formulecomponent.astro";
import { ETUDES_DEJA_CLIENT } from "../../data/tarifs";

/** Étape finale du parcours de réservation — noindex, cf. /reserver. */
---

<BaseLayout
  title="Étude posturale – tarif client existant | ID Postur"
  description="Formules d'étude posturale 3D et 2D au tarif réduit, réservées aux cyclistes déjà venus chez ID Postur."
  noindex={true}
>
  <section class="container mx-auto px-5 py-16 md:py-24">
    <div class="max-w-4xl mx-auto">
      <nav aria-label="Fil d'ariane" class="mb-8 text-sm text-gray-500">
        <a href="/reserver" class="hover:text-id-postur-dark underline"
          >Réserver</a
        > <span aria-hidden="true">›</span> Déjà client
      </nav>

      <h1 class="text-3xl md:text-4xl font-bold">
        Votre nouvelle étude posturale
      </h1>
      <div class="h-[3px] w-24 bg-id-postur-dark mt-4 mb-6 rounded-full"></div>
      <p class="text-gray-700 mb-6 max-w-2xl">
        Nous disposons déjà de vos mesures : vous bénéficiez du tarif réduit,
        sans limite de temps depuis votre première étude.
      </p>

      <!--
        Garde-fou : des cyclistes qui venaient pour la première fois
        réservaient ce créneau au tarif réduit. Les boutons de réservation
        restent masqués tant que la case n'est pas cochée (CSS seul,
        cf. .cta-verrouille dans global.css).
      -->
      <div class="border-2 border-id-postur-dark bg-white p-6 mb-12 max-w-2xl">
        <h2 class="text-lg font-semibold text-gray-900 mb-3">
          Avant de réserver, vérifions votre situation
        </h2>
        <p class="text-sm text-gray-700 mb-3">
          Le tarif réduit est réservé aux cyclistes qui ont déjà réalisé une
          <strong>étude posturale complète (3D ou 2D) chez ID Postur</strong>, à
          La Mézière.
        </p>
        <p class="text-sm text-gray-700 mb-5">
          <strong>Ne compte pas :</strong> une étude posturale faite ailleurs, un
          réglage de cales, un conseil avant l'achat d'un vélo ou un rendez-vous
          court.
        </p>

        <label
          for="confirmation-deja-client"
          class="flex items-start gap-3 cursor-pointer bg-gray-50 border border-gray-200 p-4 has-[:checked]:border-id-postur-dark has-[:checked]:bg-id-postur/5"
        >
          <input
            type="checkbox"
            id="confirmation-deja-client"
            class="mt-0.5 size-5 shrink-0 accent-[#C00201]"
          />
          <span class="text-sm font-semibold text-gray-900">
            Je confirme avoir déjà réalisé une étude posturale complète chez ID
            Postur.
          </span>
        </label>

        <p class="text-sm text-gray-700 mt-5">
          Ce n'est pas votre cas ?
          <a
            href="/reserver/premiere-etude"
            class="text-id-postur-dark font-semibold underline hover:opacity-80"
            >Réservez une première étude posturale</a
          > : le protocole et la durée ne sont pas les mêmes.
        </p>
      </div>

      <div class="grid gap-8 md:grid-cols-2">
        {
          ETUDES_DEJA_CLIENT.map((prestation, index) => (
            <Formulecomponent
              prestation={prestation}
              highlight={index === 0}
              verrouille
            />
          ))
        }
      </div>

      <div class="mt-12 text-center text-sm text-gray-600">
        <p>
          Un doute sur votre situation ? Appelez-nous au <a
            href={`tel:${ENTREPRISE.telephone}`}
            class="text-id-postur-dark font-semibold">{ENTREPRISE.telephoneAffiche}</a
          > avant de bloquer un créneau.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
