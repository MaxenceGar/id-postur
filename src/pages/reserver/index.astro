<script is:inline>
  (() => {
    const racine = document.getElementById("parcours");
    const barre = racine.querySelector("[data-barre]");
    const compteur = racine.querySelector("[data-compteur]");
    const boutonRetour = racine.querySelector("[data-retour]");

    /** Réponses en cours, et pile des écrans pour le bouton retour. */
    let reponses = {};
    let pile = [];
    const libelles = [];

    const CLIENTS_SEULEMENT = ["nouveau-velo", "cales", "micro-reglage", "prolongateurs", "taille-velo"];
    const RESULTAT_COURT = {
      cales: "client-cales",
      "micro-reglage": "client-micro-reglage",
      prolongateurs: "client-prolongateurs",
      "taille-velo": "client-taille-velo",
    };

    /** Mesure GA4, seulement si le visiteur a accepté (gtag.js chargé). */
    function mesurer(etape, choix) {
      if (window.google_tag_data && typeof window.gtag === "function") {
        window.gtag("event", "parcours_reservation", { etape, choix });
      }
    }

    /** Après le vélo : option selle en 2D, récapitulatif en 3D (selle comprise). */
    function apresVelo() {
      return reponses.format === "3d" ? `resultat-etude-3d-${reponses.velo}` : "selle";
    }

    /** Après le format : on saute ce qui est déjà connu (cas d'un refus). */
    function apresFormat() {
      const r = reponses;
      if (r.client !== "non") return "client";
      return r.velo ? apresVelo() : "velo";
    }

    /** Écran suivant selon l'écran courant et la réponse. */
    function suivant(etape, choix) {
      const r = reponses;
      switch (etape) {
        case "besoin":
          r.besoin = choix;
          return CLIENTS_SEULEMENT.includes(choix) ? "client-court" : "format";
        case "format":
          if (choix === "aide") return "aide-chrono";
          r.format = choix;
          return apresFormat();
        case "aide-chrono":
          if (choix === "oui") {
            r.format = "3d";
            return apresFormat();
          }
          return "aide-route";
        case "aide-route":
          r.format = choix;
          return apresFormat();
        case "client":
          r.client = choix;
          if (choix === "oui") return `resultat-client-etude-${r.format}`;
          return "velo";
        case "velo":
          r.velo = choix;
          return apresVelo();
        case "selle":
          return `resultat-etude-2d-${r.velo}${choix === "avec" ? "-selle" : ""}`;
        case "client-court":
          if (choix === "non") return "refus";
          if (r.besoin === "nouveau-velo") return "mise-en-position";
          return `resultat-${RESULTAT_COURT[r.besoin]}`;
        case "mise-en-position":
          return `resultat-client-mise-en-position-${choix}`;
        case "refus":
          // Il vient de dire qu'il n'est pas client : on ne repose pas la question.
          reponses = { besoin: "etude", client: "non" };
          if (choix === "etude-studio") reponses.velo = "studio";
          return "format";
      }
    }

    /** Questions qui restent après l'écran `id`, d'après ce qu'on sait déjà. */
    function restantes(id) {
      const r = reponses;
      const apresClient = () =>
        r.client === "oui" ? 0 : (r.velo ? 0 : 1) + (r.format === "2d" ? 1 : 0);
      switch (id) {
        case "besoin":
          return 3;
        case "format":
        case "aide-chrono":
        case "aide-route":
          return (r.client ? 0 : 1) + apresClient();
        case "client":
          return (r.velo ? 0 : 1) + (r.format === "2d" ? 1 : 0);
        case "velo":
          return r.format === "2d" ? 1 : 0;
        case "client-court":
          return r.besoin === "nouveau-velo" ? 1 : 0;
        case "refus":
          return 1 + (r.velo ? 0 : 1);
        default:
          return 0;
      }
    }

    function afficher(id, sens = "avant") {
      const cible = racine.querySelector(`[data-etape="${id}"]`);
      if (!cible) return;
      racine.querySelectorAll(".etape").forEach((e) => {
        e.hidden = e !== cible;
        e.classList.remove("etape-entree", "etape-retour", "resultat-entree");
      });
      const estResultat = cible.hasAttribute("data-resultat");
      void cible.offsetWidth; // relance l'animation
      cible.classList.add(estResultat ? "resultat-entree" : sens === "avant" ? "etape-entree" : "etape-retour");

      const n = pile.length + 1;
      const total = n + restantes(id);
      const pourcent = estResultat ? 100 : Math.round((n / (total + 1)) * 100);
      barre.style.width = Math.max(8, pourcent) + "%";
      compteur.textContent = estResultat ? "Votre rendez-vous" : `Étape ${n} sur ${total}`;
      boutonRetour.disabled = pile.length === 0;

      if (estResultat) {
        const recap = cible.querySelector("[data-recap]");
        if (recap) recap.textContent = "Vos réponses : " + libelles.join(" · ");
        // Le calendrier (script plus bas) vient se placer dans ce récapitulatif.
        racine.dispatchEvent(
          new CustomEvent("parcours:resultat", { detail: { section: cible, libelles: [...libelles] } }),
        );
      }
      const titre = cible.querySelector(".etape-titre");
      if (titre && sens !== "init") titre.focus({ preventScroll: true });
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    function courant() {
      return racine.querySelector(".etape:not([hidden])").dataset.etape;
    }

    function avancer(vers, choix, libelle) {
      if (!racine.querySelector(`[data-etape="${vers}"]`)) {
        console.error("[parcours] écran introuvable :", vers);
        return;
      }
      const depuis = courant();
      pile.push({ ecran: depuis, reponses: { ...reponses }, nbLibelles: libelles.length });
      if (libelle) libelles.push(libelle);
      mesurer(depuis, choix);
      history.pushState({ parcours: pile.length }, "");
      afficher(vers, "avant");
    }

    function reculer() {
      const precedent = pile.pop();
      if (!precedent) return;
      reponses = precedent.reponses;
      libelles.length = precedent.nbLibelles;
      afficher(precedent.ecran, "retour");
    }

    racine.addEventListener("click", (e) => {
      const bouton = e.target.closest("[data-choix]");
      if (bouton) {
        const etape = courant();
        const choix = bouton.dataset.choix;
        avancer(suivant(etape, choix), choix, bouton.dataset.libelle);
        return;
      }
      const direct = e.target.closest("[data-aller-resultat]");
      if (direct) {
        avancer(`resultat-${direct.dataset.allerResultat}`, direct.dataset.allerResultat, "Moins de 15 ans");
        return;
      }
      if (e.target.closest("[data-retour]")) {
        history.back();
        return;
      }
      if (e.target.closest("[data-recommencer]")) {
        reponses = {};
        pile = [];
        libelles.length = 0;
        history.replaceState(null, "");
        afficher("besoin", "retour");
      }
    });

    // Le bouton « précédent » du navigateur recule d'une question.
    window.addEventListener("popstate", () => {
      if (pile.length) reculer();
    });

    // Lien profond depuis le site : /reserver?besoin=etude démarre à l'étape 2.
    const besoin = new URLSearchParams(location.search).get("besoin");
    const carte = besoin && racine.querySelector(`[data-etape="besoin"] [data-choix="${CSS.escape(besoin)}"]`);
    if (carte) {
      avancer(suivant("besoin", besoin), besoin, carte.dataset.libelle);
    } else {
      afficher("besoin", "init");
    }
  })();
</script>

<script
  is:inline
  define:vars={{
    calcom: CALCOM,
    lieu: `${ENTREPRISE.nom}, ${ENTREPRISE.adresse.rue}, ${ENTREPRISE.adresse.codePostal} ${ENTREPRISE.adresse.ville}`,
    telephone: { lien: ENTREPRISE.telephone, affiche: ENTREPRISE.telephoneAffiche },
  }}
>
  (() => {
    const racine = document.getElementById("parcours");
    const cal = document.getElementById("calendrier");
    const demo = !calcom.username;
    const API = "https://api.cal.com/v2";
    /** Jusqu'où on laisse réserver ; Romain peut le restreindre dans Cal.com. */
    const MOIS_MAX = 6;

    const el = (sel) => cal.querySelector(sel);
    const etapes = {
      creneau: el('[data-cal-etape="creneau"]'),
      coordonnees: el('[data-cal-etape="coordonnees"]'),
      confirmation: el('[data-cal-etape="confirmation"]'),
    };
    const zoneMois = el("[data-cal-mois]");
    const titreMois = el("[data-cal-mois-titre]");
    const titreJour = el("[data-cal-jour-titre]");
    const zoneHeures = el("[data-cal-heures]");
    const message = el("[data-cal-message]");
    const form = etapes.coordonnees;
    const erreur = el("[data-cal-erreur]");
    el("[data-cal-demo]").hidden = !demo;

    /**
     * Prestation en cours ; créneaux de tous les mois déjà chargés
     * ("AAAA-MM-JJ" → [{ start }]) ; mois affiché (1er du mois) ; choix.
     */
    let presta = null;
    let creneaux = {};
    let moisCharges = new Set();
    let mois = null;
    let jour = null;
    let choisi = null;
    /** Ignore les réponses d'un chargement dépassé (navigation rapide). */
    let jeton = 0;

    const fmtMois = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric" });
    const fmtLong = new Intl.DateTimeFormat("fr-FR", { weekday: "long", day: "numeric", month: "long" });
    const dateDe = (iso) => new Date(iso.slice(0, 10) + "T12:00:00");
    const heureDe = (iso) => iso.slice(11, 16).replace(":", "h");
    const resume = () =>
      `${fmtLong.format(dateDe(choisi.start))} à ${heureDe(choisi.start)} · ${presta.titre}`;
    const ymd = (d) =>
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
    const debutMois = (d) => new Date(d.getFullYear(), d.getMonth(), 1);
    const decaler = (d, n) => new Date(d.getFullYear(), d.getMonth() + n, 1);
    /** Premier mois réservable : celui de demain (le 31, c'est déjà le suivant). */
    const premierMois = () => {
      const demain = new Date();
      demain.setDate(demain.getDate() + 1);
      return debutMois(demain);
    };
    const dernierMois = () => decaler(premierMois(), MOIS_MAX - 1);
    const datesDuMois = (m) => Object.keys(creneaux).filter((d) => d.startsWith(ymd(m).slice(0, 7))).sort();

    function mesurer(nom, params) {
      if (window.google_tag_data && typeof window.gtag === "function") window.gtag("event", nom, params);
    }

    function montrer(nom) {
      Object.entries(etapes).forEach(([cle, e]) => {
        e.hidden = cle !== nom;
      });
      etapes[nom].classList.remove("cal-apparition");
      void etapes[nom].offsetWidth;
      etapes[nom].classList.add("cal-apparition");
    }

    /* ---------- Source des créneaux ---------- */

    /**
     * Démo : lun.–ven., 9h–19h, toutes les 30 min ; environ un créneau sur
     * trois déjà pris, et quelques journées complètes.
     */
    function creneauxDemo(duree, debut, fin) {
      const res = {};
      const demain = new Date();
      demain.setDate(demain.getDate() + 1);
      const melange = (texte) => {
        let h = 2166136261;
        for (const c of texte) h = Math.imul(h ^ c.charCodeAt(0), 16777619) >>> 0;
        return h >>> 8;
      };
      for (const d = new Date(debut); d <= fin; d.setDate(d.getDate() + 1)) {
        if (d < demain || d.getDay() === 0 || d.getDay() === 6) continue;
        const date = ymd(d);
        if (melange(date) % 6 === 0) continue;
        const liste = [];
        for (let m = 9 * 60; m + duree <= 19 * 60; m += 30) {
          const hh = String(Math.floor(m / 60)).padStart(2, "0");
          const mm = String(m % 60).padStart(2, "0");
          if (melange(date + hh + mm) % 3 !== 0) liste.push({ start: `${date}T${hh}:${mm}:00` });
        }
        if (liste.length) res[date] = liste;
      }
      return res;
    }

    async function chargerCreneaux(debut, fin) {
      if (demo) return creneauxDemo(presta.duree, debut, fin);
      const params = new URLSearchParams({
        eventTypeSlug: presta.slug,
        username: calcom.username,
        start: ymd(debut),
        end: ymd(fin),
        timeZone: calcom.timeZone,
      });
      const r = await fetch(`${API}/slots?${params}`, { headers: { "cal-api-version": "2024-09-04" } });
      if (!r.ok) throw new Error("slots " + r.status);
      return (await r.json()).data || {};
    }

    /** Charge un mois entier, une seule fois. */
    async function chargerMois(m) {
      const cle = ymd(m).slice(0, 7);
      if (moisCharges.has(cle)) return;
      const fin = new Date(m.getFullYear(), m.getMonth() + 1, 0);
      Object.assign(creneaux, await chargerCreneaux(new Date(m), fin));
      moisCharges.add(cle);
    }

    async function reserver(donnees) {
      if (demo) {
        await new Promise((ok) => setTimeout(ok, 900));
        return;
      }
      const r = await fetch(`${API}/bookings`, {
        method: "POST",
        headers: { "Content-Type": "application/json", "cal-api-version": "2026-02-25" },
        body: JSON.stringify({
          start: new Date(choisi.start).toISOString(),
          eventTypeSlug: presta.slug,
          username: calcom.username,
          attendee: {
            name: donnees.nom,
            email: donnees.email,
            phoneNumber: telephoneInternational(donnees.telephone),
            timeZone: calcom.timeZone,
            language: "fr",
          },
          // Les réponses vont aussi dans la note : c'est elle que Romain voit
          // dans son agenda et dans l'e-mail (les metadata restent invisibles).
          bookingFieldsResponses: {
            notes: [donnees.message?.trim(), `Parcours : ${presta.libelles.join(" · ")}`]
              .filter(Boolean)
              .join("\n\n"),
          },
          metadata: { reponses: presta.libelles.join(" · ").slice(0, 500), source: "id-postur.fr" },
        }),
      });
      if (!r.ok) {
        const detail = await r.json().catch(() => null);
        const e = new Error(detail?.error?.message || "booking " + r.status);
        e.status = r.status;
        // Seul ce cas justifie de renvoyer le client au calendrier.
        e.creneauPris = r.status === 409 || /not available|no longer available|already (has|booked)/i.test(e.message);
        throw e;
      }
    }

    /** 06 12 34 56 78 → +33612345678 (Cal.com exige le format international). */
    function telephoneInternational(saisie) {
      const chiffres = saisie.replace(/[^\d+]/g, "");
      if (/^0\d{9}$/.test(chiffres)) return "+33" + chiffres.slice(1);
      if (/^0033\d{9}$/.test(chiffres)) return "+" + chiffres.slice(2);
      return chiffres;
    }

    /* ---------- Affichage ---------- */

    function afficherMois() {
      titreMois.textContent = fmtMois.format(mois);
      cal.querySelector('[data-cal-mois-nav="-1"]').disabled = mois <= premierMois();
      cal.querySelector('[data-cal-mois-nav="1"]').disabled = mois >= dernierMois();
      const aujourdhui = ymd(new Date());
      const cases = [];
      // Grille du lundi au dimanche : cases vides avant le 1er du mois.
      for (let i = 0; i < (mois.getDay() + 6) % 7; i++) cases.push(document.createElement("span"));
      const nbJours = new Date(mois.getFullYear(), mois.getMonth() + 1, 0).getDate();
      for (let n = 1; n <= nbJours; n++) {
        const date = ymd(new Date(mois.getFullYear(), mois.getMonth(), n));
        const dispo = creneaux[date]?.length || 0;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "cal-jour";
        b.dataset.jour = date;
        b.textContent = n;
        b.disabled = !dispo;
        b.setAttribute("aria-pressed", String(date === jour));
        b.setAttribute(
          "aria-label",
          `${fmtLong.format(dateDe(date))}${dispo ? ` · ${dispo} créneaux` : " · indisponible"}`,
        );
        if (date === aujourdhui) b.dataset.aujourdhui = "";
        cases.push(b);
      }
      zoneMois.replaceChildren(...cases);
    }

    function afficherHeures() {
      const liste = (jour && creneaux[jour]) || [];
      titreJour.textContent = jour ? fmtLong.format(dateDe(jour)) : "";
      zoneHeures.replaceChildren(
        ...liste.map((c) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "cal-heure cal-apparition";
          b.dataset.start = c.start;
          b.textContent = heureDe(c.start);
          return b;
        }),
      );
      message.textContent = jour ? "" : "Aucune disponibilité ce mois-ci : essayez le mois suivant.";
    }

    function enPanne() {
      // Cal.com injoignable : on retombe sur Calendly s'il existe, sinon le téléphone.
      message.innerHTML = presta.calendly
        ? `Le calendrier ne répond pas. <a class="underline font-semibold text-id-postur-dark" target="_blank" rel="nofollow noopener" href="${presta.calendly}">Réserver sur Calendly</a>`
        : "Le calendrier ne répond pas. Appelez-nous pour réserver.";
    }

    /** Affiche le mois `m` ; sélectionne son premier jour libre si besoin. */
    async function allerAuMois(m) {
      const moi = ++jeton;
      mois = m;
      titreMois.textContent = fmtMois.format(mois);
      zoneMois.style.opacity = "0.4";
      try {
        await chargerMois(mois);
      } catch {
        if (moi === jeton) enPanne();
        return;
      } finally {
        if (moi === jeton) zoneMois.style.opacity = "";
      }
      if (moi !== jeton) return;
      if (!jour || !jour.startsWith(ymd(mois).slice(0, 7)) || !creneaux[jour]) jour = datesDuMois(mois)[0] || null;
      afficherMois();
      afficherHeures();
    }

    async function ouvrir(section, libelles) {
      const slot = section.querySelector("[data-slot-calendrier]");
      if (!slot) return;
      presta = {
        slug: slot.dataset.slug,
        duree: Number(slot.dataset.duree),
        titre: slot.dataset.titre,
        calendly: slot.dataset.calendly,
        libelles,
      };
      slot.appendChild(cal);
      cal.hidden = false;
      creneaux = {};
      moisCharges = new Set();
      jour = null;
      choisi = null;
      form.reset();
      erreur.textContent = "";
      montrer("creneau");
      zoneHeures.replaceChildren();
      titreJour.textContent = "";
      message.textContent = "Chargement des disponibilités…";
      // On ouvre directement sur le premier mois qui a de la place.
      let depart = premierMois();
      try {
        for (let k = 0; k < MOIS_MAX; k++) {
          const m = decaler(premierMois(), k);
          await chargerMois(m);
          if (datesDuMois(m).length) {
            depart = m;
            break;
          }
        }
      } catch {
        enPanne();
        return;
      }
      if (!Object.keys(creneaux).length) {
        mois = depart;
        afficherMois();
        message.textContent = "Aucun créneau disponible pour le moment. Appelez-nous, on trouve une solution.";
        return;
      }
      await allerAuMois(depart);
    }

    /* ---------- Interactions ---------- */

    racine.addEventListener("parcours:resultat", (e) => ouvrir(e.detail.section, e.detail.libelles));

    cal.addEventListener("click", (e) => {
      const nav = e.target.closest("[data-cal-mois-nav]");
      if (nav) {
        allerAuMois(decaler(mois, Number(nav.dataset.calMoisNav)));
        return;
      }
      const j = e.target.closest(".cal-jour");
      if (j) {
        jour = j.dataset.jour;
        afficherMois();
        afficherHeures();
        // Sur mobile, les horaires sont sous le mois : on les fait apparaître.
        if (window.innerWidth < 768) zoneHeures.scrollIntoView({ behavior: "smooth", block: "nearest" });
        return;
      }
      const h = e.target.closest(".cal-heure");
      if (h) {
        choisi = { start: h.dataset.start };
        el("[data-cal-resume]").textContent = resume();
        montrer("coordonnees");
        form.querySelector("input").focus({ preventScroll: true });
        mesurer("parcours_reservation", { etape: "creneau", choix: presta.slug });
        return;
      }
      if (e.target.closest("[data-cal-changer]")) {
        montrer("creneau");
        return;
      }
      if (e.target.closest("[data-cal-ics]")) telechargerIcs();
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      erreur.textContent = "";
      let valide = true;
      for (const champ of form.querySelectorAll("[required]")) {
        const ok = champ.checkValidity() && champ.value.trim() !== "";
        champ.setAttribute("aria-invalid", String(!ok));
        if (!ok && valide) champ.focus();
        valide = valide && ok;
      }
      if (!valide) {
        erreur.textContent = "Merci de compléter votre nom, votre téléphone et un e-mail valide.";
        return;
      }
      const donnees = Object.fromEntries(new FormData(form));
      const bouton = form.querySelector('[type="submit"]');
      bouton.disabled = true;
      bouton.textContent = "Réservation en cours…";
      try {
        await reserver(donnees);
        el("[data-cal-resume-final]").textContent = resume();
        el("[data-cal-email-info]").textContent = demo
          ? "Démo : aucun e-mail n'a été envoyé."
          : `Un e-mail de confirmation vient de partir à ${donnees.email}.`;
        montrer("confirmation");
        el("[data-cal-titre-confirmation]").focus({ preventScroll: true });
        const compteur = racine.querySelector("[data-compteur]");
        if (compteur) compteur.textContent = "Rendez-vous confirmé";
        mesurer("rdv_confirme", { prestation: presta.slug, mode: demo ? "demo" : "calcom" });
      } catch (err) {
        console.error("[réservation]", err.message);
        if (err.creneauPris) {
          // Créneau pris entre-temps : retour au calendrier rechargé, avec
          // le message affiché LÀ (celui du formulaire serait masqué).
          creneaux = {};
          moisCharges = new Set();
          montrer("creneau");
          await allerAuMois(mois);
          message.textContent = "Ce créneau vient d'être pris. Choisissez-en un autre.";
        } else {
          erreur.innerHTML = `La réservation n'a pas abouti. Réessayez dans un instant, ou appelez-nous au <a class="underline" href="tel:${telephone.lien}">${telephone.affiche}</a>.`;
        }
      } finally {
        bouton.disabled = false;
        bouton.textContent = "Confirmer mon rendez-vous";
      }
    });

    /** Fichier .ics pour ajouter le rendez-vous à l'agenda du client. */
    function telechargerIcs() {
      const debut = choisi.start.slice(0, 16).replace(/[-:]/g, "") + "00";
      const d = new Date(choisi.start.slice(0, 19));
      d.setMinutes(d.getMinutes() + presta.duree);
      const fin =
        ymd(d).replace(/-/g, "") +
        "T" +
        String(d.getHours()).padStart(2, "0") +
        String(d.getMinutes()).padStart(2, "0") +
        "00";
      const ics = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//ID Postur//Reservation//FR",
        "BEGIN:VEVENT",
        `UID:${debut}-${presta.slug}@id-postur.fr`,
        `DTSTAMP:${new Date().toISOString().replace(/[-:]/g, "").slice(0, 15)}Z`,
        `DTSTART;TZID=${calcom.timeZone}:${debut}`,
        `DTEND;TZID=${calcom.timeZone}:${fin}`,
        `SUMMARY:ID Postur · ${presta.titre}`,
        `LOCATION:${lieu.replace(/,/g, "\\,")}`,
        "END:VEVENT",
        "END:VCALENDAR",
      ].join("\r\n");
      const a = document.createElement("a");
      a.href = URL.createObjectURL(new Blob([ics], { type: "text/calendar" }));
      a.download = "rendez-vous-id-postur.ics";
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    }
  })();
</script>
