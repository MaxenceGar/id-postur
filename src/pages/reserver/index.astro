---
import { ENTREPRISE, FICHE_GOOGLE } from "../../data/entreprise";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import { BESOINS, CALCOM, ETAPES, RESULTATS } from "../../data/parcours";
import Roll from "../../components/Roll.astro";

/**
 * Parcours de réservation pas à pas.
 *
 * Une question par écran (besoin → format → déjà client → vélo → option),
 * puis un récapitulatif avec le seul lien Calendly qui correspond aux
 * réponses. Il remplace l'ancienne étape de tri « nouveau / déjà client » :
 * des cyclistes réservaient le créneau « déjà client » sans l'être.
 *
 * Tout le contenu est rendu ici (données dans src/data/parcours.ts) ; le
 * petit script en bas ne fait qu'afficher le bon écran. Sans JS, le
 * <noscript> renvoie vers les anciennes pages de réservation.
 * Page en noindex : aucune valeur en résultat de recherche.
 */

/** Icônes au trait (24×24), dans l'esprit du reste du site. */
const ICONES: Record<string, string> = {
  etude:
    '<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="7.5" r="1.5"/><path d="M12 10v4.5M9 12.5l3-1.5 3 1.5M10 18l2-3.5 2 3.5"/>',
  velo:
    '<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>',
  cible:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>',
  cle: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  prolongateurs: '<path d="M3 5v14M21 12H7M15 18l6-6-6-6"/>',
  regle:
    '<path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2M11.5 9.5l2-2M8.5 6.5l2-2M17.5 15.5l2-2"/>',
  oui: '<path d="M20 6 9 17l-5-5"/>',
  non: '<path d="M18 6 6 18M6 6l12 12"/>',
  aide: '<circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>',
  studio:
    '<path d="M3 21h18M5 21V7l7-4 7 4v14"/><circle cx="9" cy="16" r="2"/><circle cx="15" cy="16" r="2"/><path d="M9 16l3-4 3 4"/>',
  selle: '<path d="M4 9c0-2 3-3 8-3s8 1 8 3-4 3-8 3-8-1-8-3Z"/><path d="M12 12v8M9 20h6"/>',
  chrono: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M10 2h4"/>',
};

---

<BaseLayout
  title="Prendre rendez-vous | ID Postur"
  description="Quelques questions pour trouver la prestation ID Postur qui vous correspond, au bon tarif, et réserver votre créneau."
  noindex={true}
>
  <section class="bg-brume min-h-[80vh] py-8 md:py-14">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 grid gap-8 lg:gap-10 lg:grid-cols-[minmax(0,1fr)_22rem] items-start" id="parcours">
     <div class="min-w-0">
      <!-- Progression -->
      <div class="mb-10">
        <div class="flex items-center justify-between text-sm text-encre-3 mb-3">
          <button
            type="button"
            data-retour
            class="inline-flex items-center gap-1 font-medium text-encre-2 hover:text-encre disabled:invisible"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
            Retour
          </button>
          <span data-compteur class="font-medium tabular-nums">Étape 1</span>
        </div>
        <div class="h-[3px] bg-filet overflow-hidden">
          <div data-barre class="h-full bg-encre transition-[width] duration-700 ease-[cubic-bezier(0.625,0.05,0,1)]" style="width: 8%"></div>
        </div>
      </div>

      <!-- Étape 1 : besoin -->
      <section class="etape" data-etape="besoin">
        <p class="pastille bg-white mb-4">Prendre rendez-vous</p>
        <h1 class="etape-titre text-3xl md:text-[2.5rem] leading-[1.08] tracking-[-0.035em] text-encre mb-3" tabindex="-1">
          Que <span class="whitespace-nowrap">souhaitez-vous</span> <span class="accent">faire</span>&nbsp;?
        </h1>
        <p class="text-gray-600 mb-8">
          Quelques questions et vous saurez exactement quoi réserver, au bon tarif.
        </p>
        {/* L'étude, ouverte à tous, en grand ; les rendez-vous courts dessous. */}
        <button type="button" class="choix choix-vedette group" data-choix={BESOINS[0].id} data-libelle={BESOINS[0].titre}>
          <img src="/images/etudes-posturales-studio.webp" alt="" width="480" height="340" class="choix-photo" />
          <span class="flex-1 flex flex-col gap-2 text-left">
            <span class="flex flex-wrap items-center gap-2.5">
              <span class="font-id-postur text-2xl font-semibold tracking-[-0.03em] text-encre">{BESOINS[0].titre}</span>
              <span class="rounded bg-brume px-2 py-1 text-xs font-medium text-encre-2">Ouverte à tous</span>
            </span>
            <span class="text-[15px] leading-relaxed text-encre-2 max-w-lg">{BESOINS[0].detail} En 3D ou en 2D.</span>
          </span>
          <span class="choix-fleche"><span class="fleche fleche-droite" aria-hidden="true"><span>→</span><span>→</span></span></span>
        </button>

        {/* Autres rendez-vous ouverts à tous (ex. la taille du futur vélo, sur le Zwift Ride). */}
        <div class="grid gap-3 mt-3">
          {
            BESOINS.slice(1).filter((b) => !b.clientsSeulement).map((b) => (
              <button type="button" class="choix group" data-choix={b.id} data-libelle={b.titre}>
                <span class="choix-icone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[b.icone]} />
                </span>
                <span class="flex-1 text-left">
                  <span class="flex flex-wrap items-center gap-2.5">
                    <span class="font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre">{b.titre}</span>
                    <span class="rounded bg-brume px-2 py-1 text-xs font-medium text-encre-2">Ouvert à tous</span>
                  </span>
                  <span class="block text-sm leading-relaxed text-encre-2 mt-1">{b.detail}</span>
                </span>
                <span class="choix-fleche"><span class="fleche fleche-droite" aria-hidden="true"><span>→</span><span>→</span></span></span>
              </button>
            ))
          }
        </div>

        <div class="flex items-center gap-4 my-8 text-[13px] font-medium text-encre-3">
          <span class="h-px grow bg-filet"></span>
          Déjà client ID Postur
          <span class="h-px grow bg-filet"></span>
        </div>

        <div class="grid gap-3 sm:grid-cols-2 sm:[&>:last-child:nth-child(odd)]:col-span-2">
          {
            BESOINS.filter((b) => b.clientsSeulement).map((b) => (
              <button type="button" class="choix group" data-choix={b.id} data-libelle={b.titre}>
                <span class="choix-icone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[b.icone]} />
                </span>
                <span class="flex-1 text-left">
                  <span class="block font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre">{b.titre}</span>
                  <span class="block text-sm leading-relaxed text-encre-2 mt-1">{b.detail}</span>
                </span>
                <span class="choix-fleche"><span class="fleche fleche-droite" aria-hidden="true"><span>→</span><span>→</span></span></span>
              </button>
            ))
          }
        </div>
      </section>

      <!-- Étapes suivantes -->
      {
        ETAPES.map((etape) => (
          <section class="etape" data-etape={etape.id} hidden>
            <h2 class="etape-titre text-3xl md:text-[2.5rem] leading-[1.08] tracking-[-0.035em] text-encre mb-3" tabindex="-1">
              {etape.question}
            </h2>
            {etape.aide && <p class="text-[17px] leading-relaxed text-encre-2 mb-10 max-w-2xl">{etape.aide}</p>}
            {!etape.aide && <div class="mb-10" />}
            <div class="grid gap-3 sm:grid-cols-2">
              {etape.choix.map((c, i) => (
                <button
                  type="button"
                  class:list={["choix group", etape.choix.length === 3 && i === 2 && "sm:col-span-2"]}
                  data-choix={c.valeur}
                  data-libelle={c.titre}
                >
                  {c.badge ? (
                    <span class="choix-icone font-id-postur font-semibold text-lg tracking-[-0.03em]">{c.badge}</span>
                  ) : (
                    c.icone && (
                      <span class="choix-icone">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[c.icone]} />
                      </span>
                    )
                  )}
                  <span class="flex-1 text-left">
                    <span class="block font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre">{c.titre}</span>
                    {c.detail && <span class="block text-sm leading-relaxed text-encre-2 mt-1">{c.detail}</span>}
                  </span>
                  <span class="choix-fleche"><span class="fleche fleche-droite" aria-hidden="true"><span>→</span><span>→</span></span></span>
                </button>
              ))}
            </div>
            {etape.id === "format" && (
              <p class="mt-6 text-sm text-gray-600">
                Pour un cycliste de moins de 15 ans,{" "}
                <button type="button" class="text-gray-900 font-semibold underline hover:opacity-80" data-aller-resultat="etude-moins-15">
                  voir l'étude dédiée
                </button>
                .
              </p>
            )}
          </section>
        ))
      }

      <!-- Refus : rendez-vous court sans étude préalable -->
      <section class="etape" data-etape="refus" hidden>
        <h2 class="etape-titre text-3xl md:text-[2.5rem] leading-[1.08] tracking-[-0.035em] text-encre mb-3" tabindex="-1">
          Commençons par votre étude posturale
        </h2>
        <p class="text-[17px] leading-relaxed text-encre-2 mb-10 max-w-2xl">
          Ce rendez-vous s'appuie sur les mesures de votre étude&nbsp;: il est réservé aux cyclistes déjà passés chez ID Postur. Bonne nouvelle, l'étude règle aussi ce point.
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          <button type="button" class="choix group" data-choix="etude" data-libelle="Commencer par une étude">
            <span class="choix-icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES.etude} />
            </span>
            <span class="flex-1 text-left">
              <span class="block font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre">Réserver une étude posturale</span>
              <span class="block text-sm leading-relaxed text-encre-2 mt-1">En 3D ou en 2D, sur votre vélo</span>
            </span>
          </button>
          <button type="button" class="choix group" data-choix="taille-velo" data-libelle="Choix de la taille sur le Zwift Ride">
            <span class="choix-icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES.studio} />
            </span>
            <span class="flex-1 text-left">
              <span class="block font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre">Vous achetez un vélo ?</span>
              <span class="block text-sm leading-relaxed text-encre-2 mt-1">20 min sur le Zwift Ride du studio pour connaître la taille exacte à acheter, ouvert à tous</span>
            </span>
          </button>
        </div>
      </section>

      <!-- Récapitulatifs : un par combinaison de réponses -->
      {
        RESULTATS.map((r) => (
          <section class="etape" data-etape={`resultat-${r.id}`} data-resultat hidden>
            <p class="pastille bg-white mb-4">Votre rendez-vous</p>
            <h2 class="etape-titre text-3xl md:text-[2.5rem] leading-[1.08] tracking-[-0.035em] text-encre mb-2" tabindex="-1">
              {r.titre}
            </h2>
            <p class="text-[17px] text-encre-2 mb-8">{r.pourQui}</p>

            <div class="bg-white rounded-md p-6 md:p-8">
              <div class="grid grid-cols-2 sm:grid-cols-[auto_auto_1fr] gap-px bg-filet rounded overflow-hidden border border-filet mb-7">
                <p class="bg-white px-5 py-4 flex flex-col gap-1">
                  <span class="text-[13px] text-encre-3">Tarif</span>
                  <span class="font-id-postur text-3xl font-semibold tracking-[-0.04em] text-encre">{r.prix}</span>
                </p>
                <p class="bg-white px-5 py-4 flex flex-col gap-1">
                  <span class="text-[13px] text-encre-3">Durée</span>
                  <span class="font-id-postur text-3xl font-semibold tracking-[-0.04em] text-encre">{r.duree}</span>
                </p>
                {r.disciplines && (
                  <p class="bg-white px-5 py-4 flex flex-col gap-1 col-span-2 sm:col-span-1">
                    <span class="text-[13px] text-encre-3">Disciplines</span>
                    <span class="text-[15px] font-medium text-encre">{r.disciplines}</span>
                  </p>
                )}
              </div>

              <div class="grid gap-6 md:grid-cols-2 mb-2">
                <div>
                  <p class="text-[13px] font-semibold text-encre mb-3">À apporter</p>
                  <ul class="text-sm text-encre-2 space-y-2">
                    {r.aApporter.map((a) => (
                      <li class="flex items-start gap-2.5">
                        <span class="size-1.5 shrink-0 mt-[0.55em] bg-encre" aria-hidden="true" />
                        {a}
                      </li>
                    ))}
                  </ul>
                </div>
                {r.note && (
                  <p class="flex gap-2.5 self-start rounded bg-brume p-4 text-sm leading-relaxed text-encre-2">
                    <svg viewBox="0 0 24 24" class="size-4 mt-0.5 shrink-0 text-encre" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
                    <span>{r.note}</span>
                  </p>
                )}
              </div>

              <p class="sr-only" data-recap></p>

              {/* Le calendrier (unique, plus bas) vient se loger ici quand
                  ce récapitulatif s'affiche. */}
              <div
                data-slot-calendrier
                data-slug={r.calcomSlug}
                data-duree={r.dureeMinutes}
                data-titre={r.titre}
                data-calendly={r.lien ?? ""}
              ></div>
            </div>

            {r.aConfirmer && (
              <p class="mt-4 rounded text-sm bg-[#FFF7E0] border border-[#F2C94C] text-encre px-4 py-3">
                <strong>Prototype, à confirmer avec Romain :</strong> {r.aConfirmer}
              </p>
            )}

            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-encre-2">
              <button type="button" data-recommencer class="lien-souligne font-medium text-encre">
                Recommencer
              </button>
              <span class="lg:hidden">
                Une question ? Écrivez à{" "}
                <a href={`mailto:${ENTREPRISE.email}`} class="text-encre font-semibold">{ENTREPRISE.email}</a>
              </span>
            </div>
          </section>
        ))
      }

      <!--
        Calendrier de réservation intégré : un seul exemplaire, déplacé dans
        le récapitulatif affiché. Source Cal.com, ou démo tant que le compte
        n'est pas renseigné (CALCOM.username dans src/data/parcours.ts).
      -->
      <div id="calendrier" class="mt-8 pt-8 border-t border-filet" hidden>
        <!-- 1. Jour et heure -->
        <div data-cal-etape="creneau">
          <p class="font-id-postur text-2xl font-semibold tracking-[-0.03em] text-encre mb-6">Choisissez votre <span class="accent">créneau</span>.</p>
          <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_13rem]">
            <!-- Mois -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <button type="button" class="cal-fleche" data-cal-mois-nav="-1" aria-label="Mois précédent">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
                </button>
                <p class="font-id-postur text-lg font-semibold tracking-[-0.02em] text-encre first-letter:uppercase" data-cal-mois-titre aria-live="polite"></p>
                <button type="button" class="cal-fleche" data-cal-mois-nav="1" aria-label="Mois suivant">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
              </div>
              <div class="grid grid-cols-7 gap-1.5 text-center text-xs font-medium text-encre-3 mb-2" aria-hidden="true">
                <span>lun.</span><span>mar.</span><span>mer.</span><span>jeu.</span><span>ven.</span><span>sam.</span><span>dim.</span>
              </div>
              <div class="grid grid-cols-7 gap-1.5" data-cal-mois role="group" aria-label="Jours du mois"></div>
            </div>
            <!-- Horaires du jour choisi -->
            <div>
              <p class="font-id-postur text-[17px] font-semibold tracking-[-0.02em] text-encre mb-3 first-letter:uppercase" data-cal-jour-titre></p>
              <div class="grid grid-cols-3 md:grid-cols-1 gap-2 md:max-h-[22rem] md:overflow-y-auto md:overflow-x-hidden md:pr-1" data-cal-heures role="group" aria-label="Horaires disponibles"></div>
            </div>
          </div>
          <p class="text-sm text-encre-3" data-cal-message aria-live="polite"></p>
        </div>

        <!-- 2. Coordonnées -->
        <form data-cal-etape="coordonnees" hidden class="space-y-4" novalidate>
          <div class="flex items-center justify-between gap-4 rounded bg-brume px-5 py-4">
            <p class="text-sm"><span class="text-encre-3">Votre créneau</span><br /><strong class="font-id-postur text-[17px] tracking-[-0.02em] text-encre first-letter:uppercase inline-block" data-cal-resume></strong></p>
            <button type="button" data-cal-changer class="lien-souligne text-sm font-medium text-encre shrink-0">Changer</button>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium text-encre">
              Prénom et nom
              <input name="nom" required autocomplete="name" class="cal-champ" />
            </label>
            <label class="block text-sm font-medium text-encre">
              Téléphone
              <input name="telephone" type="tel" required autocomplete="tel" inputmode="tel" class="cal-champ" />
            </label>
          </div>
          <label class="block text-sm font-medium text-encre">
            E-mail
            <input name="email" type="email" required autocomplete="email" class="cal-champ" />
          </label>
          <label class="block text-sm font-medium text-encre">
            Une précision pour Romain ? <span class="font-normal text-encre-3">(facultatif)</span>
            <textarea name="message" rows="3" class="cal-champ" placeholder="Douleur, objectif, type de vélo…"></textarea>
          </label>
          <p class="text-xs text-encre-3">
            Vos coordonnées servent uniquement à organiser votre rendez-vous.
            <a href="/mentions-legales" class="underline">En savoir plus</a>
          </p>
          <p class="text-sm text-id-postur-dark font-medium" data-cal-erreur aria-live="assertive"></p>
          <button
            type="submit"
            class="btn btn-rouge w-full py-4 text-base disabled:opacity-60"
          >
            Confirmer mon rendez-vous
          </button>
        </form>

        <!-- 3. Confirmation -->
        <div data-cal-etape="confirmation" hidden class="text-center py-4">
          <div class="cal-coche mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </div>
          <p class="font-id-postur text-3xl font-semibold tracking-[-0.035em] text-encre mb-2" tabindex="-1" data-cal-titre-confirmation>C'est <span class="accent">réservé</span>&nbsp;!</p>
          <p class="text-encre-2 mb-1 first-letter:uppercase" data-cal-resume-final></p>
          <p class="text-sm text-encre-3 mb-6">
            {ENTREPRISE.adresse.rue}, {ENTREPRISE.adresse.codePostal} {ENTREPRISE.adresse.ville}
          </p>
          <p class="text-sm text-encre-2 mb-6" data-cal-email-info></p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <button type="button" data-cal-ics class="btn btn-noir">
              <Roll texte="Ajouter à mon agenda" fleche="↓" />
            </button>
            <a href={FICHE_GOOGLE} target="_blank" rel="noopener" class="btn btn-contour">
              <Roll texte="Voir l'itinéraire" fleche="↗" />
            </a>
          </div>
        </div>

        <p data-cal-demo hidden class="mt-6 rounded text-sm bg-[#FFF7E0] border border-[#F2C94C] text-gray-800 px-4 py-3">
          <strong>Démo&nbsp;:</strong> créneaux factices, aucun rendez-vous n'est réellement pris. Ils viendront de l'agenda de Romain une fois son compte Cal.com branché.
        </p>
      </div>

      <noscript>
        <p class="mt-8 text-gray-700">
          Réservez directement&nbsp;:
          <a href="/reserver/premiere-etude" class="text-gray-900 font-semibold underline">première étude posturale</a>
          ·
