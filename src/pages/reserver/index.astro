---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import { formatPrix, getPrestation } from "../../data/tarifs";

/**
 * Étape de tri avant la réservation.
 *
 * Elle existe pour une raison métier : sans elle, des cyclistes réservent
 * le créneau « déjà client » alors qu'ils viennent pour la première fois
 * (et l'inverse), ce qui bloque un créneau au mauvais tarif.
 * Page volontairement en noindex : elle n'a aucune valeur en résultat
 * de recherche et ferait doublon avec /etudes-posturales.
 */

const troisD = getPrestation("etude-posturale-3d");
const deuxD = getPrestation("etude-posturale-2d");
const troisDClient = getPrestation("etude-posturale-3d-deja-client");
const deuxDClient = getPrestation("etude-posturale-2d-deja-client");

const choix = [
  {
    href: "/reserver/premiere-etude",
    titre: "C'est ma première étude posturale chez ID Postur",
    description:
      "Vous n'avez jamais réalisé d'étude posturale chez ID Postur. Nous partons de zéro : entretien, mesures complètes et réglages.",
    tarifs: `${formatPrix(troisD.price)} en 3D · ${formatPrix(deuxD.price)} en 2D`,
    principal: true,
  },
  {
    href: "/reserver/deja-client",
    titre: "J'ai déjà réalisé une étude posturale chez ID Postur",
    description:
      "Nous avons déjà vos mesures en base. Vous bénéficiez du tarif réduit, sans limite de temps depuis votre première étude.",
    tarifs: `${formatPrix(troisDClient.price)} en 3D · ${formatPrix(deuxDClient.price)} en 2D`,
    principal: false,
  },
];
---

<BaseLayout
  title="Réserver une étude posturale | ID Postur"
  description="Choisissez votre situation pour accéder aux formules d'étude posturale qui vous correspondent."
  noindex={true}
>
  <section class="container mx-auto px-5 py-16 md:py-24">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-3xl md:text-4xl font-bold text-center">
        Étude posturale : quelle est votre situation ?
      </h1>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-6 rounded-full"
      >
      </div>
      <p class="text-center text-gray-700 max-w-2xl mx-auto mb-12">
        Une seule question avant de choisir votre créneau : êtes-vous déjà venu
        chez ID Postur ? Vous ne verrez ensuite que les formules qui vous
        concernent, au bon tarif.
      </p>

      <div class="grid gap-8 md:grid-cols-2">
        {
          choix.map((option) => (
            <a
              href={option.href}
              class:list={[
                "declenche-fleche flex flex-col bg-white p-8 transition-all duration-200 hover:shadow-lg motion-safe:hover:-translate-y-1 motion-safe:active:scale-[0.99]",
                option.principal
                  ? "border-2 border-id-postur-dark"
                  : "border border-gray-200 hover:border-id-postur-dark",
              ]}
            >
              <h2 class="text-xl font-semibold text-gray-900 mb-3">
                {option.titre}
              </h2>
              <p class="text-sm text-gray-600 flex-1 mb-6">
                {option.description}
              </p>
              <p class="text-lg font-bold text-gray-900 mb-6">
                {option.tarifs}
              </p>
              <span class="btn-fleche mt-auto inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-white bg-id-postur-dark transition">
                Voir les formules
              </span>
            </a>
          ))
        }
      </div>

      <div class="mt-12 border border-gray-200 bg-gray-50 p-6 text-center">
        <p class="text-gray-800 font-semibold mb-2">
          Vous hésitez encore entre la 3D et la 2D ?
        </p>
        <p class="text-sm text-gray-600 mb-4">
          Durées, tarifs, prérequis : le comparatif complet des deux formats
          est sur une page dédiée.
        </p>
        <a
          href="/etude-posturale-3d-ou-2d"
          class="inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
        >
          Comparer l'étude 3D et l'étude 2D
        </a>
      </div>

      <p class="mt-8 text-center text-sm text-gray-600">
        Un doute sur votre situation ? Appelez-nous au <a
          href="tel:0607167323"
          class="text-id-postur-dark font-semibold">06 07 16 73 23</a
        >, nous vérifions ensemble avant de bloquer un créneau.
      </p>
    </div>
  </section>
</BaseLayout>
