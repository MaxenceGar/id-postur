---
import { ENTREPRISE, FICHE_GOOGLE } from "../../data/entreprise";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/global.css";
import { BESOINS, CALCOM, RESULTATS } from "../../data/parcours";
import { formatPrix, getPrestation } from "../../data/tarifs";

/**
 * Parcours de réservation pas à pas.
 *
 * Une question par écran (besoin → format → déjà client → vélo → option),
 * puis un récapitulatif avec le seul lien Calendly qui correspond aux
 * réponses. Il remplace l'ancienne étape de tri « nouveau / déjà client » :
 * des cyclistes réservaient le créneau « déjà client » sans l'être.
 *
 * Tout le contenu est rendu ici (données dans src/data/parcours.ts) ; le
 * petit script en bas ne fait qu'afficher le bon écran. Sans JS, le
 * <noscript> renvoie vers les anciennes pages de réservation.
 * Page en noindex : aucune valeur en résultat de recherche.
 */

const etude3D = getPrestation("etude-posturale-3d");
const etude2D = getPrestation("etude-posturale-2d");

/** Icônes au trait (24×24), dans l'esprit du reste du site. */
const ICONES: Record<string, string> = {
  etude:
    '<path d="M3 7V5a2 2 0 0 1 2-2h2M17 3h2a2 2 0 0 1 2 2v2M21 17v2a2 2 0 0 1-2 2h-2M7 21H5a2 2 0 0 1-2-2v-2"/><circle cx="12" cy="7.5" r="1.5"/><path d="M12 10v4.5M9 12.5l3-1.5 3 1.5M10 18l2-3.5 2 3.5"/>',
  velo:
    '<circle cx="5.5" cy="17.5" r="3.5"/><circle cx="18.5" cy="17.5" r="3.5"/><circle cx="15" cy="5" r="1"/><path d="M12 17.5V14l-3-3 4-3 2 3h2"/>',
  cible:
    '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3"/><path d="M12 3v3M12 18v3M3 12h3M18 12h3"/>',
  cle: '<path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94z"/>',
  prolongateurs: '<path d="M3 5v14M21 12H7M15 18l6-6-6-6"/>',
  regle:
    '<path d="M21.3 15.3a2.4 2.4 0 0 1 0 3.4l-2.6 2.6a2.4 2.4 0 0 1-3.4 0L2.7 8.7a2.41 2.41 0 0 1 0-3.4l2.6-2.6a2.41 2.41 0 0 1 3.4 0Z"/><path d="m14.5 12.5 2-2M11.5 9.5l2-2M8.5 6.5l2-2M17.5 15.5l2-2"/>',
  oui: '<path d="M20 6 9 17l-5-5"/>',
  non: '<path d="M18 6 6 18M6 6l12 12"/>',
  aide: '<circle cx="12" cy="12" r="9"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3M12 17h.01"/>',
  studio:
    '<path d="M3 21h18M5 21V7l7-4 7 4v14"/><circle cx="9" cy="16" r="2"/><circle cx="15" cy="16" r="2"/><path d="M9 16l3-4 3 4"/>',
  selle: '<path d="M4 9c0-2 3-3 8-3s8 1 8 3-4 3-8 3-8-1-8-3Z"/><path d="M12 12v8M9 20h6"/>',
  chrono: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2M10 2h4"/>',
};

/** Les choix d'une étape : [valeur, titre, détail, icône]. */
type Choix = { valeur: string; titre: string; detail?: string; icone?: string; badge?: string };

const ETAPES: { id: string; question: string; aide?: string; choix: Choix[] }[] = [
  {
    id: "format",
    question: "Quel format d'étude ?",
    aide: "Les deux se font avec la capture de mouvement STT. La 3D est la plus complète.",
    choix: [
      {
        valeur: "3d",
        titre: "Étude 3D",
        detail: `${etude3D.duration} · à partir de ${formatPrix(etude3D.price)} · toutes disciplines, chrono et triathlon compris`,
        badge: "3D",
      },
      {
        valeur: "2d",
        titre: "Étude 2D",
        detail: `${etude2D.duration} · à partir de ${formatPrix(etude2D.price)} · route, VTT et gravel`,
        badge: "2D",
      },
      {
        valeur: "aide",
        titre: "Je ne sais pas, aidez-moi à choisir",
        icone: "aide",
      },
    ],
  },
  {
    id: "aide-chrono",
    question: "Roulez-vous en chrono ou en triathlon ?",
    choix: [
      { valeur: "oui", titre: "Oui", detail: "Vélo de chrono ou de triathlon", icone: "chrono" },
      { valeur: "non", titre: "Non", detail: "Route, VTT ou gravel", icone: "velo" },
    ],
  },
  {
    id: "aide-route",
    question: "Les deux formats vous conviennent",
    aide: "La 3D analyse votre position dans les trois plans : elle repère aussi les asymétries gauche/droite et les désalignements des genoux ou du bassin. La 2D, en vue latérale, va à l'essentiel en moins de temps.",
    choix: [
      {
        valeur: "3d",
        titre: "Je choisis la 3D",
        detail: `L'analyse la plus complète · ${etude3D.duration}`,
        badge: "3D",
      },
      {
        valeur: "2d",
        titre: "Je choisis la 2D",
        detail: `Plus courte · ${etude2D.duration}`,
        badge: "2D",
      },
    ],
  },
  {
    id: "client",
    question: "Avez-vous déjà fait une étude posturale complète chez ID Postur ?",
    aide: "Ne compte pas : une étude faite ailleurs, un réglage de cales, un conseil d'achat ou un rendez-vous court.",
    choix: [
      { valeur: "non", titre: "Non, c'est ma première", detail: "Nous partons de zéro", icone: "non" },
      { valeur: "oui", titre: "Oui, je suis déjà venu", detail: "Tarif client : nous avons déjà vos mesures", icone: "oui" },
    ],
  },
  {
    id: "velo",
    question: "Sur quel vélo ?",
    choix: [
      { valeur: "velo", titre: "Sur mon vélo", detail: "On règle votre position sur votre vélo actuel", icone: "velo" },
      {
        valeur: "studio",
        titre: "Sur le vélo du studio",
        detail: "Pour définir la taille exacte de votre futur vélo, avant de l'acheter",
        icone: "studio",
      },
    ],
  },
  {
    id: "selle",
    question: "Ajouter la cartographie de pression de selle ?",
    aide: "Le capteur Velometrik montre comment votre poids se répartit sur la selle : utile en cas d'inconfort ou pour choisir une selle.",
    choix: [
      { valeur: "avec", titre: "Oui, avec la pression de selle", detail: "+30 €", icone: "selle" },
      { valeur: "sans", titre: "Non merci", detail: "L'étude 2D seule", icone: "non" },
    ],
  },
  {
    id: "client-court",
    question: "Avez-vous déjà fait une étude posturale complète chez ID Postur ?",
    aide: "Ce rendez-vous court part des mesures de votre étude : il est réservé aux cyclistes déjà passés chez ID Postur.",
    choix: [
      { valeur: "oui", titre: "Oui, je suis déjà venu", icone: "oui" },
      { valeur: "non", titre: "Non, pas encore", icone: "non" },
    ],
  },
  {
    id: "mise-en-position",
    question: "Votre étude était en 3D ou en 2D ?",
    aide: "On reporte sur votre nouveau vélo la position mesurée lors de votre étude.",
    choix: [
      { valeur: "3d", titre: "En 3D", badge: "3D" },
      { valeur: "2d", titre: "En 2D", badge: "2D" },
    ],
  },
];

---

<BaseLayout
  title="Prendre rendez-vous | ID Postur"
  description="Quelques questions pour trouver la prestation ID Postur qui vous correspond, au bon tarif, et réserver votre créneau."
  noindex={true}
>
  <section class="bg-[#f4f4f4] min-h-[80vh] py-10 md:py-16">
    <div class="container mx-auto px-5 max-w-3xl" id="parcours">
      <!-- Progression -->
      <div class="mb-8">
        <div class="flex items-center justify-between text-sm text-gray-500 mb-2">
          <button
            type="button"
            data-retour
            class="inline-flex items-center gap-1 font-semibold text-gray-700 hover:text-id-postur-dark disabled:invisible"
          >
            <svg viewBox="0 0 24 24" class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
            Retour
          </button>
          <span data-compteur>Étape 1</span>
        </div>
        <div class="h-2 bg-[#e4e4e4] rounded-full overflow-hidden">
          <div data-barre class="h-full bg-id-postur-dark rounded-full transition-[width] duration-500 ease-out" style="width: 8%"></div>
        </div>
      </div>

      <!-- Étape 1 : besoin -->
      <section class="etape" data-etape="besoin">
        <p class="text-sm font-semibold uppercase tracking-wider text-id-postur-dark mb-2">Prendre rendez-vous</p>
        <h1 class="etape-titre text-3xl md:text-4xl font-bold text-gray-900 mb-3" tabindex="-1">
          Que souhaitez-vous faire ?
        </h1>
        <p class="text-gray-600 mb-8">
          Quelques questions et vous saurez exactement quoi réserver, au bon tarif.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          {
            BESOINS.map((b) => (
              <button type="button" class="choix" data-choix={b.id} data-libelle={b.titre}>
                <span class="choix-icone">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[b.icone]} />
                </span>
                <span class="flex-1 text-left">
                  <span class="block font-semibold text-gray-900">{b.titre}</span>
                  <span class="block text-sm text-gray-600 mt-1">{b.detail}</span>
                  {b.clientsSeulement && (
                    <span class="inline-block mt-2 text-xs font-semibold text-gray-500 border border-gray-300 px-2 py-0.5">
                      Réservé aux clients ID Postur
                    </span>
                  )}
                </span>
              </button>
            ))
          }
        </div>
      </section>

      <!-- Étapes suivantes -->
      {
        ETAPES.map((etape) => (
          <section class="etape" data-etape={etape.id} hidden>
            <h2 class="etape-titre text-3xl md:text-4xl font-bold text-gray-900 mb-3" tabindex="-1">
              {etape.question}
            </h2>
            {etape.aide && <p class="text-gray-600 mb-8 max-w-2xl">{etape.aide}</p>}
            {!etape.aide && <div class="mb-8" />}
            <div class="grid gap-4 sm:grid-cols-2">
              {etape.choix.map((c, i) => (
                <button
                  type="button"
                  class:list={["choix", etape.choix.length === 3 && i === 2 && "sm:col-span-2"]}
                  data-choix={c.valeur}
                  data-libelle={c.titre}
                >
                  {c.badge ? (
                    <span class="choix-icone font-extrabold text-lg">{c.badge}</span>
                  ) : (
                    c.icone && (
                      <span class="choix-icone">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES[c.icone]} />
                      </span>
                    )
                  )}
                  <span class="flex-1 text-left">
                    <span class="block font-semibold text-gray-900">{c.titre}</span>
                    {c.detail && <span class="block text-sm text-gray-600 mt-1">{c.detail}</span>}
                  </span>
                </button>
              ))}
            </div>
            {etape.id === "format" && (
              <p class="mt-6 text-sm text-gray-600">
                Pour un cycliste de moins de 15 ans,{" "}
                <button type="button" class="text-id-postur-dark font-semibold underline hover:opacity-80" data-aller-resultat="etude-moins-15">
                  voir l'étude dédiée
                </button>
                .
              </p>
            )}
          </section>
        ))
      }

      <!-- Refus : rendez-vous court sans étude préalable -->
      <section class="etape" data-etape="refus" hidden>
        <h2 class="etape-titre text-3xl md:text-4xl font-bold text-gray-900 mb-3" tabindex="-1">
          Commençons par votre étude posturale
        </h2>
        <p class="text-gray-600 mb-8 max-w-2xl">
          Ce rendez-vous s'appuie sur les mesures de votre étude : il est réservé aux cyclistes déjà passés chez ID Postur. Bonne nouvelle, l'étude règle aussi ce point.
        </p>
        <div class="grid gap-4 sm:grid-cols-2">
          <button type="button" class="choix" data-choix="etude" data-libelle="Commencer par une étude">
            <span class="choix-icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES.etude} />
            </span>
            <span class="flex-1 text-left">
              <span class="block font-semibold text-gray-900">Réserver une étude posturale</span>
              <span class="block text-sm text-gray-600 mt-1">En 3D ou en 2D, sur votre vélo</span>
            </span>
          </button>
          <button type="button" class="choix" data-choix="etude-studio" data-libelle="Étude sur le vélo du studio">
            <span class="choix-icone">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" set:html={ICONES.studio} />
            </span>
            <span class="flex-1 text-left">
              <span class="block font-semibold text-gray-900">Vous achetez un vélo ?</span>
              <span class="block text-sm text-gray-600 mt-1">Faites votre étude sur le vélo du studio pour connaître la taille exacte à acheter</span>
            </span>
          </button>
        </div>
      </section>

      <!-- Récapitulatifs : un par combinaison de réponses -->
      {
        RESULTATS.map((r) => (
          <section class="etape" data-etape={`resultat-${r.id}`} data-resultat hidden>
            <p class="text-sm font-semibold uppercase tracking-wider text-id-postur-dark mb-2">Votre rendez-vous</p>
            <h2 class="etape-titre text-3xl md:text-4xl font-bold text-gray-900 mb-2" tabindex="-1">
              {r.titre}
            </h2>
            <p class="text-gray-600 mb-6">{r.pourQui}</p>

            <div class="bg-white border-2 border-id-postur-dark p-6 md:p-8 shadow-sm">
              <div class="flex flex-wrap items-end gap-x-8 gap-y-3 mb-6">
                <p class="text-5xl font-extrabold text-gray-900">{r.prix}</p>
                <p class="text-gray-700"><span class="text-gray-500">Durée</span><br /><strong>{r.duree}</strong></p>
                {r.disciplines && (
                  <p class="text-gray-700"><span class="text-gray-500">Disciplines</span><br /><strong>{r.disciplines}</strong></p>
                )}
              </div>

              <p class="text-sm font-semibold text-gray-900 mb-2">À apporter</p>
              <ul class="text-sm text-gray-700 space-y-1 mb-4">
                {r.aApporter.map((a) => (
                  <li class="flex gap-2">
                    <svg viewBox="0 0 24 24" class="w-4 h-4 mt-0.5 shrink-0 text-id-postur-dark" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                    {a}
                  </li>
                ))}
              </ul>
              {r.note && <p class="text-sm text-id-postur-dark font-medium mb-6">{r.note}</p>}

              <p class="text-xs text-gray-500 mb-3" data-recap></p>

              {/* Le calendrier (unique, plus bas) vient se loger ici quand
                  ce récapitulatif s'affiche. */}
              <div
                data-slot-calendrier
                data-slug={r.calcomSlug}
                data-duree={r.dureeMinutes}
                data-titre={r.titre}
                data-calendly={r.lien ?? ""}
              ></div>
            </div>

            {r.aConfirmer && (
              <p class="mt-4 text-sm bg-[#FFF7E0] border border-[#F2C94C] text-gray-800 px-4 py-3">
                <strong>Prototype, à confirmer avec Romain :</strong> {r.aConfirmer}
              </p>
            )}

            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm text-gray-600">
              <button type="button" data-recommencer class="font-semibold text-id-postur-dark underline hover:opacity-80">
                Recommencer
              </button>
              <span>
                Une question ? Appelez le{" "}
                <a href={`tel:${ENTREPRISE.telephone}`} class="text-id-postur-dark font-semibold">{ENTREPRISE.telephoneAffiche}</a>
              </span>
            </div>
          </section>
        ))
      }

      <!--
        Calendrier de réservation intégré : un seul exemplaire, déplacé dans
        le récapitulatif affiché. Source Cal.com, ou démo tant que le compte
        n'est pas renseigné (CALCOM.username dans src/data/parcours.ts).
      -->
      <div id="calendrier" class="mt-8 pt-8 border-t border-[#e4e4e4]" hidden>
        <!-- 1. Jour et heure -->
        <div data-cal-etape="creneau">
          <p class="font-semibold text-gray-900 mb-4">Choisissez votre créneau</p>
          <div class="grid gap-6 md:grid-cols-[minmax(0,1fr)_14rem]">
            <!-- Mois -->
            <div>
              <div class="flex items-center justify-between mb-3">
                <button type="button" class="cal-fleche" data-cal-mois-nav="-1" aria-label="Mois précédent">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"></path></svg>
                </button>
                <p class="font-semibold text-gray-900 capitalize" data-cal-mois-titre aria-live="polite"></p>
                <button type="button" class="cal-fleche" data-cal-mois-nav="1" aria-label="Mois suivant">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"></path></svg>
                </button>
              </div>
              <div class="grid grid-cols-7 gap-1 text-center text-xs font-semibold text-gray-500 mb-1" aria-hidden="true">
                <span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span>
              </div>
              <div class="grid grid-cols-7 gap-1" data-cal-mois role="group" aria-label="Jours du mois"></div>
            </div>
            <!-- Horaires du jour choisi -->
            <div>
              <p class="text-sm font-semibold text-gray-900 mb-3 first-letter:uppercase" data-cal-jour-titre></p>
              <div class="grid grid-cols-3 md:grid-cols-2 gap-2 md:max-h-[22rem] md:overflow-y-auto md:pr-1" data-cal-heures role="group" aria-label="Horaires disponibles"></div>
            </div>
          </div>
          <p class="text-sm text-gray-500" data-cal-message aria-live="polite"></p>
        </div>

        <!-- 2. Coordonnées -->
        <form data-cal-etape="coordonnees" hidden class="space-y-4" novalidate>
          <div class="flex items-center justify-between gap-4 bg-[#f4f4f4] px-4 py-3">
            <p class="text-sm"><span class="text-gray-500">Votre créneau</span><br /><strong class="text-gray-900" data-cal-resume></strong></p>
            <button type="button" data-cal-changer class="text-sm font-semibold text-id-postur-dark underline shrink-0">Changer</button>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="block text-sm font-medium text-gray-900">
              Prénom et nom
              <input name="nom" required autocomplete="name" class="cal-champ" />
            </label>
            <label class="block text-sm font-medium text-gray-900">
              Téléphone
              <input name="telephone" type="tel" required autocomplete="tel" inputmode="tel" class="cal-champ" />
            </label>
          </div>
          <label class="block text-sm font-medium text-gray-900">
            E-mail
            <input name="email" type="email" required autocomplete="email" class="cal-champ" />
          </label>
          <label class="block text-sm font-medium text-gray-900">
            Une précision pour Romain ? <span class="font-normal text-gray-500">(facultatif)</span>
            <textarea name="message" rows="3" class="cal-champ" placeholder="Douleur, objectif, type de vélo…"></textarea>
          </label>
          <p class="text-xs text-gray-500">
            Vos coordonnées servent uniquement à organiser votre rendez-vous.
            <a href="/mentions-legales" class="underline">En savoir plus</a>
          </p>
          <p class="text-sm text-id-postur-dark font-medium" data-cal-erreur aria-live="assertive"></p>
          <button
            type="submit"
            class="btn-fleche w-full inline-flex justify-center items-center px-6 py-4 text-base font-semibold text-white bg-id-postur-dark transition duration-200 motion-safe:active:scale-[0.98] disabled:opacity-60"
          >
            Confirmer mon rendez-vous
          </button>
        </form>

        <!-- 3. Confirmation -->
        <div data-cal-etape="confirmation" hidden class="text-center py-4">
          <div class="cal-coche mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>
          </div>
          <p class="text-2xl font-bold text-gray-900 mb-1" tabindex="-1" data-cal-titre-confirmation>C'est réservé !</p>
          <p class="text-gray-700 mb-1" data-cal-resume-final></p>
          <p class="text-sm text-gray-500 mb-6">
            {ENTREPRISE.adresse.rue}, {ENTREPRISE.adresse.codePostal} {ENTREPRISE.adresse.ville}
          </p>
          <p class="text-sm text-gray-600 mb-6" data-cal-email-info></p>
          <div class="flex flex-col sm:flex-row justify-center gap-3">
            <button type="button" data-cal-ics class="inline-flex justify-center items-center px-5 py-3 text-sm font-semibold text-white bg-id-postur-dark">
              Ajouter à mon agenda
            </button>
            <a href={FICHE_GOOGLE} target="_blank" rel="noopener" class="inline-flex justify-center items-center px-5 py-3 text-sm font-semibold text-id-postur-dark border-2 border-id-postur-dark">
              Voir l'itinéraire
            </a>
          </div>
        </div>

        <p data-cal-demo hidden class="mt-6 text-sm bg-[#FFF7E0] border border-[#F2C94C] text-gray-800 px-4 py-3">
          <strong>Démo :</strong> créneaux factices, aucun rendez-vous n'est réellement pris. Ils viendront de l'agenda de Romain une fois son compte Cal.com branché.
        </p>
      </div>

      <noscript>
        <p class="mt-8 text-gray-700">
          Réservez directement :
          <a href="/reserver/premiere-etude" class="text-id-postur-dark font-semibold underline">première étude posturale</a>
          ·
          <a href="/reserver/deja-client" class="text-id-postur-dark font-semibold underline">déjà client</a>
          · ou appelez le {ENTREPRISE.telephoneAffiche}.
