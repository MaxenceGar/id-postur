---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
---

<BaseLayout>
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-gray-900">
        Vous souhaitez prendre rendez-vous pour
      </h2>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-12 rounded-full"
      >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Option 1 -->
        <a
          href="/premiere-ou-nouvelle"
          class="group block border border-gray-200 p-8 hover:shadow-xl transition-all hover:border-id-postur-dark"
        >
          <img
            src="images/id-postur-img-1.webp"
            alt="Étude Posturale"
            class="mb-8"
          />
          <h3 class="text-2xl font-semibold mb-3">
            Réaliser une étude posturale
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Réalisons ensemble votre étude posturale chez ID Postur
          </p>

          <span
            class="mt-6 inline-block text-white px-3 py-3 bg-id-postur-dark font-semibold group-hover:scale-110 ease-in-out transition delay-150 duration-300"
          >
            Prendre rendez-vous →
          </span>
        </a>

        <!-- Option 2 -->
        <a
          href="/cales"
          class="group block border border-gray-200 p-8 hover:shadow-xl transition-all hover:border-id-postur-dark"
        >
          <img
            src="images/id-postur-cales.webp"
            alt="Étude Posturale"
            class="mb-8"
          />
          <h3 class="text-2xl font-semibold mb-3">
            Régler votre paire de cale/chaussures
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Réalisons ensemble le régalge de vos cales et de vos chaussures
          </p>

          <span
            class="mt-6 inline-block text-white px-3 py-3 bg-id-postur-dark font-semibold group-hover:scale-110 ease-in-out transition delay-150 duration-300"
          >
            Prendre rendez-vous →
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
