---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import Roll from "../components/Roll.astro";
import {
  ETUDES_POSTURALES,
  REGLE_DEJA_CLIENT,
  formatPrix,
  getPrestation,
} from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { AVIS_GOOGLE, CHIFFRES, ENTREPRISE, SITE_URL } from "../data/entreprise";

const troisD = getPrestation("etude-posturale-3d");
const deuxD = getPrestation("etude-posturale-2d");
const troisDClient = getPrestation("etude-posturale-3d-deja-client");
const deuxDClient = getPrestation("etude-posturale-2d-deja-client");

const faqItems = [
  {
    question: "Combien de temps faut-il pour venir à ID Postur depuis Nantes ?",
    answer:
      "Comptez environ 1h15 de route depuis Nantes centre jusqu'à ID Postur, situé à La Mézière (35520) au nord-ouest de Rennes. Le trajet s'effectue principalement par la N137, une 2x2 voies gratuite. Un parking est disponible sur place.",
  },
  {
    question:
      "Peut-on faire l'étude posturale sur une journée aller-retour depuis Nantes ?",
    answer: `Oui, c'est le cas le plus fréquent pour les cyclistes nantais. L'étude posturale 3D dure ${troisD.duration} et l'étude posturale 2D ${deuxD.duration}. Avec le trajet aller-retour, comptez environ 6h sur la journée en 3D, et 4h en 2D. Nous adaptons les horaires (ouverture matinale ou fin de journée) pour faciliter votre venue.`,
  },
  {
    question:
      "Combien coûte une étude posturale à Rennes pour un cycliste nantais ?",
    answer: `L'étude posturale 3D coûte ${formatPrix(troisD.price)} et l'étude posturale 2D ${formatPrix(deuxD.price)}. Si vous avez déjà réalisé une étude chez ID Postur, les tarifs sont respectivement de ${formatPrix(troisDClient.price)} et ${formatPrix(deuxDClient.price)}. Aucun surcoût géographique pour les cyclistes venant de Nantes.`,
  },
  {
    question:
      "Pourquoi venir à ID Postur plutôt que chez un bike fitter à Nantes ?",
    answer: `ID Postur est équipé de la technologie de capture de mouvement STT (3DMA), un système d'analyse de référence en Europe, encore rare dans l'ouest de la France. Romain Hardy, fondateur, est un ancien cycliste professionnel, ce qui apporte une expertise terrain unique. Le centre a réalisé plus de ${CHIFFRES.etudes.replace("+", "")} études posturales et accompagné ${CHIFFRES.pros} athlètes professionnels, avec ${AVIS_GOOGLE.nombre} avis 5/5 sur Google.`,
  },
  {
    question: "Dois-je venir avec mon propre vélo depuis Nantes ?",
    answer:
      "Oui, l'étude posturale se fait obligatoirement sur votre vélo afin de garantir des réglages adaptés à votre morphologie, vos composants et votre pratique. Prévoyez également votre tenue complète (cuissard, maillot), vos chaussures, vos cales et les pièces spécifiques à votre vélo. Pour l'étude 3D, évitez les vêtements réfléchissants : ils perturbent la captation.",
  },
];

const datePublished = "2026-04-22";
const dateModified = "2026-08-11";
const dateHumanReadable = "11 août 2026";

/**
 * Le nœud Person de Romain Hardy n'est plus déclaré ici : il fait partie du
 * graphe commun généré par BaseLayout, et il est donc présent sur toutes les
 * pages avec le même `@id`.
 */
const services = [
  noeudService({
    id: "etude-posturale-nantes",
    name: "Étude posturale cycliste pour les Nantais",
    serviceType: "Bike fitting",
    description:
      "Étude posturale pour cyclistes nantais avec la technologie de capture de mouvement STT, à 1h15 de Nantes. Analyse 3D ou 2D, réglages précis du vélo et optimisation de la position.",
    page: "/etude-posturale-nantes",
    prestations: [...ETUDES_POSTURALES],
    image: `${SITE_URL}/images/etude-posturale-reglage-genou.webp`,
  }),
];
---

<BaseLayout
  title="Étude posturale à Nantes | Bike fitting 3D — ID Postur"
  description={`Étude posturale cycliste à Nantes : capture de mouvement 3D STT par Romain Hardy, ex-cycliste pro. ${AVIS_GOOGLE.nombre} avis 5/5 Google. Route, VTT, gravel, chrono. 3D ${formatPrix(troisD.price)} ou 2D ${formatPrix(deuxD.price)}.`}
  ogImage="/images/etude-posturale-reglage-genou.webp"
  faq={faqItems}
  schema={services}
  datePublished={datePublished}
  dateModified={dateModified}
>
  <PageHero
    ariane="Étude posturale près de Nantes"
    pastille="À 1h15 de Nantes"
    titre={["Étude posturale ", "à Nantes", "."]}
    intro={`Cyclistes nantais, optimisez votre position sur le vélo avec la capture de mouvement STT 3DMA, à 1h15 de Nantes. ${CHIFFRES.etudes} études réalisées, ${AVIS_GOOGLE.nombre} avis 5/5 sur Google.`}
    image="/images/etude-posturale-reglage-genou.webp"
    alt="Romain Hardy règle la position du genou d'un cycliste dans le studio ID Postur"
    puces={["110 km depuis Nantes centre, par la N137", "Étude sur une journée aller-retour", "Parking gratuit sur place"]}
    ctas={[
      { href: "#tarifs", label: "Voir les tarifs" },
      { href: "/reserver", label: "Prendre rendez-vous", secondaire: true },
    ]}
  />

  <!-- BYLINE -->
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 -mt-6 md:-mt-12 pb-4">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-encre-3">
      <img src="/images/romain-hardy-studio.webp" alt="" width="28" height="28" class="size-7 rounded-full object-cover" />
      <span>Par <strong class="font-semibold text-encre">Romain Hardy</strong>, ex-cycliste professionnel et fondateur d'ID Postur</span>
      <span aria-hidden="true">·</span>
      <time datetime={dateModified}>Mis à jour le {dateHumanReadable}</time>
    </p>
  </div>

  <!-- POURQUOI VENIR DE NANTES -->
  <section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-12">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div class="flex flex-col gap-4">
        <p class="pastille">Pourquoi faire le trajet</p>
        <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
          Pourquoi les Nantais viennent <span class="accent">chez ID Postur</span>.
        </h2>
      </div>
      <p class="text-[17px] leading-relaxed text-encre-2">
        À Nantes, la pratique cycliste est riche&nbsp;: cyclotourisme le long de la
        Loire, triathlon sur le bassin nantais, VTT dans la forêt du Gâvre,
        sorties route vers le vignoble ou le littoral. Mais peu de centres
        disposent aujourd'hui de la capture de mouvement 3D
        <strong class="font-semibold text-encre">STT 3DMA</strong>. ID Postur, à
        1h15 de Nantes, est l'un des rares dans l'ouest de la France à proposer
        cette analyse 3D de référence.
      </p>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {[
        ["01", "Technologie STT 3DMA", "Capture optique 3D par marqueurs, avec une précision inférieure au millimètre\u00a0: la technologie d'analyse utilisée par de grandes équipes du World Tour. Mesure en temps réel de vos angles articulaires, de vos appuis et de votre dynamique de pédalage, dans les trois plans du mouvement."],
        ["02", "Un ex-cycliste professionnel", "Romain Hardy, fondateur d'ID Postur, a couru au plus haut niveau professionnel. Cette expérience terrain nourrit chaque étude posturale\u00a0: il sait ce que ressent un cycliste fatigué à la 4ᵉ heure d'une sortie ou sur un final de course."],
        ["03", `${AVIS_GOOGLE.nombre} avis 5/5 sur Google`, "Une note maximale, signe d'une prestation constante. Les cyclistes qui viennent de loin (Nantes, Saint-Malo, Angers) mentionnent souvent que le trajet valait le déplacement."],
      ].map(([n, t, d]) => (
        <div class="flex flex-col gap-3 rounded-md bg-brume p-7">
          <span class="font-id-postur text-sm font-semibold text-encre-3">{n}</span>
          <h3 class="text-xl tracking-[-0.025em]">{t}</h3>
          <p class="text-[15px] leading-relaxed text-encre-2">{d}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- TRAJET DEPUIS NANTES -->
  <section class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 grid gap-5 lg:grid-cols-2">
      <div class="flex flex-col gap-6 rounded-md bg-white p-7 md:p-10">
        <p class="pastille">Le trajet</p>
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
          Venir depuis <span class="accent">Nantes</span>.
        </h2>
        <dl class="flex flex-col border-t border-filet">
          {[
            ["Distance", "Environ 110 km depuis Nantes centre"],
            ["Durée", "1h15 à 1h30 selon le trafic"],
            ["Itinéraire", "N137 (2x2 voies, gratuit) direction Rennes, sortie La Mézière"],
            ["Adresse", `${ENTREPRISE.adresse.rue}, ${ENTREPRISE.adresse.codePostal} ${ENTREPRISE.adresse.ville}, au nord-ouest de Rennes`],
            ["Parking", "Disponible sur place, gratuit"],
          ].map(([k, v]) => (
            <div class="grid grid-cols-[7rem_1fr] gap-4 border-b border-filet py-3.5 text-[15px]">
              <dt class="font-semibold text-encre">{k}</dt>
              <dd class="text-encre-2">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="sur-fond-sombre flex flex-col gap-5 rounded-md bg-encre p-7 md:p-10 text-[#b4b4bc]">
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em] text-white">
          Organiser votre <span class="accent">journée</span>.
        </h2>
        <p class="text-[15px] leading-relaxed">
          Pour les cyclistes nantais, la majorité des études posturales se font
          sur une journée aller-retour. Avec {troisD.duration} d'étude sur place
          en 3D, ou {deuxD.duration} en 2D, et 2 x 1h15 de route, comptez environ
          6h au total en 3D, 4h en 2D.
        </p>
        <p class="text-[15px] leading-relaxed">
          Nous adaptons les créneaux en début ou fin de journée pour éviter les
          heures de pointe entre Nantes et Rennes.
        </p>
        <a href={`tel:${ENTREPRISE.telephone}`} class="btn btn-contour-sombre w-fit mt-auto">
          <Roll texte={`Trouver un horaire : ${ENTREPRISE.telephoneAffiche}`} />
        </a>
      </div>
    </div>
  </section>

  <!-- CE QUE COMPREND L'ÉTUDE -->
  <section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-12">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div class="flex flex-col gap-4">
        <p class="pastille">Le déroulé</p>
        <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
          Ce que comprend <span class="accent">votre étude</span>.
        </h2>
      </div>
      <p class="text-[17px] leading-relaxed text-encre-2">
        Une étude posturale chez ID Postur dure {troisD.duration} en 3D et
        {deuxD.duration} en 2D. Dans les deux cas, elle couvre l'ensemble des
        paramètres qui influent sur votre position et votre rendement.
      </p>
    </div>
    <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {[
        ["Entretien et historique", "Votre pratique, vos objectifs, vos éventuelles douleurs, votre matériel actuel et l'historique de blessures\u00a0: la base pour contextualiser les réglages."],
        ["Analyse biomécanique", "Mesures STT en conditions dynamiques\u00a0: flexions, appuis, symétrie, alignement des genoux et du bassin. Données précises et reproductibles."],
        ["Réglages et ajustements", "Hauteur et recul de selle, cockpit, cales, potence\u00a0: nous ajustons l'ensemble de votre vélo en direct, en validant chaque modification."],
        ["Synthèse et suivi", "Un compte-rendu avec toutes vos mesures. Possibilité de revenir pour un nouveau vélo ou une nouvelle discipline, au tarif client."],
      ].map(([t, d], i) => (
        <li class="flex flex-col gap-3 rounded-md border border-filet p-7">
          <span class="font-id-postur text-sm font-semibold text-encre-3">{String(i + 1).padStart(2, "0")}</span>
          <h3 class="text-xl tracking-[-0.025em]">{t}</h3>
          <p class="text-[15px] leading-relaxed text-encre-2">{d}</p>
        </li>
      ))}
    </ol>
    <a href="/etudes-posturales" class="lien-anime inline-flex items-center gap-2 w-fit text-[15px] font-medium text-encre">
      <Roll texte="Voir tous les détails de l'étude posturale" fleche="↗" />
    </a>
  </section>

  <!-- POUR QUELS CYCLISTES NANTAIS -->
  <section class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-12">
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
        <div class="flex flex-col gap-4">
          <p class="pastille bg-white">Pour qui</p>
          <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
            Pour quels <span class="accent">cyclistes</span> nantais ?
          </h2>
        </div>
        <p class="text-[17px] leading-relaxed text-encre-2">
          ID Postur accueille tous les profils, du pratiquant occasionnel à
          l'athlète professionnel. Quelques cas concrets rencontrés chez les
          cyclistes de la région nantaise.
        </p>
      </div>
      <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {[
          ["Cyclistes route", "Pour les sorties longues vers le vignoble, la côte ou les cyclosportives. L'étude élimine les douleurs aux lombaires et aux genoux sur les sorties de 4-5h."],
          ["Triathlètes nantais", "Position CLM et aérodynamique pour les épreuves triathlon et Ironman. Gains en watts et en confort sur la partie vélo. Ces positions relèvent de l'étude 3D."],
          ["VTTistes (forêt du Gâvre, Ancenis)", "Réglage adapté aux positions dynamiques, montées techniques et longues descentes. Précision sur la cale et la hauteur de selle."],
          ["Gravel et cyclotouristes Loire", "Position hybride route/VTT pour les sorties au long cours. Confort et rendement sur terrain mixte."],
          ["Jeunes cyclistes en croissance", "Protocole adapté aux morphologies en évolution, avec des repères à réévaluer au fil de la croissance."],
          ["Compétiteurs et élites", "25+ athlètes professionnels accompagnés. Réglages au millimètre pour gagner en puissance et en endurance."],
        ].map(([t, d]) => (
          <li class="flex flex-col gap-2.5 rounded-md bg-white p-7">
            <h3 class="text-lg tracking-[-0.02em]">{t}</h3>
            <p class="text-[15px] leading-relaxed text-encre-2">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TARIFS -->
  <section id="tarifs" class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-10 scroll-mt-24">
    <div class="grid gap-6 lg:grid-cols-[1fr_1fr] lg:items-end">
      <div class="flex flex-col gap-4">
        <p class="pastille">Tarifs</p>
        <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
          Les <span class="accent">tarifs</span>, sans surcoût.
        </h2>
      </div>
      <p class="text-[17px] leading-relaxed text-encre-2">
        La 3D pour toutes les disciplines, chrono et triathlon compris, la 2D
        pour la route, le VTT et le gravel. {REGLE_DEJA_CLIENT}
      </p>
    </div>
    <ul class="grid gap-px overflow-hidden rounded-md border border-filet bg-filet sm:grid-cols-2 lg:grid-cols-4">
      {
        ETUDES_POSTURALES.map((prestation) => (
          <li class="flex flex-col gap-2 bg-white p-7">
            <span class:list={["text-[13px] font-medium", prestation.dejaClient ? "text-encre-3" : "text-encre-2"]}>
              {prestation.dejaClient ? "Déjà client" : "Première étude"}
            </span>
            <h3 class="text-lg tracking-[-0.02em]">{prestation.title.replace(/ — déjà client$/, "")}</h3>
            <p class="font-id-postur text-4xl font-semibold tracking-[-0.04em] text-encre">{formatPrix(prestation.price)}</p>
            <p class="text-sm text-encre-2">{prestation.duration}</p>
          </li>
        ))
      }
    </ul>
    <div class="flex flex-wrap items-center gap-x-6 gap-y-3">
      <a href="/reserver" class="btn btn-rouge">
        <Roll texte="Réserver mon étude posturale" fleche="↗" />
      </a>
      <p class="text-[15px] text-encre-2">
        Ou par téléphone au <a href={`tel:${ENTREPRISE.telephone}`} class="font-semibold text-encre">{ENTREPRISE.telephoneAffiche}</a>
      </p>
    </div>
  </section>

  <FaqListe items={faqItems} titre={["Les questions des ", "cyclistes nantais", "."]} />

  <!-- À PROPOS DE L'EXPERT -->
  <section class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-24 grid gap-10 md:grid-cols-[16rem_1fr] md:items-center">
      <img
        src="/images/romain-hardy-studio.webp"
        width="640"
        height="640"
        alt="Romain Hardy, ex-cycliste professionnel et fondateur d'ID Postur, dans son studio"
        class="w-48 md:w-full aspect-square object-cover rounded-md"
        loading="lazy"
      />
      <div class="flex flex-col gap-4 max-w-2xl">
        <p class="pastille bg-white">L'auteur</p>
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
          Par <span class="accent">Romain Hardy</span>, fondateur d'ID Postur.
        </h2>
        <p class="text-[15px] leading-relaxed text-encre-2">
          <strong class="font-semibold text-encre">Ancien cycliste professionnel</strong>,
          Romain Hardy a couru plusieurs saisons au plus haut niveau avant de se
          reconvertir dans l'étude posturale. Formé à la technologie de capture
          de mouvement <strong class="font-semibold text-encre">STT</strong>, il a
          fondé ID Postur en 2023 à La Mézière, près de Rennes.
        </p>
        <p class="text-[15px] leading-relaxed text-encre-2">
          Plus de <strong class="font-semibold text-encre">800 études posturales</strong>
          réalisées, <strong class="font-semibold text-encre">25+ athlètes professionnels</strong>
          accompagnés, et une note de <strong class="font-semibold text-encre">5/5 sur {AVIS_GOOGLE.nombre} avis Google</strong>.
          Son expérience terrain de coureur pro nourrit chaque réglage.
        </p>
      </div>
    </div>
  </section>

  <AutresPrestations title="Aller plus loin" />
</BaseLayout>
