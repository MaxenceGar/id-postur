---
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import Roll from "../components/Roll.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  COMPARATIF_3D_2D,
  ETUDES_POSTURALES,
  EQUIPES_3D,
  FORMATS_ETUDE,
  OFFRES_PARTICULIERES,
  POUR_QUI_2D,
  POUR_QUI_3D,
  REGLE_DEJA_CLIENT,
  formatPrix,
  getPrestation,
} from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { SITE_URL } from "../data/entreprise";

const troisD = getPrestation("etude-posturale-3d");
const deuxD = getPrestation("etude-posturale-2d");
const troisDClient = getPrestation("etude-posturale-3d-deja-client");
const deuxDClient = getPrestation("etude-posturale-2d-deja-client");

const afficherPourQui = POUR_QUI_3D.length > 0 && POUR_QUI_2D.length > 0;

const faqItems = [
  {
    question: "Quelle est la différence de durée entre une étude 3D et une 2D ?",
    answer: `L'étude posturale 3D dure ${troisD.duration} et l'étude posturale 2D ${deuxD.duration}. La séance 3D laisse donc davantage de temps sur le vélo et sur les réglages.`,
  },
  {
    question: "Quel est l'écart de prix entre l'étude 3D et l'étude 2D ?",
    answer: `L'étude posturale 3D coûte ${formatPrix(troisD.price)} et l'étude posturale 2D ${formatPrix(deuxD.price)}, soit ${formatPrix(troisD.price - deuxD.price)} d'écart. Pour un cycliste déjà venu chez ID Postur, les tarifs passent à ${formatPrix(troisDClient.price)} en 3D et ${formatPrix(deuxDClient.price)} en 2D.`,
  },
  {
    question: "L'étude 2D convient-elle à un vélo de chrono ou de triathlon ?",
    answer:
      "Non. Les positions de chrono et de triathlon ne sont pas prises en charge par l'analyse 2D : elles nécessitent l'étude posturale 3D. L'étude 2D reste disponible pour la route, le VTT et le gravel.",
  },
  {
    question: "Puis-je faire mon étude posturale avant d'acheter mon vélo ?",
    answer:
      "Oui, en 3D comme en 2D. L'étude se fait alors sur le Zwift Ride du studio, un vélo réglable dans tous les sens : hauteur et recul de selle, hauteur et éloignement du cintre. On trouve votre position idéale, et vous repartez en sachant quelle taille et quelle géométrie de vélo acheter. Venez simplement en tenue, avec vos chaussures et vos cales.",
  },
  {
    question: "Pourquoi éviter les vêtements réfléchissants en 3D ?",
    answer:
      "Les matières réfléchissantes perturbent la captation du système d'analyse 3D. Prévoyez donc une tenue de vélo classique pour ce format. Pour l'étude 2D, cette contrainte ne s'applique pas.",
  },
  {
    question: "Qui utilise l'analyse posturale 3D ?",
    answer: `L'analyse 3D est la technologie employée par de grandes équipes du World Tour — ${EQUIPES_3D.join(", ")} — pour les études posturales de leurs coureurs. Chez ID Postur, elle est proposée à tous les cyclistes, quel que soit le niveau.`,
  },
  {
    question: "Existe-t-il un tarif pour les moins de 15 ans ?",
    answer: `Oui. ${OFFRES_PARTICULIERES.map((o) => `${o.title} : ${formatPrix(o.price)} pour ${o.duration}`).join(". ")}. Cette formule utilise la technologie d'analyse 2D, à tarif unique : la croissance modifiant les mesures, l'étude est refaite entièrement à chaque visite.`,
  },
  {
    question: "Puis-je passer de la 2D à la 3D plus tard ?",
    answer: `Oui. Si vous avez déjà réalisé une étude chez ID Postur, quel qu'en soit le format, vous bénéficiez ensuite du tarif réduit : ${formatPrix(troisDClient.price)} pour une étude 3D et ${formatPrix(deuxDClient.price)} pour une étude 2D.`,
  },
];

const services = [
  noeudService({
    id: "etude-posturale-formats",
    name: "Étude posturale cycliste — formats 3D et 2D",
    serviceType: "Bike fitting",
    description:
      "Les deux formats d'étude posturale proposés par ID Postur à Rennes : capture optique 3D (STT 3DMA, toutes disciplines) et analyse vidéo 2D (STT 2DMA, route, VTT et gravel).",
    page: "/etude-posturale-3d-ou-2d",
    prestations: [...ETUDES_POSTURALES, ...OFFRES_PARTICULIERES],
    image: `${SITE_URL}/images/etude-posturale-3d-capture.webp`,
  }),
];
---

<BaseLayout
  title="Étude posturale 3D ou 2D : quelle différence ? | ID Postur"
  description={`Étude posturale 3D (${formatPrix(troisD.price)}, ${troisD.duration}) ou 2D (${formatPrix(deuxD.price)}, ${deuxD.duration}) à Rennes : durées, tarifs, prérequis et comparatif pour choisir le format adapté à votre pratique.`}
  ogImage="/images/etude-posturale-3d-capture.webp"
  faq={faqItems}
  schema={services}
>
  <PageHero
    ariane="3D ou 2D"
    pastille="Comparatif des deux formats"
    titre={["Étude posturale ", "3D ou 2D", " : laquelle choisir ?"]}
    intro="Deux formats d'étude posturale à Rennes : la 3D, la plus complète, et la 2D, plus courte. Les deux se déroulent sur votre propre vélo, mais ne couvrent pas les mêmes disciplines : les vélos de chrono et de triathlon relèvent exclusivement de la 3D."
    image="/images/etude-posturale-3d-capture.webp"
    alt="Cycliste analysée en capture de mouvement 3D dans le studio ID Postur"
    puces={[`3D : ${formatPrix(troisD.price)} · ${troisD.duration}`, `2D : ${formatPrix(deuxD.price)} · ${deuxD.duration}`, "Chrono et triathlon : 3D uniquement"]}
    ctas={[
      { href: "#comparatif", label: "Voir le comparatif" },
      { href: "/reserver", label: "Prendre rendez-vous", secondaire: true },
    ]}
  />

  <!-- BLOCS ALTERNÉS 3D / 2D -->
  <section class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-5">
      {
        FORMATS_ETUDE.map((format, i) => (
          <article id={format.ancre} class="grid lg:grid-cols-2 rounded-md bg-white overflow-hidden scroll-mt-28">
            <img
              src={format.image}
              alt={format.imageAlt}
              width="800"
              height="600"
              loading="lazy"
              class:list={["w-full h-full min-h-72 object-cover", i % 2 === 1 && "lg:order-2"]}
            />
            <div class="flex flex-col gap-5 p-7 md:p-10 lg:p-12">
              <p class="pastille">{format.titre.includes("3D") ? "La plus complète" : "Plus courte"}</p>
              <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">
                {format.titre.replace(/ (3D|2D)$/, " ")}<span class="accent">{format.titre.includes("3D") ? "3D" : "2D"}</span>
              </h2>
              <p class="font-id-postur text-lg font-semibold tracking-[-0.02em] text-encre">{format.accroche}</p>
              {format.paragraphes.map((paragraphe) => (
                <p class="text-[15px] leading-relaxed text-encre-2">{paragraphe}</p>
              ))}
              <div class="flex flex-col gap-2.5 border-t border-filet pt-5">
                <p class="text-[13px] font-semibold text-encre">À apporter</p>
                <ul class="grid gap-x-6 gap-y-1.5 sm:grid-cols-2 text-sm text-encre-2">
                  {format.prestation.equipment.map((item) => (
                    <li class="flex items-start gap-2.5">
                      <span class="size-1.5 shrink-0 mt-[0.55em] bg-encre" aria-hidden="true" />
                      {item.replace(/^•\s*/, "")}
                    </li>
                  ))}
                </ul>
              </div>
              <a href="/reserver" class="btn btn-noir w-fit mt-2">
                <Roll texte={`Réserver une étude ${format.titre.includes("3D") ? "3D" : "2D"}`} fleche="↗" />
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <!--
    ÉQUIPES — on énonce uniquement que ces équipes utilisent l'analyse 3D.
    Aucune affirmation d'un lien avec ID Postur, aucun logo&nbsp;: une citation
    textuelle n'engage que ce qu'elle dit.
  -->
  <section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 pt-20 md:pt-28">
    <div class="sur-fond-sombre grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-center rounded-md bg-encre p-8 md:p-12">
      <div class="flex flex-col gap-4">
        <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em] text-white">
          L'analyse 3D, la référence du <span class="accent">peloton pro</span>.
        </h2>
        <p class="text-[15px] leading-relaxed text-[#b4b4bc] max-w-xl">
          C'est la technologie retenue par les plus grandes équipes du World Tour
          pour réaliser les études posturales de leurs coureurs. Un niveau de
          précision pensé pour la compétition, accessible à tous les cyclistes
          chez ID Postur.
        </p>
      </div>
      <ul class="flex flex-wrap gap-2.5 lg:justify-end">
        {EQUIPES_3D.map((equipe) => <li class="rounded bg-nuit px-4 py-3 text-[15px] font-semibold text-white">{equipe}</li>)}
      </ul>
    </div>
  </section>

  <!-- TABLEAU COMPARATIF -->
  <section id="comparatif" class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 pt-20 md:pt-28 flex flex-col gap-10 scroll-mt-24">
    <div class="flex flex-col gap-4">
      <p class="pastille">En un coup d'œil</p>
      <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
        La 3D et la 2D, <span class="accent">côte à côte</span>.
      </h2>
    </div>

    <!-- Mobile : une carte par format plutôt qu'un tableau à faire défiler. -->
    <div class="grid gap-4 md:hidden">
      {[["3D", "troisD"], ["2D", "deuxD"]].map(([f, cle]) => (
        <div class="rounded-md border border-filet overflow-hidden">
          <p class="bg-brume px-5 py-4 font-id-postur text-lg font-semibold tracking-[-0.02em] text-encre">Étude <span class="accent">{f}</span></p>
          <dl class="divide-y divide-filet">
            {COMPARATIF_3D_2D.map((ligne) => (
              <div class="grid grid-cols-[7.5rem_1fr] gap-3 px-5 py-3.5 text-sm">
                <dt class="font-semibold text-encre">{ligne.critere}</dt>
                <dd class="leading-relaxed text-encre-2">{ligne[cle as "troisD" | "deuxD"]}</dd>
              </div>
            ))}
          </dl>
        </div>
      ))}
    </div>

    <div class="hidden md:block overflow-x-auto rounded-md border border-filet">
      <table class="w-full text-left border-collapse min-w-[36rem]">
        <thead>
          <tr class="bg-brume">
            <th class="p-5 w-1/4"><span class="sr-only">Critère</span></th>
            <th class="p-5 font-id-postur text-lg font-semibold tracking-[-0.02em] text-encre">Étude <span class="accent">3D</span></th>
            <th class="p-5 font-id-postur text-lg font-semibold tracking-[-0.02em] text-encre">Étude <span class="accent">2D</span></th>
          </tr>
        </thead>
        <tbody>
          {
            COMPARATIF_3D_2D.map((ligne) => (
              <tr class="border-t border-filet align-top">
                <th class="p-5 text-sm font-semibold text-encre">{ligne.critere}</th>
                <td class="p-5 text-sm leading-relaxed text-encre-2">{ligne.troisD}</td>
                <td class="p-5 text-sm leading-relaxed text-encre-2">{ligne.deuxD}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="text-[15px] text-encre-2">{REGLE_DEJA_CLIENT}</p>

    <!-- Étude avant l'achat, sur le vélo réglable du studio. -->
    <div class="flex flex-col gap-3 rounded-md bg-brume p-7 md:p-8 md:flex-row md:items-center md:justify-between md:gap-8">
      <div class="flex flex-col gap-2 max-w-2xl">
        <h3 class="text-xl md:text-2xl tracking-[-0.025em]">Pas encore de vélo&nbsp;? <span class="accent">Aucun problème</span>.</h3>
        <p class="text-[15px] leading-relaxed text-encre-2">
          L'étude 3D comme l'étude 2D peut se faire avant l'achat, sur le Zwift
          Ride du studio : un vélo réglable dans tous les sens, sur lequel on
          trouve votre position idéale. Vous repartez en sachant exactement
          quelle taille et quelle géométrie acheter.
        </p>
      </div>
      <a href="/reserver?besoin=etude" class="btn btn-noir w-fit shrink-0">
        <Roll texte="Réserver mon étude" fleche="↗" />
      </a>
    </div>

    {
      afficherPourQui && (
        <div class="grid gap-5 md:grid-cols-2">
          {[["la 3D", POUR_QUI_3D], ["la 2D", POUR_QUI_2D]].map(([nom, raisons]) => (
            <div class="flex flex-col gap-4 rounded-md bg-brume p-7">
              <h3 class="text-xl tracking-[-0.025em]">Choisissez <span class="accent">{nom}</span> si…</h3>
              <ul class="flex flex-col gap-2 text-[15px] text-encre-2">
                {(raisons as string[]).map((raison) => (
                  <li class="flex items-start gap-2.5">
                    <span class="mt-2 size-1.5 shrink-0 bg-encre" aria-hidden="true" />
                    {raison}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <FaqListe items={faqItems} titre={["Questions sur la ", "3D et la 2D", "."]} />
</BaseLayout>
