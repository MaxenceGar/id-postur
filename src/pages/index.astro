---
import BaseLayout from "../layouts/BaseLayout.astro";
import Textwithimages from '../components/Textwithimages.astro';
import Chiffres from '../components/chiffres.astro'
import Hero from '../components/hero.astro'
import Qui from '../components/qui.astro'
import Formules from '../components/formules.astro'
import Faq from '../components/faq.astro'
import Confiances from "../components/confiances.astro";
import Partenaires from "../components/partenaires.astro"
---

<BaseLayout>
  <div class="font-id-postur relative">

    <!-- 🌟 Grande forme décorative -->
    <img
      src="/images/triangle.svg"
      class="absolute top-0 right-0 opacity-30 pointer-events-none -z-10"
      alt=""
    />

    <!-- Sections normales -->
    <Hero />
    <Chiffres />
    <Qui />
    <Textwithimages />
    <Formules />
    <Confiances />
    <Partenaires />
    <Faq />

  </div>
</BaseLayout>