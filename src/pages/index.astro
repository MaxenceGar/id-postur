---
import BaseLayout from "../layouts/BaseLayout.astro";
import Chiffres from "../components/chiffres.astro";
import Hero from "../components/hero.astro";
import Qui from "../components/qui.astro";
import Faq from "../components/faq.astro";
import Confiances from "../components/confiances.astro";
import Partenaires from "../components/partenaires.astro";
import Formule from "../components/formule.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import SEO from "../components/seo.astro";
---

<BaseLayout>
  <div class="font-id-postur relative">
    <!-- 🌟 Grande forme décorative -->
    <img
      src="/images/triangle.svg"
      class="absolute top-0 right-0 opacity-30 pointer-events-none -z-10"
      alt=""
    />

    <img
      src="/images/fond-deco.svg"
      alt="Décoration"
      class="absolute left-0 top-[70%] -translate-y-1/2 h-auto hidden lg:block opacity-70 -z-1"
    />

    <img
      src="/images/fond-deco.svg"
      alt="Décoration"
      class="absolute right-0 top-[90%] -translate-y-1/2 h-48 lg:h-auto opacity-70 -z-1"
    />

    <!-- Sections normales -->
    <SpeedInsights />
    <Hero />
    <Chiffres />
    <Qui />
    <Formule />
    <Confiances />
    <Partenaires />
    <Faq />
    <SEO />
  </div>
</BaseLayout>
