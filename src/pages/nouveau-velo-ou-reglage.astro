---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
---

<BaseLayout
  title="Réglage nouveau vélo – Client ID Postur | Rennes"
  description="Vous êtes déjà client ID Postur ? Réglons votre nouveau vélo rapidement grâce à vos mesures existantes. Offert pendant 6 mois après votre première étude."
  noindex={true}
>
  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-img-1.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white">
      <h1 class="text-3xl md:text-4xl font-bold text-center">
        Déjà client chez ID Postur ?
      </h1>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        Grâce à votre première étude posturale réalisée chez <strong
          >ID Postur</strong
        >, nous disposons déjà de vos mesures dans notre base de données.<br />
        Cela nous permet de régler votre nouveau vélo plus rapidement que lors de
        votre première visite. La prestation est <strong
          >gratuite pendant les 6 mois</strong
        > suivant votre étude posturale.
      </p>
    </div>
  </div>
  <section class="container px-2 md:px-5 mx-auto">
    <div class="grid gap-8 md:grid-cols-3 lg:grid-cols-3 py-10">
      <Formulecomponent
        baseline="Offert dans les 4 mois suivant votre première étude posturale"
        title="Ajustement Nouveau Vélo (Moins de 4 mois)"
        description="Mise au point de votre nouveau vélo, basée sur les données de votre étude précédente. Prestation offerte si le vélo est acquis dans les 4 mois."
        price="0 €"
        time="45 minutes"
        link="https://calendly.com/idpostur/etude-posturale-nouveau-velo"
        stack1="• Vélo"
        stack2="• Chaussures"
        stack3="• Cuissard"
        stack4="• Maillot"
        stack5="• Pièces spécifiques à votre vélo"
      />

      <Formulecomponent
        baseline="Au-delà des 4 mois suivant votre première étude posturale"
        title="Ajustement Nouveau Vélo (Après 4 Mois)"
        description="Ajustement de votre nouveau vélo, validé par vidéo. Ce tarif s'applique si l'achat dépasse 4 mois après votre étude."
        price="80 €"
        time="45 minutes"
        link="https://calendly.com/idpostur/etude-posturale-nouveau-velo"
        stack1="• Vélo"
        stack2="• Chaussures"
        stack3="• Cuissard"
        stack4="• Maillot"
        stack5="• Pièces spécifiques à votre vélo"
      />

      <Formulecomponent
        baseline="Pour les clients déjà venus"
        title="Étude Posturale Nouvelle Discipline"
        description="Étude complète et ajustement pour un vélo d'une nouvelle discipline (ex : passage de Route à VTT ou Chrono). Réservé aux clients existants."
        price="100 €"
        time="1h30"
        link="https://calendly.com/idpostur/reglage-nouvelle-discipline"
        stack1="• Vélo"
        stack2="• Chaussures"
        stack3="• Cuissard"
        stack4="• Maillot"
        stack5="• Pièces spécifiques à votre vélo"
      />
    </div>
  </section>
  <div class="w-full flex justify-center">
    <a href="/premiere-ou-nouvelle" rel="nofollow">
      <button
        class="cursor-pointer inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
      >
        Revenir aux choix
      </button>
    </a>
  </div>
</BaseLayout>
