---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
---

<BaseLayout>
  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-img-1.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white">
      <h3 class="text-3xl md:text-4xl font-bold text-center">
        Déjà client chez ID Postur ?
      </h3>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        Grâce à votre première étude posturale réalisée chez <strong
          >ID Postur</strong
        >, nous disposons déjà de vos mesures dans notre base de données.<br />
        Cela nous permet de régler votre nouveau vélo plus rapidement que lors de
        votre première visite. La prestation est <strong
          >gratuite pendant les 6 mois</strong
        > suivant votre étude posturale.
      </p>
    </div>
  </div>
  <section class="py-16">
    <div class="flex justify-center py-10">
      <div class="w-full md:w-4xl max-w-md mx-4">
        <Formulecomponent
          baseline="Gratuit dans les 6 mois après première étude"
          title="Réglage nouveau vélo"
          description="Ajustement rapide de votre nouveau vélo grâce à votre précédente étude. Validation vidéo incluse."
          price="100€"
          time="30 minutes"
          link="https://calendly.com/idpostur/etude-posturale-nouveau-velo"
          stack1="• Vélo"
          stack2="• Chaussures"
          stack3="• Cuissard"
          stack4="• Maillot"
          stack5="• Pièces spécifiques à votre vélo"
        />
      </div>
    </div>
  </section>
  <div class="w-full flex justify-center">
    <a href="/premiere-ou-nouvelle" rel="nofollow">
      <button
        class="cursor-pointer inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition"
      >
        Revenir aux choix
      </button>
    </a>
  </div>
</BaseLayout>
