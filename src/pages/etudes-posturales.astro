---
import BaseLayout from "../layouts/BaseLayout.astro";
import Formulecomponent from "../components/formulecomponent.astro";
import "../styles/global.css";
import {
  ETUDES_POSTURALES,
  OFFRES_PARTICULIERES,
  PRESTATIONS_COURTES,
  PRIX_REDUIT_ETUDE,
  REGLE_DEJA_CLIENT,
  formatPrix,
  getPrestation,
} from "../data/tarifs";

const troisD = getPrestation("etude-posturale-3d");
const deuxD = getPrestation("etude-posturale-2d");
const troisDClient = getPrestation("etude-posturale-3d-deja-client");
const deuxDClient = getPrestation("etude-posturale-2d-deja-client");

const premiereEtude = [troisD, deuxD];
const dejaClient = [troisDClient, deuxDClient];

/**
 * Une seule source pour la FAQ visible et le JSON-LD FAQPage :
 * les deux ne peuvent pas diverger, et les prix viennent de src/data/tarifs.ts.
 */
const faqItems = [
  {
    question: "Combien de temps dure une étude posturale ?",
    answer: `L'étude posturale 3D dure ${troisD.duration} et l'étude posturale 2D ${deuxD.duration}. Ces durées sont les mêmes que vous soyez nouveau client ou que vous ayez déjà réalisé une étude chez ID Postur.`,
  },
  {
    question: "Quel est le prix d'une étude posturale à Rennes ?",
    answer: `L'étude posturale 3D coûte ${formatPrix(troisD.price)} et l'étude posturale 2D ${formatPrix(deuxD.price)}. Si vous avez déjà réalisé une étude posturale chez ID Postur, les tarifs sont respectivement de ${formatPrix(troisDClient.price)} et ${formatPrix(deuxDClient.price)}.`,
  },
  {
    question: "Que veut dire le tarif « déjà client » ?",
    answer: `${REGLE_DEJA_CLIENT} Ce tarif réduit s'applique sans limite de temps depuis votre première étude.`,
  },
  {
    question: "Avec quel équipement dois-je venir ?",
    answer:
      "Le jour du rendez-vous, venez avec le vélo que vous souhaitez régler, votre tenue complète (cuissard et maillot), vos chaussures, vos cales et les pièces spécifiques à votre vélo. Pour l'étude posturale 3D, évitez les vêtements réfléchissants : ils perturbent la captation.",
  },
  {
    question: "Quelles disciplines sont prises en charge ?",
    answer:
      "L'étude posturale 3D couvre toutes les disciplines : route, VTT, gravel, chrono et triathlon. L'étude posturale 2D est proposée pour la route, le VTT et le gravel — les vélos de chrono et de triathlon nécessitent l'analyse 3D.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Étude posturale cycliste",
  serviceType: "Bike fitting",
  provider: { "@id": "https://id-postur.fr/#business" },
  areaServed: [
    { "@type": "City", name: "Rennes" },
    { "@type": "AdministrativeArea", name: "Ille-et-Vilaine" },
  ],
  description:
    "Étude posturale pour cyclistes à Rennes : analyse 3D ou 2D et réglage précis du vélo. Route, VTT, gravel, chrono.",
  url: "https://id-postur.fr/etudes-posturales",
  offers: [...ETUDES_POSTURALES, ...OFFRES_PARTICULIERES].map((prestation) => ({
    "@type": "Offer",
    name: prestation.title,
    price: String(prestation.price),
    priceCurrency: "EUR",
    availability: "https://schema.org/InStock",
    url: "https://id-postur.fr/etudes-posturales",
  })),
};
---

<BaseLayout
  title="Étude posturale vélo à Rennes – 3D et 2D | ID Postur"
  description={`Étude posturale pour cyclistes à Rennes : analyse 3D (${formatPrix(troisD.price)}) ou 2D (${formatPrix(deuxD.price)}) avec la technologie STT. Route, VTT, gravel, chrono. Tarif réduit dès ${formatPrix(PRIX_REDUIT_ETUDE)} pour les clients déjà venus.`}
  ogImage="/images/id-postur-img-1.webp"
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(faqSchema)}
    slot="head"
  />
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify(serviceSchema)}
    slot="head"
  />

  <div
    class="w-full h-96 relative bg-[url('/images/id-postur-img-1.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
  >
    <div class="grid grid-cols-1 text-white px-4">
      <h1 class="text-center">
        Étude posturale vélo à Rennes
      </h1>
      <div
        class="h-[3px] w-24 bg-rouge mx-auto mt-4 mb-10 rounded-full"
      >
      </div>
      <p class="text-center max-w-4xl mx-auto pb-4">
        <span class="font-bold">ID Postur</span>, accompagné de la technologie
        de capture de mouvement <span class="font-bold">STT</span
        >, vous permet de trouver scientifiquement le réglage idéal pour votre
        vélo. <span class="font-bold">Route, VTT, Gravel, Chrono</span> :
        améliorez votre confort et vos performances en fonction de vos besoins
        et de vos caractéristiques physiques.
      </p>
      <div class="inline-block mx-auto">
        <a
          class="btn-primaire btn-fleche"
          href="#formules"
        >
          Voir les tarifs
        </a>
      </div>
    </div>
  </div>

  <section class="bg-papier py-16">
    <div class="container mx-auto px-5 max-w-4xl text-center">
      <h2>
        Étude posturale 3D ou 2D : laquelle choisir ?
      </h2>
      <div class="h-[3px] w-24 bg-rouge mx-auto mt-4 mb-6 rounded-full">
      </div>
      <p class="text-corps mb-6">
        Les deux formats se déroulent sur votre propre vélo. Ils se distinguent
        par les disciplines couvertes — le chrono et le triathlon demandent la
        3D — ainsi que par leur durée et leur tarif :
        {troisD.duration} et {formatPrix(troisD.price)} en 3D, {deuxD.duration}
        et {formatPrix(deuxD.price)} en 2D.
      </p>
      <a
        href="/etude-posturale-3d-ou-2d"
        class="btn-primaire btn-fleche"
      >
        Voir le comparatif détaillé
      </a>
    </div>
  </section>

  <section class="py-16" id="formules">
    <div class="container px-2 md:px-5 mx-auto">
      <h2>
        Il s'agit de votre première étude posturale chez ID Postur ?
      </h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-4 rounded-full"></div>
      <p class="block md:max-w-4xl">
        Deux formats au choix. L'étude 3D couvre toutes les disciplines, y
        compris les vélos de chrono et de triathlon ; l'étude 2D s'adresse à la
        route, au VTT et au gravel. Dans les deux cas, venez avec votre vélo et
        votre tenue complète.
      </p>

      <div class="grid gap-8 md:grid-cols-2 py-10 md:max-w-4xl">
        {
          premiereEtude.map((prestation, index) => (
            <Formulecomponent
              prestation={prestation}
              highlight={index === 0}
              ctaHref="/reserver/premiere-etude"
              ctaLabel="Réserver cette formule"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="py-16">
    <div class="container px-2 md:px-5 mx-auto">
      <h2>Offre particulière</h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-4 rounded-full"></div>
      <p class="block md:max-w-4xl">
        Une formule à tarif unique pour les jeunes cyclistes, réalisée avec la
        technologie d'analyse 2D sur une séance d'1h30. Le tarif reste le même
        à chaque visite : la croissance modifie les mesures, l'étude est donc
        refaite entièrement.
      </p>

      <div class="grid gap-8 md:grid-cols-2 py-10 md:max-w-4xl">
        {
          OFFRES_PARTICULIERES.map((prestation) => (
            <Formulecomponent
              prestation={prestation}
              ctaHref="/reserver/premiere-etude"
              ctaLabel="Réserver cette formule"
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-papier py-16">
    <div class="container px-2 md:px-5 mx-auto">
      <h2>
        Vous avez déjà réalisé une étude chez ID Postur ?
      </h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-4 rounded-full"></div>
      <p class="block md:max-w-4xl">
        {REGLE_DEJA_CLIENT} Ce tarif réduit s'applique sans limite de temps depuis
        votre première étude.
      </p>

      <div class="grid gap-8 md:grid-cols-2 py-10 md:max-w-4xl">
        {
          dejaClient.map((prestation) => (
            <Formulecomponent
              prestation={prestation}
              ctaHref="/reserver/deja-client"
              ctaLabel="Réserver cette formule"
            />
          ))
        }
      </div>

      <p class="text-sm text-corps">
        Vous venez de Nantes ou de sa région ? Consultez notre page dédiée aux
        <a
          href="/etude-posturale-nantes"
          class="text-rouge font-semibold underline hover:opacity-80"
        >
          cyclistes nantais</a
        > : trajet, organisation de la journée et tarifs.
      </p>
    </div>
  </section>

  <section class="py-16">
    <div class="container mx-auto px-2 md:px-5">
      <h2>
        Besoin d'un réglage ponctuel plutôt que d'une étude complète ?
      </h2>
      <div class="h-[3px] w-24 bg-rouge mt-4 mb-4 rounded-full"></div>
      <p class="block md:max-w-4xl">
        Pour un réglage de cales, un avis avant l'achat d'un vélo ou une
        vérification rapide, ID Postur propose des rendez-vous courts de 20
        minutes.
      </p>

      <div class="grid gap-8 md:grid-cols-3 py-10">
        {
          PRESTATIONS_COURTES.map((prestation) => (
            <a
              href={prestation.page}
              class="block bg-white border border-hairline p-6 hover:border-rouge transition"
            >
              <h3 class="text-encre mb-2">
                {prestation.title}
              </h3>
              <p class="text-sm text-gris mb-4">{prestation.description}</p>
              <p class="text-2xl font-bold text-encre">
                {formatPrix(prestation.price)}
              </p>
              <p class="text-sm text-corps">⏱ {prestation.duration}</p>
              <span class="inline-block mt-4 text-sm font-semibold text-rouge">
                En savoir plus →
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="relative px-6 pb-16 overflow-hidden">
    <div class="relative max-w-5xl mx-auto text-center">
      <h2 id="faq" class="mb-4">
        En savoir plus
      </h2>
      <div class="h-[3px] w-24 bg-rouge mx-auto mb-6"></div>

      <div class="space-y-6 text-left">
        {
          faqItems.map((item) => (
            <details class="group bg-white border border-hairline rounded-xs p-6 transition">
              <summary class="flex items-center justify-between cursor-pointer list-none">
                <h3>{item.question}</h3>
                <span class="text-rouge transition-transform duration-300 group-open:rotate-45 text-3xl leading-none select-none">
                  +
                </span>
              </summary>
              <p class="mt-4 leading-relaxed">{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
