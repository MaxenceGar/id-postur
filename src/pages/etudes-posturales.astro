---
import Roll from "../components/Roll.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Formulecomponent from "../components/formulecomponent.astro";
import PageHero from "../components/PageHero.astro";
import FaqListe from "../components/FaqListe.astro";
import AutresPrestations from "../components/autres-prestations.astro";
import {
  EQUIPES_3D,
  ETUDES_POSTURALES,
  OFFRES_PARTICULIERES,
  PRIX_REDUIT_ETUDE,
  REGLE_DEJA_CLIENT,
  formatPrix,
  getPrestation,
} from "../data/tarifs";
import { noeudService } from "../lib/schema";
import { SITE_URL } from "../data/entreprise";

const troisD = getPrestation("etude-posturale-3d");
const deuxD = getPrestation("etude-posturale-2d");
const troisDClient = getPrestation("etude-posturale-3d-deja-client");
const deuxDClient = getPrestation("etude-posturale-2d-deja-client");

const premiereEtude = [troisD, deuxD];
const [moinsDe15] = OFFRES_PARTICULIERES;

/** Ce que l'étude ajuste sur le vélo (repris du texte de présentation). */
const reglages = [
  { titre: "Hauteur de selle", texte: "Pour un pédalage efficace, sans tension dans les genoux.", image: "/images/rendez-vous-ajustement-selle.webp" },
  { titre: "Recul de selle", texte: "L'équilibre entre transfert de puissance et confort du bassin.", image: "/images/etude-posturale-reglage-genou.webp" },
  { titre: "Potence et cintre", texte: "Une position du buste tenable, sans tension dans le dos ni les cervicales.", image: "/images/etude-posturale-2d-analyse-video.webp" },
  { titre: "Cales", texte: "L'alignement du pied, du genou et de la hanche, au millimètre.", image: "/images/reglage-cales-pedale.webp" },
];

/**
 * Une seule source pour la FAQ visible et le JSON-LD FAQPage :
 * les deux ne peuvent pas diverger, et les prix viennent de src/data/tarifs.ts.
 */
const faqItems = [
  {
    question: "Combien de temps dure une étude posturale ?",
    answer: `L'étude posturale 3D dure ${troisD.duration} et l'étude posturale 2D ${deuxD.duration}. Ces durées sont les mêmes que vous soyez nouveau client ou que vous ayez déjà réalisé une étude chez ID Postur.`,
  },
  {
    question: "Quel est le prix d'une étude posturale à Rennes ?",
    answer: `L'étude posturale 3D coûte ${formatPrix(troisD.price)} et l'étude posturale 2D ${formatPrix(deuxD.price)}. Si vous avez déjà réalisé une étude posturale chez ID Postur, les tarifs sont respectivement de ${formatPrix(troisDClient.price)} et ${formatPrix(deuxDClient.price)}.`,
  },
  {
    question: "Que veut dire le tarif « déjà client » ?",
    answer: `${REGLE_DEJA_CLIENT} Ce tarif réduit s'applique sans limite de temps depuis votre première étude.`,
  },
  {
    question: "Avec quel équipement dois-je venir ?",
    answer:
      "Le jour du rendez-vous, venez avec le vélo que vous souhaitez régler, votre tenue complète (cuissard et maillot), vos chaussures, vos cales et les pièces spécifiques à votre vélo. Pour l'étude posturale 3D, évitez les vêtements réfléchissants : ils perturbent la captation.",
  },
  {
    question: "Quelles disciplines sont prises en charge ?",
    answer:
      "L'étude posturale 3D couvre toutes les disciplines : route, VTT, gravel, chrono et triathlon. L'étude posturale 2D est proposée pour la route, le VTT et le gravel — les vélos de chrono et de triathlon nécessitent l'analyse 3D.",
  },
];

const services = [
  noeudService({
    id: "etude-posturale",
    name: "Étude posturale cycliste",
    serviceType: "Bike fitting",
    description:
      "Étude posturale pour cyclistes à Rennes : analyse par capture de mouvement STT en 3D ou en 2D, puis réglage complet du vélo. Route, VTT, gravel, chrono et triathlon.",
    page: "/etudes-posturales",
    prestations: [...ETUDES_POSTURALES, ...OFFRES_PARTICULIERES],
    image: `${SITE_URL}/images/etudes-posturales-studio.webp`,
  }),
];
---

<BaseLayout
  title="Étude posturale vélo à Rennes – 3D et 2D | ID Postur"
  description={`Étude posturale pour cyclistes à Rennes : analyse 3D (${formatPrix(troisD.price)}) ou 2D (${formatPrix(deuxD.price)}) avec la technologie STT. Route, VTT, gravel, chrono. Tarif réduit dès ${formatPrix(PRIX_REDUIT_ETUDE)} pour les clients déjà venus.`}
  ogImage="/images/etudes-posturales-studio.webp"
  faq={faqItems}
  schema={services}
>
  <PageHero
    ariane="Études posturales"
    pastille="Étude posturale à Rennes"
    titre={["Étude posturale vélo à Rennes, ", "en 3D ou en 2D", "."]}
    intro="Avec la technologie de capture de mouvement STT, ID Postur trouve scientifiquement le réglage idéal de votre vélo. Route, VTT, gravel, chrono : plus de confort et de performance, selon vos besoins et votre morphologie."
    image="/images/etudes-posturales-studio.webp"
    alt="Studio d'étude posturale ID Postur avec un cycliste analysé en capture de mouvement"
    puces={["Capture de mouvement STT Motio", "Précision < 1 mm en 3D", "50+ mesures automatiques en 2D"]}
    ctas={[
      { href: "#formules", label: "Voir les tarifs" },
      { href: "/etude-posturale-3d-ou-2d", label: "3D ou 2D ?", secondaire: true },
    ]}
  />

  <section id="formules" class="bg-brume">
    <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28 flex flex-col gap-12">
      <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
        <div class="flex flex-col gap-4">
          <p class="pastille bg-white">Première étude chez ID Postur</p>
          <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
            Choisissez votre <span class="accent">format</span>.
          </h2>
        </div>
        <p class="text-[17px] leading-relaxed text-encre-2 max-w-md">
          Les deux se déroulent sur votre vélo, avec le même réglage complet à la
          fin. Ils diffèrent par les disciplines couvertes, la durée et le tarif.
          <a href="/etude-posturale-3d-ou-2d" class="font-medium text-encre underline underline-offset-4">Voir le comparatif détaillé</a>
        </p>
      </div>

      <div class="grid gap-5 lg:grid-cols-2">
        {
          premiereEtude.map((prestation, index) => (
            <Formulecomponent
              prestation={prestation}
              highlight={index === 0}
              ctaHref="/reserver/premiere-etude"
              ctaLabel="Réserver cette formule"
            />
          ))
        }
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center gap-6 rounded-md bg-white p-7 md:p-8">
        <div class="flex flex-col gap-2 grow">
          <h2 class="text-2xl md:text-[1.75rem] tracking-[-0.03em]">Déjà venu chez ID Postur&nbsp;?</h2>
          <p class="text-[15px] leading-relaxed text-encre-2 max-w-2xl">
            {REGLE_DEJA_CLIENT} Ce tarif réduit s'applique sans limite de temps
            depuis votre première étude.
          </p>
        </div>
        <div class="grid grid-cols-2 gap-3 lg:flex">
          {[troisDClient, deuxDClient].map((p) => (
            <div class="flex flex-col rounded bg-brume px-5 py-3">
              <span class="text-[13px] text-encre-2">Étude {p.slug.includes("3d") ? "3D" : "2D"}</span>
              <span class="font-id-postur text-2xl font-semibold tracking-[-0.03em] text-encre">{formatPrix(p.price)}</span>
            </div>
          ))}
        </div>
        <a href="/reserver/deja-client" class="btn btn-noir shrink-0">
          <Roll texte="Tarif déjà client" fleche="↗" />
        </a>
      </div>

      <div class="flex flex-col lg:flex-row lg:items-center gap-6 rounded-md bg-white p-7 md:p-8">
        <div class="flex flex-col gap-2 grow">
          <p class="text-sm font-medium text-encre-3">Offre particulière · {moinsDe15.baseline}</p>
          <h2 class="text-2xl md:text-[1.75rem] tracking-[-0.03em]">{moinsDe15.title.replace(" — ", "\u00a0— ")}</h2>
          <p class="text-[15px] leading-relaxed text-encre-2 max-w-2xl">
            Une formule à tarif unique pour les jeunes cyclistes, réalisée avec
            la technologie d'analyse 2D sur une séance de {moinsDe15.duration}.
            Le tarif reste le même à chaque visite&nbsp;: la croissance modifie les
            mesures, l'étude est donc refaite entièrement.
          </p>
        </div>
        <p class="font-id-postur text-4xl font-semibold tracking-[-0.04em] text-encre shrink-0">
          {formatPrix(moinsDe15.price)} <span class="font-sans text-base font-medium tracking-normal text-encre-2">· {moinsDe15.duration}</span>
        </p>
        <a href="/reserver/premiere-etude" class="btn btn-contour w-fit shrink-0"><Roll texte="Réserver cette formule" /></a>
      </div>
    </div>
  </section>

  <section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 pt-20 md:pt-28 flex flex-col gap-12">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-6">
      <div class="flex flex-col gap-4">
        <p class="pastille">Le réglage</p>
        <h2 class="text-[2rem] sm:text-4xl md:text-[3.25rem] leading-[1.04] tracking-[-0.035em]">
          Ce que l'on <span class="accent">ajuste</span> sur votre vélo.
        </h2>
      </div>
      <p class="text-[17px] leading-relaxed text-encre-2 max-w-md">
        Les mesures guident chaque réglage. Débutant ou confirmé, l'objectif est
        le même&nbsp;: progresser sans douleur.
      </p>
    </div>

    <ul class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-4">
      {
        reglages.map((r) => (
          <li class="flex flex-col rounded-md border border-filet overflow-hidden">
            <img src={r.image} alt="" width="500" height="360" loading="lazy" class="w-full aspect-[4/3] object-cover" />
            <div class="flex flex-col gap-2 p-4 sm:p-6">
              <h3 class="text-base sm:text-xl tracking-[-0.025em]">{r.titre}</h3>
              <p class="text-[13px] sm:text-sm leading-relaxed text-encre-2">{r.texte}</p>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="flex flex-col lg:flex-row lg:items-center gap-5 rounded-md bg-brume p-7">
      <p class="font-id-postur text-xl font-semibold tracking-[-0.025em] text-encre grow max-w-md">
        Les équipes professionnelles utilisent l'analyse 3D pour leurs études posturales.
      </p>
      <ul class="flex flex-wrap gap-2.5">
        {EQUIPES_3D.map((e) => <li class="rounded bg-white px-4 py-2.5 text-[15px] font-semibold text-encre">{e}</li>)}
      </ul>
    </div>

    <a href="/etude-posturale-nantes" class="lien-anime group flex flex-col sm:flex-row sm:items-center justify-between gap-3 rounded-md border border-filet p-5 md:px-7 transition-colors hover:border-encre-3">
      <span class="text-[15px] text-encre-2">
        <strong class="font-semibold text-encre">Vous venez de Nantes ou de sa région&nbsp;?</strong>
        Trajet, organisation de la journée et tarifs&nbsp;: tout est sur notre page dédiée.
      </span>
      <span class="inline-flex items-center gap-2 text-[15px] font-medium text-encre shrink-0">
        <Roll texte="Cyclistes nantais" fleche="↗" />
      </span>
    </a>
  </section>

  <AutresPrestations sansEtude title="Besoin d'un réglage ponctuel ?" />

  <FaqListe items={faqItems} />
</BaseLayout>
