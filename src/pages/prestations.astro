---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import Formulecomponent from "../components/formulecomponent.astro";
---

<BaseLayout>
  <section>
    <div
      class="w-full h-96 relative bg-[url('/images/id-postur-img-1.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay"
    >
      <div class="grid grid-cols-1 text-white">
        <h3 class="text-3xl md:text-4xl font-bold text-center">
          Nos offres pour le réglage de votre vélo
        </h3>
        <div
          class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
        >
        </div>
        <p class="text-center max-w-4xl mx-auto pb-4">
          <span class="font-bold">ID Postur</span> accompagné de la technologie ID
          Match vous permet de trouver scientifiquement le réglage idéal pour votre
          vélo. <span class="font-bold">Route, VTT, Gravel, Triathlon</span> : améliorez
          vos performances et votre confort en fonction de vos besoins et de vos
          caractéristiques physiques.
        </p>
      </div>
    </div>
    <section class="py-2 md:py-16">
      <div class="container px-2 md:px-5 py-2 md:py-24 mx-auto">
        <!-- Grid des offres -->
        <div>
          <h2 class="text-xl md:text-4xl font-bold">
            Il s'agit de votre première étude posturale chez ID Postur à Rennes
            ?
          </h2>
          <div
            class="h-[3px] w-24 bg-id-postur-dark mt-4 mb-0 md:mb-10 rounded-full"
          >
          </div>
        </div>
        <div class="grid gap-8 md:grid-cols-3 lg:grid-cols-3 py-10">
          <!-- Étude posturale complète -->
          <Formulecomponent
            baseline="Offre la plus complète"
            title="Étude Posturale Complète"
            description="Analyse biométrique 3D + réglage ultra-précis. Optimisation de votre confort et performance."
            price="250€"
            time="2 heures"
            link="https://calendly.com/idpostur/etude-posturale-complete"
            stack1="• Vélo"
            stack2="• Chaussures"
            stack3="• Cuissard"
            stack4="• Maillot"
            stack5="• Pièces spécifiques à votre vélo"
          />

          <Formulecomponent
            baseline="Deux Vélos de la même discipline"
            title="Étude Posturale Deux Vélos"
            description="Réglons ensembles vos deux vélos de la même discipline (Ex: Route + Route ou VTT + VTT ou Chrono + Chrono)"
            price="300€"
            time="2h15"
            link="https://calendly.com/idpostur/etude-posturale-meme-discipline"
            stack1="• Vos Deux Vélos"
            stack2="• Chaussures"
            stack3="• Cuissard"
            stack4="• Maillot"
            stack5="• Pièces spécifiques à votre vélo"
          />

          <Formulecomponent
            baseline="Deux Vélos de Deux Disciplines différentes"
            title="Étude Posturale Deux Vélos"
            description="Réglons ensembles vos deux vélos de discipline différentes. (Ex: Route + Chrono ou Route + VTT ou Chrono + VTT)"
            price="350€"
            time="2 heures"
            link="https://calendly.com/idpostur/etude-posturale-deux-discipline"
            stack1="• Vos Deux Vélos"
            stack2="• Chaussures"
            stack3="• Cuissard"
            stack4="• Maillot"
            stack5="• Pièces spécifiques à votre vélo"
          />

          <Formulecomponent
            baseline="Offre pour les moins de 15 ans"
            title="Étude posturale complète"
            description="Étude adaptée aux jeunes cyclistes en croissance."
            price="120€"
            time="1 heure"
            link="https://calendly.com/idpostur/etude-posturale-complete-15-ans"
            stack1="• Vélo"
            stack2="• Chaussures"
            stack3="• Cuissard"
            stack4="• Maillot"
            stack5="• Pièces spécifiques à votre vélo"
          />

          <Formulecomponent
            baseline="Offre Unique"
            title="Réglage vélo ville/électrique/vtt électrique"
            description="Ajustement de votre posture pour un meilleur confore"
            price="90€"
            time="1 heure"
            link="https://calendly.com/idpostur/etude-posturale-velo-ville-electrique-vtt-electrique"
            stack1="• Vélo"
            stack2="• Chaussures"
            stack3="• Pièces spécifiques à votre vélo"
            stack4=""
            stack5=""
          />
        </div>

        <section class="py-16">
          <div class="container mx-auto">
            <div>
              <h2 class="text-xl md:text-4xl font-bold">
                Vous souhaitez ajuster votre nouveau vélo ?
              </h2>
              <div
                class="h-[3px] w-24 bg-id-postur-dark mt-4 mb-4 rounded-full"
              >
              </div>
              <p class="block md:w-4xl">
                Si vous avez déjà réalisé une étude posturale chez ID Postur,
                nous disposons déjà de vos mesures. Cela nous permet d’effectuer
                le réglage de votre nouveau vélo plus rapidement et plus
                efficacement.
              </p>
            </div>
            <div class="grid gap-8 md:grid-cols-3 lg:grid-cols-3 py-10">
              <Formulecomponent
                baseline="Offert dans les 4 mois suivant votre première étude posturale"
                title="Ajustement Nouveau Vélo (Moins de 4 mois)"
                description="Mise au point de votre nouveau vélo, basée sur les données de votre étude précédente. Prestation offerte si le vélo est acquis dans les 4 mois."
                price="0 €"
                time="30 minutes"
                link="https://calendly.com/idpostur/etude-posturale-nouveau-velo"
                stack1="• Vélo"
                stack2="• Chaussures"
                stack3="• Cuissard"
                stack4="• Maillot"
                stack5="• Pièces spécifiques à votre vélo"
              />

              <Formulecomponent
                baseline="Au-delà des 4 mois suivant votre première étude posturale"
                title="Ajustement Nouveau Vélo (Après 4 Mois)"
                description="Ajustement de votre nouveau vélo, validé par vidéo. Ce tarif s'applique si l'achat dépasse 4 mois après votre étude."
                price="100 €"
                time="30 minutes"
                link="https://calendly.com/idpostur/etude-posturale-nouveau-velo"
                stack1="• Vélo"
                stack2="• Chaussures"
                stack3="• Cuissard"
                stack4="• Maillot"
                stack5="• Pièces spécifiques à votre vélo"
              />

              <Formulecomponent
                baseline="Pour les clients déjà venus"
                title="Étude Posturale Nouvelle Discipline"
                description="Étude complète et ajustement pour un vélo d'une nouvelle discipline (ex : passage de Route à VTT ou Chrono). Réservé aux clients existants."
                price="100 €"
                time="30 minutes"
                link="https://calendly.com/idpostur/reglage-nouvelle-discipline"
                stack1="• Vélo"
                stack2="• Chaussures"
                stack3="• Cuissard"
                stack4="• Maillot"
                stack5="• Pièces spécifiques à votre vélo"
              />
            </div>
          </div>
        </section>
      </div>
    </section>

    <section>
      <div
        class="w-full h-96 relative bg-[url('/images/id-postur-cales.webp')] bg-cover bg-center flex items-center justify-center bg-black/50 bg-blend-overlay my-5"
      >
        <div class="grid grid-cols-1 text-white">
          <h3 class="text-3xl md:text-4xl font-bold text-center">
            Nos offres pour le réglage de vos cales
          </h3>
          <div
            class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"
          >
          </div>
          <p class="text-center max-w-4xl mx-auto pb-4">
            Grâce à la technologie <span class="font-bold">ID Match</span>,
            <span class="font-bold">ID Postur</span> vous aide à trouver le positionnement
            idéal de vos <span class="font-bold">cales</span>. Que vous
            pratiquiez la <span class="font-bold"
              >Route, le VTT, le Gravel ou le Triathlon</span
            >, un réglage précis améliore votre confort, votre efficacité de
            pédalage et limite les risques de blessures.
          </p>
        </div>
      </div>
      <div
        class="grid md:grid-cols-1 lg:grid-cols-2 gap-8 container px-5 py-24 mx-auto"
      >
        <Formulecomponent
          description="Positionnement précis de vos cales pour un pédalage fluide et efficace."
          baseline="Pour votre première étude de cale chez ID Postur"
          title="Réglages cales/chaussures"
          price="50€"
          time="30 minutes"
          link="https://calendly.com/idpostur/reglage-des-cales"
          stack1="• Chaussures"
          stack2="• Vélo"
          stack3="• Cales"
          stack4="• Tenue de vélo"
          stack5=""
        />

        <Formulecomponent
          description="Re-positionnement précis de vos cales/chaussures"
          baseline="Réservé aux clients ayant déjà réalisé une étude chez ID Postur"
          title="Réglages nouvelles cales/chaussures"
          price="20€"
          time="30 minutes"
          link="https://calendly.com/idpostur/reglages-nouvelles-cales-chaussures"
          stack1="• Chaussures"
          stack2="• Vélo"
          stack3="• Cales"
          stack4="• Tenue de vélo"
          stack5=""
        />
      </div>
    </section>
  </section>
</BaseLayout>
