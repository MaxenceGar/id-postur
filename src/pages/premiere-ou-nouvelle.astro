---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/global.css";
import { Tweet, Vimeo, YouTube } from "astro-embed";
---

<BaseLayout
  title="Première étude posturale ou déjà client ? | ID Postur Rennes"
  description="Choisissez votre situation pour trouver la prestation ID Postur adaptée : première étude posturale ou réglage pour client existant."
  noindex={true}
>
  <section class="py-20 bg-white">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <h1 class="text-3xl md:text-4xl font-bold text-gray-900">
        Choisissez votre situation
      </h1>
      <div
        class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-12 rounded-full"
      >
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Option 1 -->
        <a
          href="/etude-posturale"
          class="group block border border-gray-200 p-8 hover:shadow-xl transition-all hover:border-id-postur-dark"
        >
          <div class="text-5xl mb-4">🆕</div>
          <h3 class="text-2xl font-semibold mb-3">
            Première étude posturale ?
          </h3>
          <p class="text-gray-600 leading-relaxed">
            Réalisons ensemble votre première étude posturale chez ID Postur
          </p>

          <span
            class="mt-6 inline-block text-white px-3 py-3 bg-id-postur-dark font-semibold group-hover:scale-110 ease-in-out transition delay-150 duration-300"
          >
            Prendre rendez-vous →
          </span>
        </a>

        <!-- Option 2 -->
        <a
          href="/nouveau-velo-ou-reglage"
          class="group block border border-gray-200 p-8 hover:shadow-xl transition-all hover:border-id-postur-dark"
        >
          <div class="text-5xl mb-4">✔️</div>
          <h3 class="text-2xl font-semibold mb-3">Déjà client ?</h3>
          <p class="text-gray-600 leading-relaxed">
            Nous avons déjà vos mesures : réglons ensemble votre nouveau vélo.
          </p>

          <span
            class="mt-6 inline-block text-white px-3 py-3 bg-id-postur-dark font-semibold group-hover:scale-110 ease-in-out transition delay-150 duration-300"
          >
            Prendre rendez-vous →
          </span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
