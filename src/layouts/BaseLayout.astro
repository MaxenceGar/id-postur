---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { construireGraphe, noeudFilAriane } from "../lib/schema";
import type { NoeudSchema, Question } from "../lib/schema";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
  /**
   * Questions/réponses affichées sur la page. Passer ici la MÊME liste que
   * celle rendue à l'écran : le layout en fait un FAQPage, ce qui garantit
   * que le balisage ne peut pas diverger du contenu visible.
   */
  faq?: Question[];
  /** Nœuds JSON-LD supplémentaires (Service, Person…), cf. src/lib/schema.ts. */
  schema?: NoeudSchema[];
  datePublished?: string;
  dateModified?: string;
}

const {
  title = "ID Postur — Étude posturale à Rennes pour cyclistes",
  description = "ID Postur à Rennes : étude posturale pour cyclistes en 3D ou en 2D avec la technologie STT, réglage des cales et conseil avant l'achat d'un vélo. Route, VTT, gravel, chrono. RDV en ligne.",
  ogImage = "/images/id-postur-interieur-og.jpg",
  ogType = "website",
  noindex = false,
  faq,
  schema = [],
  datePublished,
  dateModified,
} = Astro.props;

const siteOrigin = (Astro.site?.href ?? "https://id-postur.fr/").replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://id-postur.fr/").href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${siteOrigin}${ogImage}`;

/**
 * Un seul bloc JSON-LD par page, sous forme de `@graph` : entreprise, site,
 * fondateur, page courante, fil d'Ariane, puis les nœuds propres à la page.
 * Voir src/lib/schema.ts pour le détail du modèle.
 */
const graphe = construireGraphe({
  url: canonical,
  name: title,
  description,
  image: ogImageAbsolute,
  faq,
  datePublished,
  dateModified,
  filAriane: noeudFilAriane(Astro.url.pathname),
  noeuds: schema,
});
---

<html lang="fr">
  <head>
    <!-- Informations de base -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon & identité -->
    <link rel="icon" type="image/png" href="/id-postur-favicon.png" />
    <link rel="apple-touch-icon" href="/id-postur-favicon.png" />

    <!-- SEO -->
    <meta
      name="google-site-verification"
      content="C2Awy4jx1GehiB8JBI3Y-uYu1Xt6l145lREcHMpe2Aw"
    />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="author" content="Romain Hardy — ID Postur" />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="ID Postur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Sécurité & bonnes pratiques -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      http-equiv="Content-Security-Policy"
      content="
    default-src 'self';
    img-src * data:;
    script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.gstatic.com https://*.vercel-insights.com https://va.vercel-scripts.com;
    style-src 'self' 'unsafe-inline';
    frame-src https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com https://calendly.com;
    media-src https://www.youtube-nocookie.com https://www.youtube.com https://youtube.com;
    connect-src *;
  "
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Données structurées : graphe unique (cf. src/lib/schema.ts) -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(graphe)}
    />

    <slot name="head" />
  </head>

  <body class="font-sans text-gray-800 flex flex-col min-h-screen">
    <SpeedInsights />
    <Header />

    <main class="grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
