---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
---

<html lang="fr">
  <head>
    <!-- Informations de base -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ID Postur — Étude posturale à Rennes pour cyclistes</title>
    <meta
      name="description"
      content="ID Postur à Rennes : étude posturale complète pour cyclistes. Analyse 3D, réglage vélo, optimisation des cales et de votre posture. Gagnez en confort et performance. RDV en ligne."
    />

    <!-- Favicon & identité -->
    <link rel="icon" type="image/png" href="/id-postur-favicon.png" />
    <link rel="apple-touch-icon" href="/id-postur-favicon.png" />

    <!-- SEO -->
    <meta name="robots" content="index, follow" />
    <meta name="author" content="ID Postur" />
    <meta property="og:title" content="ID Postur — Étude posturale à Rennes" />
    <meta
      property="og:description"
      content="Analyse posturale, réglages vélo et optimisation de votre position pour gagner en confort et performance. ID Postur — Rennes."
    />
    <meta property="og:image" content="/images/id-postur-interieur.jpg" />
    <meta property="og:url" content="https://id-postur.fr" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Sécurité & bonnes pratiques -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; img-src * data:; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src *;"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Schema JSON-LD SEO LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "ID Postur",
        "image": "https://id-postur.fr/id-postur-interieur.jpg",
        "description": "Étude posturale et optimisation de la posture cycliste à Rennes. Analyse posturale, réglages vélo et optimisation des cales.",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "112 Route du Meuble",
          "addressLocality": "La Mézière",
          "postalCode": "35520",
          "addressRegion": "Bretagne",
          "addressCountry": "FR"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 48.2183,
          "longitude": -1.7867
        },
        "url": "https://id-postur.fr",
        "telephone": "+33658373303",
        "priceRange": "€€",
        "areaServed": "Rennes et Ille-et-Vilaine",
        "sameAs": []
      }
    </script>
  </head>

  <body class="font-sans text-gray-800 flex flex-col min-h-screen">
    <Header />

    <main class="flex-grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
