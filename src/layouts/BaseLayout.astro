---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SpeedInsights from "@vercel/speed-insights/astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: "website" | "article" | "profile";
  noindex?: boolean;
}

const {
  title = "ID Postur — Étude posturale à Rennes pour cyclistes",
  description = "ID Postur à Rennes : étude posturale complète pour cyclistes. Analyse 3D, réglage vélo, optimisation des cales et de votre posture. Gagnez en confort et performance. RDV en ligne.",
  ogImage = "/images/id-postur-interieur.jpg",
  ogType = "website",
  noindex = false,
} = Astro.props;

const siteOrigin = (Astro.site?.href ?? "https://id-postur.fr/").replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://id-postur.fr/").href;
const ogImageAbsolute = ogImage.startsWith("http") ? ogImage : `${siteOrigin}${ogImage}`;

const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "@id": "https://id-postur.fr/#business",
  name: "ID Postur",
  image: "https://id-postur.fr/images/id-postur-interieur.jpg",
  logo: "https://id-postur.fr/images/LOGO-ID-POSTUR.webp",
  description:
    "Étude posturale et optimisation de la posture cycliste à Rennes. Analyse posturale, réglages vélo et optimisation des cales.",
  address: {
    "@type": "PostalAddress",
    streetAddress: "112 Route du Meuble",
    addressLocality: "La Mézière",
    postalCode: "35520",
    addressRegion: "Bretagne",
    addressCountry: "FR",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 48.2183,
    longitude: -1.7867,
  },
  url: "https://id-postur.fr",
  telephone: "+33607167323",
  email: "idpostur@gmail.com",
  priceRange: "€€",
  areaServed: [
    { "@type": "City", name: "Rennes" },
    { "@type": "AdministrativeArea", name: "Ille-et-Vilaine" },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "09:00",
      closes: "19:00",
    },
  ],
  sameAs: [
    "https://www.instagram.com/idpostur/",
    "https://www.facebook.com/profile.php?id=100090578517497",
  ],
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "5.0",
    reviewCount: "62",
    bestRating: "5",
    worstRating: "1",
  },
};
---

<html lang="fr">
  <head>
    <!-- Informations de base -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Favicon & identité -->
    <link rel="icon" type="image/png" href="/id-postur-favicon.png" />
    <link rel="apple-touch-icon" href="/id-postur-favicon.png" />

    <!-- SEO -->
    <meta
      name="google-site-verification"
      content="C2Awy4jx1GehiB8JBI3Y-uYu1Xt6l145lREcHMpe2Aw"
    />
    <meta
      name="robots"
      content={noindex ? "noindex, nofollow" : "index, follow"}
    />
    <meta name="author" content="ID Postur" />

    <!-- OpenGraph -->
    <meta property="og:site_name" content="ID Postur" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <!-- Sécurité & bonnes pratiques -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta
      http-equiv="Content-Security-Policy"
      content="
    default-src 'self';
    img-src * data:;
    script-src 'self' 'unsafe-inline' https://www.youtube.com https://www.gstatic.com https://*.vercel-insights.com https://va.vercel-scripts.com;
    style-src 'self' 'unsafe-inline';
    frame-src https://www.youtube.com https://youtube.com https://calendly.com;
    media-src https://www.youtube.com https://youtube.com;
    connect-src *;
  "
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#ffffff" />

    <!-- Schema JSON-LD SEO LocalBusiness -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(localBusinessSchema)}
    />

    <slot name="head" />
  </head>

  <body class="font-sans text-gray-800 flex flex-col min-h-screen">
    <SpeedInsights />
    <Header />

    <main class="grow">
      <slot />
    </main>

    <Footer />
  </body>
</html>
