---
import Roll from "./Roll.astro";
import { formatPrix, type Prestation } from "../data/tarifs";

export interface Props {
  prestation: Prestation;
  /** Met la carte en avant (bordure rouge). */
  highlight?: boolean;
  /**
   * Affiche le bouton de réservation. Le mettre à false sur les pages
   * vitrines : la réservation passe alors par l'étape de choix /reserver,
   * qui évite qu'un cycliste réserve le mauvais créneau.
   */
  cta?: boolean;
  /** Destination du bouton, si différente du lien Calendly de la prestation. */
  ctaHref?: string;
  ctaLabel?: string;
  /**
   * Verrouille le bouton tant qu'une case de confirmation de la page n'est
   * pas cochée (CSS seul, voir `.cta-verrouille` dans global.css).
   */
  verrouille?: boolean;
}

const {
  prestation,
  highlight = false,
  cta = true,
  ctaHref,
  ctaLabel = "Prendre rendez-vous",
  verrouille = false,
} = Astro.props;
const {
  baseline,
  title,
  description,
  price,
  duration,
  disciplines,
  equipment,
  note,
  link,
} = prestation;

const href = ctaHref ?? link;
/** Les liens internes ne doivent pas être en nofollow ni ouverts dans un onglet. */
const externe = href.startsWith("http");
---

<div
  class:list={[
    "@container flex flex-col h-full gap-6 rounded-md p-7 md:p-9",
    highlight ? "sur-fond-sombre bg-encre text-[#b4b4bc]" : "bg-white border border-filet text-encre-2",
  ]}
>
  <p class:list={["pastille", highlight && "bg-nuit text-[#b4b4bc]"]}>{baseline}</p>
  <div class="flex flex-col gap-3">
    <h3 class:list={["text-[1.75rem] md:text-[2rem] leading-tight tracking-[-0.035em]", highlight && "text-white"]}>
      {title.replace(/ — déjà client$/, "")}
    </h3>
    <p class="flex items-baseline gap-3">
      <span class:list={["font-id-postur text-5xl font-semibold tracking-[-0.04em]", highlight ? "text-white" : "text-encre"]}>{formatPrix(price)}</span>
      <span class="text-base font-medium">· {duration}</span>
    </p>
    <p class="text-[15px] leading-relaxed">{description}</p>
  </div>

  <div class:list={["grid gap-6 @lg:grid-cols-2 border-t pt-6", highlight ? "border-[#2c2c31]" : "border-filet"]}>
    <div class="flex flex-col gap-2">
      <p class:list={["text-[13px] font-semibold", highlight ? "text-white" : "text-encre"]}>Disciplines</p>
      <p class="text-sm leading-relaxed">{disciplines}</p>
    </div>
    <div class="flex flex-col gap-2">
      <p class:list={["text-[13px] font-semibold", highlight ? "text-white" : "text-encre"]}>À apporter</p>
      <ul class="flex flex-col gap-1.5 text-sm">
        {equipment.map((item) => (
          <li class="flex items-start gap-2.5">
            <span class:list={["size-1.5 shrink-0 mt-[0.55em]", highlight ? "bg-white/60" : "bg-encre"]} aria-hidden="true" />
            {item.replace(/^•\s*/, "")}
          </li>
        ))}
      </ul>
    </div>
  </div>

  {
    note && (
      <p class:list={["flex gap-2.5 rounded p-3.5 text-sm leading-relaxed", highlight ? "bg-nuit" : "bg-brume"]}>
        <svg viewBox="0 0 24 24" class:list={["size-4 mt-0.5 shrink-0", highlight ? "text-white" : "text-encre"]} fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 11v5M12 8h.01" /></svg>
        <span>{note}</span>
      </p>
    )
  }
  {
    cta && (
      <div class:list={["mt-auto", verrouille && "cta-verrouille"]}>
        {verrouille && (
          <p class:list={["cta-attente rounded px-4 py-3.5 text-center text-sm font-medium", highlight ? "bg-nuit text-[#8a8a93]" : "bg-brume text-encre-3"]}>
            Cochez la case ci&#8209;dessus pour réserver
          </p>
        )}
        <a
          href={href}
          rel={externe ? "nofollow noopener" : undefined}
          target={externe ? "_blank" : undefined}
          class:list={["btn w-full", highlight ? "btn-blanc" : "btn-noir"]}
        >
          <Roll texte={ctaLabel} fleche="↗" />
        </a>
      </div>
    )
  }
</div>
