---
import { formatPrix, type Prestation } from "../data/tarifs";

export interface Props {
  prestation: Prestation;
  /** Met la carte en avant (bordure rouge). */
  highlight?: boolean;
  /**
   * Affiche le bouton de réservation. Le mettre à false sur les pages
   * vitrines : la réservation passe alors par l'étape de choix /reserver,
   * qui évite qu'un cycliste réserve le mauvais créneau.
   */
  cta?: boolean;
  /** Destination du bouton, si différente du lien Calendly de la prestation. */
  ctaHref?: string;
  ctaLabel?: string;
}

const {
  prestation,
  highlight = false,
  cta = true,
  ctaHref,
  ctaLabel = "Prendre rendez-vous",
} = Astro.props;
const {
  baseline,
  title,
  description,
  price,
  duration,
  disciplines,
  equipment,
  note,
  link,
} = prestation;

const href = ctaHref ?? link;
/** Les liens internes ne doivent pas être en nofollow ni ouverts dans un onglet. */
const externe = href.startsWith("http");
---

<div
  class:list={[
    "relative flex flex-col h-full rounded-xs shadow-carte transition-all duration-200 motion-safe:hover:-translate-y-1",
    highlight
      ? "border border-rouge/35 bg-rouge/5"
      : "border border-hairline bg-white hover:border-rouge/35",
  ]}
>
  <div
    class="absolute -top-3 left-4 inline-flex items-center text-label text-rouge rounded-xs border border-rouge/35 bg-white px-3 py-[5px]"
  >
    {baseline}
  </div>
  <div class="p-6 flex-1 flex flex-col">
    <h3 class="text-encre mb-2">
      {title}
    </h3>
    <p class="text-sm text-gris mb-4">
      {description}
    </p>
    <div class="mb-4">
      <span class="text-data text-encre">{formatPrix(price)}</span>
    </div>
    <p class="text-sm font-medium text-corps mb-1">
      ⏱ Durée : <span class="font-semibold">{duration}</span>
    </p>
    <p class="text-sm text-corps mb-4">
      Disciplines : <span class="font-semibold">{disciplines}</span>
    </p>
    <ul class="text-sm text-corps space-y-1 mb-4">
      <li class="font-medium text-corps">Équipement à apporter :</li>
      {equipment.map((item) => <li>{item}</li>)}
    </ul>
    {
      note && (
        <p class="text-sm text-rouge font-medium mb-4">{note}</p>
      )
    }
    {
      cta && (
        <div class="mt-auto">
          <a
            href={href}
            rel={externe ? "nofollow noopener" : undefined}
            target={externe ? "_blank" : undefined}
            class="btn-secondaire btn-fleche w-full"
          >
            {ctaLabel}
          </a>
        </div>
      )
    }
  </div>
</div>
