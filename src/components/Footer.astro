---
import {
  AVIS_GOOGLE,
  ENTREPRISE,
  FICHE_GOOGLE,
  FONDATEUR,
  RESEAUX,
} from "../data/entreprise";
import { GA4_ID } from "../data/analytics";
import instagramSvg from "../../public/icon/instagram.svg?raw";
import facebookSvg from "../../public/icon/facebook.svg?raw";

/**
 * Le footer porte le NAP (Name / Address / Phone) affiché sur toutes les
 * pages. Il lit src/data/entreprise.ts, exactement comme le JSON-LD : la
 * cohérence entre balisage et contenu visible est un critère de référencement
 * local, et une adresse écrite différemment ici brouillerait le signal.
 */
const [instagram, facebook] = RESEAUX;

const prestations = [
  { href: "/etudes-posturales", label: "Études posturales" },
  { href: "/etude-posturale-3d-ou-2d", label: "Étude 3D ou 2D\u00a0?" },
  { href: "/cales", label: "Réglage des cales" },
  { href: "/choix-nouveau-velo", label: "Choix d'un nouveau vélo" },
  { href: "/rendez-vous-divers", label: "Rendez-vous divers" },
  { href: "/etude-posturale-nantes", label: "Étude posturale près de Nantes" },
];

/** Sur les pages de réservation, l'appel « Prendre rendez-vous » tournerait en rond. */
const afficherAppel = !Astro.url.pathname.startsWith("/reserver");

const lien = "text-gray-400 hover:text-white transition-colors";
const titre = "text-xs font-semibold uppercase tracking-[0.14em] text-white mb-5";
---

<footer class="bg-[#141414] text-gray-400">
  <!-- Appel à l'action -->
  {afficherAppel && (
  <div class="border-b border-white/10">
    <div
      class="container mx-auto px-5 py-12 md:py-16 flex flex-col md:flex-row md:items-center md:justify-between gap-8"
    >
      <div class="max-w-xl">
        <p class="text-3xl md:text-4xl font-bold text-white leading-tight">
          Prêt à trouver votre position idéale&nbsp;?
        </p>
        <p class="mt-3 text-gray-400">
          Quelques questions et vous saurez exactement quoi réserver.
        </p>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-center gap-4 shrink-0">
        <a
          href="/reserver"
          class="btn-fleche inline-flex justify-center items-center px-7 py-3.5 bg-id-postur-dark text-white font-semibold hover:bg-id-postur transition-colors"
        >
          Prendre rendez-vous
        </a>
        <a href={`tel:${ENTREPRISE.telephone}`} class={`${lien} text-sm text-center`}>
          ou appelez le <span class="font-semibold text-white">{ENTREPRISE.telephoneAffiche}</span>
        </a>
      </div>
    </div>
  </div>
  )}

  <!-- Colonnes -->
  <div
    class="container mx-auto px-5 py-14 grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_0.8fr]"
  >
    <div>
      <img
        src={ENTREPRISE.logo}
        alt="ID Postur"
        width="1335"
        height="622"
        class="w-36 h-auto brightness-0 invert"
        loading="lazy"
      />
      <p class="mt-5 text-sm leading-relaxed max-w-xs">
        Étude posturale et bike fitting près de Rennes, par {FONDATEUR.nom},
        ex-cycliste professionnel.
      </p>
      <a
        href={FICHE_GOOGLE}
        target="_blank"
        rel="noopener"
        class="mt-5 inline-flex items-center gap-2 text-sm group"
        aria-label={`${AVIS_GOOGLE.nombre} avis Google, note 5 sur 5`}
      >
        <span class="text-amber-400 tracking-tighter" aria-hidden="true">★★★★★</span>
        <span class="text-white font-semibold">5,0</span>
        <span class="group-hover:text-white transition-colors">· {AVIS_GOOGLE.nombre} avis Google</span>
      </a>
      <div class="mt-6 flex gap-3">
        <a
          href={instagram}
          target="_blank"
          rel="noopener"
          aria-label="ID Postur sur Instagram"
          class="grid place-items-center w-10 h-10 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 transition-colors [&_svg]:w-4 [&_svg]:h-4"
          set:html={instagramSvg}
        />
        <a
          href={facebook}
          target="_blank"
          rel="noopener"
          aria-label="ID Postur sur Facebook"
          class="grid place-items-center w-10 h-10 border border-white/15 text-gray-300 hover:text-white hover:border-white/40 transition-colors [&_svg]:w-4 [&_svg]:h-4"
          set:html={facebookSvg}
        />
      </div>
    </div>

    <nav aria-label="Prestations">
      <p class={titre}>Prestations</p>
      <ul class="space-y-3 text-sm">
        {prestations.map((p) => (
          <li><a href={p.href} class={lien}>{p.label}</a></li>
        ))}
      </ul>
    </nav>

    <div>
      <p class={titre}>Le studio</p>
      <address class="not-italic space-y-3 text-sm">
        <a href={FICHE_GOOGLE} target="_blank" rel="noopener" class={`${lien} block`}>
          {ENTREPRISE.adresse.rue}<br />
          {ENTREPRISE.adresse.codePostal} {ENTREPRISE.adresse.ville}
        </a>
        <p>{ENTREPRISE.horaires.affiches}</p>
        <a href={`tel:${ENTREPRISE.telephone}`} class={`${lien} block`}>
          {ENTREPRISE.telephoneAffiche}
        </a>
        <a href={`mailto:${ENTREPRISE.email}`} class={`${lien} block`}>
          {ENTREPRISE.email}
        </a>
      </address>
    </div>

    <nav aria-label="Informations">
      <p class={titre}>Infos</p>
      <ul class="space-y-3 text-sm">
        <li><a href="/reserver" class={lien}>Prendre rendez-vous</a></li>
        <li><a href="/id-postur-carte-cadeau.pdf" class={lien}>Carte cadeau</a></li>
        <li><a href="/mentions-legales" class={lien}>Mentions légales</a></li>
        {
          GA4_ID && (
            <li>
              <button type="button" data-gerer-cookies class={`${lien} cursor-pointer`}>
                Gérer les cookies
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>

  <!-- Barre du bas -->
  <div class="border-t border-white/10">
    <div
      class="container mx-auto px-5 py-6 flex flex-col sm:flex-row sm:justify-between gap-2 text-xs text-gray-500"
    >
      <p>© {new Date().getFullYear()} {ENTREPRISE.nom}. Tous droits réservés.</p>
      <a href="https://www.maxence-garandel.fr/" class="hover:text-white transition-colors">
        Site réalisé par maxence-garandel.fr
      </a>
    </div>
  </div>
</footer>
