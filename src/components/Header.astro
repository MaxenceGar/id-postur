---
import Roll from "./Roll.astro";
import { ENTREPRISE } from "../data/entreprise";

/**
 * « Études posturales » ouvre l'étape de tri : le cycliste dit d'abord s'il
 * est déjà venu, puis ne voit que les deux formules qui le concernent.
 * Sans ce filtre, des créneaux sont réservés au mauvais tarif.
 * La page vitrine /etudes-posturales reste accessible depuis /reserver,
 * la home et le footer.
 */
const liens = [
  {
    href: "/reserver",
    label: "Études posturales",
    actifSur: ["/etudes-posturales"],
  },
  { href: "/cales", label: "Cales" },
  { href: "/choix-nouveau-velo", label: "Choix d'un vélo" },
  { href: "/rendez-vous-divers", label: "Rendez-vous divers" },
  { href: "/tarifs-etude-posturale", label: "Tarifs" },
];

const chemin = Astro.url.pathname.replace(/\/$/, "") || "/";
/** Le parcours /reserver n'appartient à aucun onglet : le bouton de rendez-vous suffit. */
const estActif = (lien: (typeof liens)[number]) =>
  lien.href === "/reserver"
    ? (lien.actifSur ?? []).includes(chemin)
    : chemin === lien.href || chemin.startsWith(`${lien.href}/`);
---

<header class="bg-white/95 backdrop-blur border-b border-filet sticky top-0 z-50">
  <div class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-3.5 flex items-center justify-between gap-6">
    <a href="/" aria-label="Retour à l'accueil ID Postur" class="shrink-0">
      <img
        src="/images/LOGO-ID-POSTUR.webp"
        alt="Logo ID Postur"
        width="128"
        height="43"
        class="w-28 h-auto object-contain"
      />
    </a>

    <!-- Navigation desktop : onglets sur fond gris, l'onglet actif ressort en blanc. -->
    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1 p-1 rounded-md bg-brume">
        {
          liens.map((lien) => (
            <li>
              <a
                href={lien.href}
                aria-current={estActif(lien) ? "page" : undefined}
                class:list={[
                  "block whitespace-nowrap px-3 xl:px-4 py-2 rounded text-sm font-medium transition-colors",
                  estActif(lien)
                    ? "bg-white text-encre shadow-[0_1px_4px_rgb(0_0_0/0.08)]"
                    : "text-encre-2 hover:text-encre hover:bg-white/60",
                ]}
              >
                {lien.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-4">
      <a
        href={`mailto:${ENTREPRISE.email}`}
        title={ENTREPRISE.email}
        class="hidden xl:inline text-sm font-medium text-encre-2 hover:text-encre transition-colors"
      >
        Me contacter
      </a>
      <a href="/reserver" class="btn btn-noir hidden sm:inline-flex">
        <Roll texte="Prendre rendez-vous" fleche="↗" />
      </a>
      <a href="/reserver" class="btn btn-noir sm:hidden px-3.5 py-2.5 text-sm">
        <Roll texte="Réserver" />
      </a>

      <!-- Menu mobile : disclosure natif, sans JavaScript -->
      <details class="lg:hidden group relative">
        <summary
          class="list-none cursor-pointer p-2 rounded text-encre hover:bg-brume"
          aria-label="Ouvrir le menu"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </summary>
        <nav
          aria-label="Navigation mobile"
          class="absolute right-0 top-full mt-3 w-72 p-2 bg-white rounded-md border border-filet shadow-[0_12px_32px_rgb(13_13_20/0.12)] z-50"
        >
          <ul class="flex flex-col gap-1">
            {
              liens.map((lien) => (
                <li>
                  <a
                    href={lien.href}
                    aria-current={estActif(lien) ? "page" : undefined}
                    class:list={[
                      "block px-3 py-2.5 rounded text-[15px] font-medium",
                      estActif(lien) ? "bg-brume text-encre" : "text-encre-2 hover:bg-brume",
                    ]}
                  >
                    {lien.label}
                  </a>
                </li>
              ))
            }
            <li class="p-1 pt-2 sm:hidden">
              <a href="/reserver" class="btn btn-noir w-full">
                <Roll texte="Prendre rendez-vous" fleche="↗" />
              </a>
            </li>
            <li class="px-3 py-2 text-sm text-encre-2">
              Une question ? Écrivez à{" "}
              <a href={`mailto:${ENTREPRISE.email}`} class="font-semibold text-encre break-all">
                {ENTREPRISE.email}
              </a>
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
