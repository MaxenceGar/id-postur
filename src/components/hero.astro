---
import "../styles/global.css";
---

<section
  class="relative from-white py-24 px-0 md:px-6 md:py-24 overflow-hidden max-w-7xl mx-auto"
>
  <div
    class="px-2 md:px-0 w-full md:w-[90%] grid grid-cols-1 md:grid-cols-2 mx-auto gap-12"
  >
    <!-- Texte -->
    <div class="text-left">
      <h1
        class="text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-6"
      >
        <p class="block">
          Étude posturale à
          <span class="text-id-postur-dark">Rennes</span>
        </p>
      </h1>
      <p class="text-base md:mx-0 mb-10">
        Améliorez votre bien-être, vos performances et votre confort sur votre
        vélo grâce à une étude posturale personnalisée et sur mesure.
      </p>
      <div class="mb-3">
        <a href="#formules" rel="nofollow">
          <p class="px-6 py-3 bg-id-postur-dark text-white text-center">
            Prendre rendez-vous
          </p>
        </a>
      </div>
    </div>

    <!-- Image -->
    <div class="relative h-full w-full">
      <img
        src="/images/id-postur-interieur.jpg"
        alt="Analyse posturale ID Postur"
        class="object-cover"
        loading="lazy"
      />
    </div>
  </div>
</section>

<div
  class="w-full max-w-6xl mx-auto bg-id-postur-dark my-12 text-white p-8 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8"
>
  <div
    class="md:w-1/2 flex flex-col justify-center text-center md:text-left order-2 md:order-1"
  >
    <h2 class="text-4xl md:text-5xl font-extrabold leading-tight mb-4">
      Carte Cadeau ID Postur
    </h2>
    <p class="text-base mb-8 max-w-md md:max-w-none mx-auto">
      Pour l'achat et le règlement de votre carte cadeau, veuillez me contacter
      directement par e-mail (idpostur@gmail.com) ou via message privé sur
      Instagram (@idpostur).
    </p>

    <a
      href="/id-postur-carte-cadeau.pdf"
      class="inline-block self-center md:self-start"
    >
      <div
        class="bg-white transition duration-300 text-id-postur-dark font-bold text-base uppercase tracking-wider px-8 py-4 shadow-lg transform hover:scale-105"
      >
        <p>Téléchargez la carte cadeau</p>
      </div>
    </a>
  </div>

  <div class="md:w-1/2 flex justify-center order-1 md:order-2">
    <img
      src="/images/carte-cadeau.png"
      alt="Illustration de la Carte Cadeau ID Postur"
      class="w-full max-w-xs md:max-w-md h-auto object-contain"
      loading="lazy"
    />
  </div>
</div>
