---
import { AVIS_GOOGLE, FICHE_GOOGLE } from "../data/entreprise";

/**
 * Hero de l'accueil, DA « Atelier » : accroche à gauche, vidéo de séance à
 * droite avec des badges flottants (avis, fondateur, précision). Le H1 porte
 * le mot-clé local ; le grand titre visuel suit juste dessous.
 */
---

<section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 pt-10 pb-16 md:pt-14 md:pb-24">
  <div class="grid gap-14 lg:gap-16 lg:grid-cols-[1fr_1.05fr] items-center">
    <!-- Texte -->
    <div class="flex flex-col gap-7 animate-fade-in-left">
      <h1 class="pastille pastille-rose font-sans tracking-normal">
        Étude posturale vélo à Rennes
      </h1>
      <p
        class="font-id-postur text-[2.75rem] sm:text-6xl xl:text-7xl font-semibold leading-[1.02] tracking-[-0.04em] text-encre"
      >
        Votre position,<br /><span class="accent">sur mesure</span>.
      </p>
      <p class="text-lg md:text-[19px] leading-relaxed text-encre-2 max-w-xl">
        Améliorez votre bien-être, vos performances et votre confort sur le vélo
        grâce à une étude posturale personnalisée, menée par un ancien coureur
        professionnel.
      </p>
      <div class="flex flex-wrap gap-3">
        <a href="/reserver" class="btn btn-rouge">
          Prendre rendez-vous <span aria-hidden="true">↗</span>
        </a>
        <a href="#formules" class="btn btn-contour">Voir les tarifs</a>
      </div>
      <div class="flex items-center gap-3.5 pt-2">
        <div class="flex -space-x-2.5" aria-hidden="true">
          <img src="/images/romain-hardy-studio.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
          <img src="/images/etude-posturale-3d-capture.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
          <img src="/images/etudes-posturales-studio.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
        </div>
        <p class="text-sm font-medium text-encre-2">
          800+ cyclistes accompagnés depuis 2023
        </p>
      </div>
    </div>

    <!-- Vidéo + badges -->
    <div class="relative animate-fade-in-right sm:pl-6 sm:pb-6">
      <div class="hero-media overflow-hidden rounded-md">
        <video
          class="w-full h-auto aspect-[4/5] sm:aspect-[5/5] object-cover"
          width="1280"
          height="720"
          poster="/images/hero-etude-posturale-poster.webp"
          autoplay
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="auto"
          aria-label="Séance d'étude posturale chez ID Postur : examen sur table, réglage du vélo et analyse du pédalage par capture de mouvement"
        >
          <source src="/videos/hero-etude-posturale.mp4" type="video/mp4" />
        </video>
        <img
          class="hero-media-fixe w-full h-auto aspect-[4/5] sm:aspect-[5/5] object-cover"
          src="/images/hero-etude-posturale-poster.webp"
          alt="Romain Hardy examine une cycliste allongée sur la table, dans le studio ID Postur"
          width="1280"
          height="720"
          loading="lazy"
        />
      </div>

      <a
        href={FICHE_GOOGLE}
        target="_blank"
        rel="noopener"
        aria-label={`Voir nos ${AVIS_GOOGLE.nombre} avis Google, note 5 sur 5`}
        class="badge-flottant absolute left-3 sm:left-0 bottom-3 sm:bottom-16 px-4 py-3 flex flex-col gap-0.5 hover:-translate-y-0.5 transition-transform"
      >
        <span class="text-sm text-amber-500 tracking-tight" aria-hidden="true">★★★★★</span>
        <span class="text-[15px] font-semibold text-encre">5,0 · {AVIS_GOOGLE.nombre} avis Google</span>
      </a>

      <div class="badge-flottant absolute right-3 top-3 sm:-right-4 sm:top-8 hidden sm:flex items-center gap-3 py-3 pl-3 pr-5">
        <img src="/images/romain-hardy-studio.webp" alt="" width="44" height="44" class="size-11 rounded-full object-cover" />
        <span class="flex flex-col">
          <span class="text-[15px] font-semibold text-encre">Romain Hardy</span>
          <span class="text-[13px] text-encre-2">Ancien coureur pro</span>
        </span>
      </div>

      <div class="absolute right-3 bottom-3 sm:right-6 sm:bottom-14 hidden sm:flex items-center gap-2.5 rounded bg-encre px-4 py-2.5 text-sm font-medium text-white">
        <span class="size-2 rounded-full bg-[#ff3b3b]" aria-hidden="true"></span>
        Précision &lt; 1 mm
      </div>
    </div>
  </div>
</section>
