---
import Roll from "./Roll.astro";

/**
 * Hero de l'accueil, DA « Atelier » : accroche à gauche, vidéo de séance à
 * droite. Le H1 porte le mot-clé local ; le grand titre visuel suit juste
 * dessous.
 */
---

<section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 pt-10 pb-16 md:pt-14 md:pb-24">
  <div class="grid gap-14 lg:gap-16 lg:grid-cols-[1fr_1.05fr] items-center">
    <!-- Texte -->
    <div class="flex flex-col gap-7 animate-fade-in-left">
      <h1 class="pastille font-sans tracking-normal">
        Étude posturale vélo à Rennes
      </h1>
      <p
        class="font-id-postur text-[2.75rem] sm:text-6xl xl:text-7xl font-semibold leading-[1.02] tracking-[-0.04em] text-encre"
      >
        Votre position,<br /><span class="accent">sur mesure</span>.
      </p>
      <p class="text-lg md:text-[19px] leading-relaxed text-encre-2 max-w-xl">
        Améliorez votre bien-être, vos performances et votre confort sur le vélo
        grâce à une étude posturale personnalisée, menée par un ancien coureur
        professionnel.
      </p>
      <div class="flex flex-col sm:flex-row gap-3">
        <a href="/reserver" class="btn btn-rouge py-4 sm:py-3.5">
          <Roll texte="Prendre rendez-vous" fleche="↗" />
        </a>
        <a href="#formules" class="btn btn-contour py-4 sm:py-3.5"><Roll texte="Voir les tarifs" /></a>
      </div>
      <div class="flex items-center gap-3.5 pt-2">
        <div class="flex -space-x-2.5" aria-hidden="true">
          <img src="/images/romain-hardy-studio.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
          <img src="/images/etude-posturale-3d-capture.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
          <img src="/images/etudes-posturales-studio.webp" alt="" width="36" height="36" class="size-9 rounded-full object-cover ring-2 ring-white" />
        </div>
        <p class="text-sm font-medium text-encre-2">
          1000+ positions réalisées depuis 2023
        </p>
      </div>
    </div>

    <!-- Vidéo + badges -->
    <div class="animate-fade-in-right">
      <div class="hero-media overflow-hidden rounded-md">
        <video
          class="w-full h-auto aspect-[4/5] sm:aspect-[5/5] object-cover"
          width="540"
          height="540"
          poster="/images/hero-etude-posturale-poster.webp"
          muted
          loop
          playsinline
          disablepictureinpicture
          preload="none"
          data-video-differee
          aria-label="Séance d'étude posturale chez ID Postur : examen sur table, réglage du vélo et analyse du pédalage par capture de mouvement"
        >
          {/* Vidéo recadrée au carré (le cadre ne montre jamais plus), 540 px, ~730 Ko.
              Source posée par le script ci-dessous, après le chargement de la page. */}
        </video>
        <img
          class="hero-media-fixe w-full h-auto aspect-[4/5] sm:aspect-[5/5] object-cover"
          src="/images/hero-etude-posturale-poster.webp"
          alt="Romain Hardy examine une cycliste allongée sur la table, dans le studio ID Postur"
          width="1280"
          height="720"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</section>

<script>
  // La vidéo ne se charge qu'une fois la page affichée : l'affiche (poster)
  // occupe le cadre d'ici là, et le premier écran ne l'attend pas.
  const video = document.querySelector<HTMLVideoElement>("[data-video-differee]");
  const lancer = () => {
    if (!video || matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    video.src = "/videos/hero-etude-posturale.mp4";
    video.play().catch(() => {});
  };
  if (document.readyState === "complete") lancer();
  else addEventListener("load", lancer, { once: true });
</script>
