---
import "../styles/global.css";
---

<section
  class="relative from-white py-24 px-0 md:px-6 md:py-24 overflow-hidden"
>
  <div
    class="px-2 md:px-0 w-full md:w-[90%] mx-auto flex-row md:flex items-center gap-12"
  >
    <!-- Texte -->
    <div class="text-left">
      <h1
        class="text-4xl md:text-6xl font-extrabold text-gray-900 leading-tight mb-6"
      >
        <p class="block">
          Étude posturale à
          <span class="text-id-postur-dark">Rennes</span>
        </p>
      </h1>
      <p class="text-base md:mx-0 mb-10">
        Améliorez votre bien-être, vos performances et votre confort sur votre
        vélo grâce à une étude posturale personnalisée et sur mesure.
      </p>
      <div class="mb-3">
        <a href="#formules" rel="nofollow">
          <p class="px-6 py-3 bg-id-postur-dark text-white text-center">
            Prendre rendez-vous
          </p>
        </a>
      </div>
      <div class="text-cente text-black border-1 border-gray-400">
        <p class="mx-6 my-3">
          <span class="font-bold">Carte cadeau disponible !</span> Contactez moi
          par e-mail ou sur Instagram (@IDPostur)
        </p>
      </div>
    </div>

    <!-- Image -->
    <div class="relative h-full w-full">
      <img
        src="/images/id-postur-interieur.jpg"
        alt="Analyse posturale ID Postur"
        class="object-cover"
        loading="lazy"
      />
    </div>
  </div>
</section>
