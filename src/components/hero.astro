---
import "../styles/global.css";
---

<section
  class="relative from-white py-12 px-0 md:px-6 md:py-24 overflow-hidden mx-auto"
>
  <div
    class="px-2 md:px-0 w-full md:w-[90%] grid grid-cols-1 md:grid-cols-2 mx-auto gap-12 items-center"
  >
    <!-- Texte -->
    <div class="text-left animate-fade-in-left">
      <h1
        class="text-encre mb-6"
      >
        <span class="block">
          Étude posturale à
          <span class="text-rouge">Rennes</span>
        </span>
      </h1>
      <p class="text-base md:mx-0 mb-6">
        Améliorez votre bien-être, vos performances et votre confort sur votre
        vélo grâce à une étude posturale personnalisée et sur mesure.
      </p>

      <a
        href="https://www.google.com/maps?cid=9269044768465958318"
        target="_blank"
        rel="noopener"
        aria-label="Voir nos 78 avis Google, note 5 sur 5"
        class="group inline-flex items-center gap-3 bg-white border border-hairline pl-3 pr-4 py-2 mb-8 shadow-sm hover:shadow-md hover:border-hairline-2 transition-all"
      >
        <svg
          class="w-5 h-5 shrink-0"
          viewBox="0 0 24 24"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            fill="#4285F4"
            d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"
          ></path>
          <path
            fill="#34A853"
            d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"
          ></path>
          <path
            fill="#FBBC05"
            d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"
          ></path>
          <path
            fill="#EA4335"
            d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"
          ></path>
        </svg>
        <span class="flex items-center gap-1.5">
          <span class="font-semibold text-encre">5,0</span>
          <span
            class="text-amber-400 text-base leading-none tracking-tighter"
            aria-hidden="true">★★★★★</span
          >
        </span>
        <span class="text-gris-clair" aria-hidden="true">|</span>
        <span class="text-sm text-corps">78 avis Google</span>
        <svg
          class="w-4 h-4 text-gris-clair shrink-0 transition-transform group-hover:translate-x-0.5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M9 5l7 7-7 7"></path>
        </svg>
      </a>

      <div class="mb-3">
        <a href="#formules" rel="nofollow">
          <p
            class="btn-primaire btn-fleche w-full"
          >
            Prendre rendez-vous
          </p>
        </a>
      </div>
    </div>

    <!-- Image -->
    <div class="relative h-full w-full animate-fade-in-right">
      <img
        src="/images/id-postur-interieur.webp"
        alt="Studio d'analyse posturale ID Postur : home-trainer, table et mur de selles"
        width="1536"
        height="1024"
        class="object-cover"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <div
    class="w-full max-w-6xl mx-auto bg-white border border-hairline rounded-xs shadow-carte my-12 p-8 md:p-16 flex flex-col md:flex-row items-center justify-between gap-8"
  >
    <div
      class="md:w-1/2 flex flex-col justify-center text-center md:text-left order-2 md:order-1"
    >
      <p class="kicker text-label mb-4 justify-center md:justify-start">
        Idée cadeau
      </p>
      <h2 class="mb-4">
        Carte Cadeau ID Postur
      </h2>
      <p class="text-base mb-8 max-w-md md:max-w-none mx-auto">
        Pour l'achat et le règlement de votre carte cadeau, veuillez me
        contacter directement par e-mail (idpostur@gmail.com) ou via message
        privé sur Instagram (@idpostur).
      </p>

      <a
        href="/id-postur-carte-cadeau.pdf"
        class="btn-primaire btn-fleche self-center md:self-start"
      >
        Téléchargez la carte cadeau
      </a>
    </div>

    <div class="md:w-1/2 flex justify-center order-1 md:order-2">
      <img
        src="/images/carte-cadeau-id-postur.webp"
        alt="Illustration de la Carte Cadeau ID Postur"
        class="w-full max-w-xs md:max-w-md h-auto object-contain"
        loading="lazy"
      />
    </div>
  </div>
</section>
