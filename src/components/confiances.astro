---
import ConfianceTabs from "./confiance-tabs.astro"
---

<section class="relative">
  <div class="mx-auto px-4 sm:px-6 lg:px-8 my-16 z-20 container">
    <h2 class="text-gray-900 text-center">
      Ils m'ont fait confiance
    </h2>

    <div class="h-[3px] w-24 bg-id-postur-dark mx-auto mt-4 mb-10 rounded-full"></div>

    <div class="relative overflow-hidden">
      <!-- ligne 1 -->
      <div class="flex gap-6 sm:gap-6 animate-marquee">
        <ConfianceTabs />
        <ConfianceTabs />
      </div>

      <div class="h-full w-24 absolute top-0 right-0 bg-gradient-to-l from-white to-transparent"></div>
      <div class="h-full w-24 absolute top-0 left-0 bg-gradient-to-r from-white to-transparent"></div>
</section>
