---
import { ENTREPRISE } from "../data/entreprise";
import { BESOINS } from "../data/parcours";

const [etude, ...courts] = BESOINS;

/**
 * Porte d'entrée du parcours de réservation : chaque besoin ouvre /reserver
 * directement à la bonne question (?besoin=…). Le parcours se charge ensuite
 * de demander si le cycliste est déjà client, avant d'afficher un tarif.
 */
---

<section class="bg-[#f4f4f4] py-16 border-y border-[#e4e4e4]" id="formules">
  <div class="container mx-auto px-5">
    <div class="lg:w-full mb-6 lg:mb-10">
      <h2 class="sm:text-4xl text-3xl font-bold title-font mb-3 text-gray-900">
        Votre posture entre de bonnes mains
      </h2>
      <div class="h-1 w-24 bg-id-postur-dark mb-4"></div>
      <p class="text-gray-700">
        Que souhaitez-vous faire ? Choisissez, on vous guide jusqu'au bon créneau.
      </p>
    </div>

    {/* L'étude posturale, ouverte à tous, en grand ; puis les rendez-vous
        courts, réservés aux clients. */}
    <a
      href={`/reserver?besoin=${etude.id}`}
      class="declenche-fleche group grid md:grid-cols-2 bg-white border-2 border-id-postur-dark overflow-hidden transition-all duration-200 hover:shadow-lg motion-safe:hover:-translate-y-1"
    >
      <img
        src="/images/etude-posturale-3d-capture.webp"
        alt="Étude posturale d'une cycliste sur home-trainer, analysée en capture de mouvement chez ID Postur"
        class="object-cover w-full h-56 md:h-full"
        loading="lazy"
      />
      <div class="flex flex-col justify-center p-6 md:p-10">
        <h3 class="text-2xl md:text-3xl font-semibold text-gray-900 mb-3">{etude.titre}</h3>
        <p class="text-gray-700 mb-6">{etude.detail} En 3D ou en 2D, avec la capture de mouvement STT.</p>
        <span class="btn-fleche self-start px-6 py-3 bg-id-postur-dark text-white font-medium">
          Je commence
        </span>
      </div>
    </a>

    <h3 class="text-lg font-semibold text-gray-900 mt-10 mb-4">
      Déjà client ID Postur ?
    </h3>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4">
      {
        courts.map((b) => (
          <a
            href={`/reserver?besoin=${b.id}`}
            class="declenche-fleche group flex flex-col bg-white p-5 border-2 border-gray-200 transition-all duration-200 hover:border-id-postur-dark hover:shadow-lg motion-safe:hover:-translate-y-1"
          >
            <h4 class="font-semibold text-gray-900 mb-2">{b.titre}</h4>
            <p class="text-sm text-gray-600 flex-1 mb-4">{b.detail}</p>
            <span class="btn-fleche self-start text-sm font-semibold text-id-postur-dark">
              C'est parti
            </span>
          </a>
        ))
      }
    </div>

    <p class="mt-6 text-sm text-center text-gray-700">
      <a
        href="/etude-posturale-3d-ou-2d"
        class="text-id-postur-dark font-semibold underline hover:opacity-80"
        >Quelle différence entre la 3D et la 2D ?</a
      >
    </p>
    <div
      class="border-id-postur-dark border-2 text-center mt-4 overflow-hidden bg-white"
    >
      <p class="py-4 px-4 text-base text-center">
        Vous pouvez aussi prendre rendez-vous par téléphone au <a
          href={`tel:${ENTREPRISE.telephone}`}
          class="text-id-postur-dark font-bold">{ENTREPRISE.telephoneAffiche}</a
        >
      </p>
    </div>
  </div>
</section>

<section class="container mx-auto px-5 sm:px-6 lg:px-8 py-12">
  <div class="lg:w-full mb-6 lg:mb-10">
    <h2 class="sm:text-4xl text-3xl font-bold title-font mb-3 text-gray-900">
      Pour en savoir plus sur ID Postur avant de prendre rendez-vous 👇
    </h2>
    <div class="h-1 w-24 bg-id-postur-dark"></div>
  </div>
  <div class="flex flex-col md:flex-row justify-center items-stretch gap-8">
    <div class="w-full md:w-1/2">
      <div class="aspect-video overflow-hidden shadow-2xl">
        <iframe
          class="w-full h-full"
          src="https://www.youtube-nocookie.com/embed/5iGajrIt3I0?si=HbiRRXqWhc0Tr2tv"
          title="Vidéo 1 : Aperçu des fonctionnalités ID Postur"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        >
        </iframe>
      </div>
    </div>

    <div class="w-full md:w-1/2">
      <div class="aspect-video overflow-hidden shadow-2xl">
        <iframe
          class="w-full h-full"
          src="https://www.youtube-nocookie.com/embed/9cvgGC2bqQ0?si=DTMPE88Pc0eN6rET"
          title="Vidéo 2 : Cas d'utilisation et bénéfices ID Postur"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>
