---
import { formatPrix, getPrestation } from "../data/tarifs";

const etude3D = getPrestation("etude-posturale-3d");
const etude2D = getPrestation("etude-posturale-2d");
const cales = getPrestation("reglage-cales");
const choixVelo = getPrestation("choix-nouveau-velo");
const rdvDivers = getPrestation("rendez-vous-divers");

const offres = [
  {
    // Passe par l'étape de tri : le cycliste indique d'abord s'il est déjà venu.
    href: "/reserver",
    image: "/images/id-postur-img-2.webp",
    alt: "Étude posturale ID Postur",
    titre: "Étude posturale",
    tarif: `${formatPrix(etude3D.price)} en 3D (${etude3D.duration}) · ${formatPrix(etude2D.price)} en 2D (${etude2D.duration})`,
  },
  {
    href: "/cales",
    image: "/images/id-postur-cales.webp",
    alt: "Réglage des cales ID Postur",
    titre: "Réglage des cales",
    tarif: `${formatPrix(cales.price)} · ${cales.duration}`,
  },
  {
    href: "/choix-nouveau-velo",
    image: "/images/id-postur-img-1.webp",
    alt: "Aide au choix d'un nouveau vélo ID Postur",
    titre: "Choix de votre nouveau vélo",
    tarif: `${formatPrix(choixVelo.price)} · ${choixVelo.duration}`,
  },
  {
    href: "/rendez-vous-divers",
    image: "/images/id-postur-interieur.webp",
    alt: "Rendez-vous divers ID Postur",
    titre: "Rendez-vous divers",
    tarif: `${formatPrix(rdvDivers.price)} · ${rdvDivers.duration}`,
  },
];
---

<section class="bg-papier py-16 md:py-[104px] border-y border-hairline" id="formules">
  <div class="container mx-auto px-5">
    <div class="lg:w-full mb-6 lg:mb-10">
      <p class="kicker text-label mb-4">Prestations</p>
      <h2 class="mb-3 text-encre">
        Votre posture entre de bonnes mains
      </h2>
      <div class="h-1 w-24 bg-rouge"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      <div
        class="flex flex-col bg-white border border-hairline rounded-xs shadow-carte overflow-hidden"
      >
        <img
          src={offres[0].image}
          alt={offres[0].alt}
          class="object-cover w-full h-64"
          loading="lazy"
        />
        <div class="flex flex-col flex-1 px-4 pt-5 pb-6 text-center">
          <h3 class="mb-3">{offres[0].titre}</h3>
          <p
            class="flex-1 mb-4 text-sm text-left leading-relaxed text-corps"
          >
            Une analyse réalisée avec la technologie de capture de mouvement <strong
              >STT</strong
            >. Nous mesurons vos angles, vos appuis et vos déséquilibres pour
            vous proposer une position qui réduit les douleurs, augmente la
            puissance et améliore votre confort.
            <br /><br />
            Deux formats au choix — <strong>3D</strong> ou <strong>2D</strong>.
            La 3D couvre toutes les disciplines, chrono et triathlon compris ;
            la 2D s'adresse à la route, au VTT et au gravel.
          </p>
          <p class="text-data text-encre mb-4">
            {offres[0].tarif}
          </p>
          <a
            class="self-center btn-primaire btn-fleche"
            href={offres[0].href}
          >
            Prendre rendez-vous
          </a>
          <a
            class="mt-3 text-sm text-rouge underline hover:opacity-80"
            href="/etude-posturale-3d-ou-2d"
          >
            Quelle différence entre la 3D et la 2D ?
          </a>
        </div>
      </div>

      <div
        class="flex flex-col bg-white border border-hairline rounded-xs shadow-carte overflow-hidden"
      >
        <img
          src={offres[1].image}
          alt={offres[1].alt}
          class="object-cover w-full h-64"
          loading="lazy"
        />
        <div class="flex flex-col flex-1 px-4 pt-5 pb-6 text-center">
          <h3 class="mb-3">{offres[1].titre}</h3>
          <p
            class="flex-1 mb-4 text-sm text-left leading-relaxed text-corps"
          >
            Nous réglons vos cales au millimètre près pour améliorer
            l'alignement de vos membres, assurer un pédalage fluide et prévenir
            les douleurs aux genoux, hanches ou pieds.
            <br /><br />
            Une connexion parfaite entre vous et votre vélo pour un rendement maximal.
          </p>
          <p class="text-data text-encre mb-4">
            {offres[1].tarif}
          </p>
          <a
            class="self-center btn-primaire btn-fleche"
            href={offres[1].href}
          >
            Prendre rendez-vous
          </a>
        </div>
      </div>

      <div
        class="flex flex-col bg-white border border-hairline rounded-xs shadow-carte overflow-hidden"
      >
        <img
          src={offres[2].image}
          alt={offres[2].alt}
          class="object-cover w-full h-64"
          loading="lazy"
        />
        <div class="flex flex-col flex-1 px-4 pt-5 pb-6 text-center">
          <h3 class="mb-3">{offres[2].titre}</h3>
          <p
            class="flex-1 mb-4 text-sm text-left leading-relaxed text-corps"
          >
            Vous hésitez avant d'acheter un nouveau vélo ? <strong
              >ID Postur</strong
            > vous aide à vérifier la taille, l'ergonomie et à valider votre choix
            avant l'achat.
            <br /><br />
            Un rendez-vous court pour sécuriser votre investissement.
          </p>
          <p class="text-data text-encre mb-4">
            {offres[2].tarif}
          </p>
          <a
            class="self-center btn-primaire btn-fleche"
            href={offres[2].href}
          >
            Prendre rendez-vous
          </a>
        </div>
      </div>

      <div
        class="flex flex-col bg-white border border-hairline rounded-xs shadow-carte overflow-hidden"
      >
        <img
          src={offres[3].image}
          alt={offres[3].alt}
          class="object-cover w-full h-64"
          loading="lazy"
        />
        <div class="flex flex-col flex-1 px-4 pt-5 pb-6 text-center">
          <h3 class="mb-3">{offres[3].titre}</h3>
          <p
            class="flex-1 mb-4 text-sm text-left leading-relaxed text-corps"
          >
            Besoin d'une petite révision, d'un <strong>micro-réglage</strong> ou
            d'un <strong>conseil ponctuel</strong> ?
            <br /><br />
            Un créneau court pour répondre à un besoin précis, sans passer par une
            étude complète.
          </p>
          <p class="text-data text-encre mb-4">
            {offres[3].tarif}
          </p>
          <a
            class="self-center btn-primaire btn-fleche"
            href={offres[3].href}
          >
            Prendre rendez-vous
          </a>
        </div>
      </div>
    </div>
    <div
      class="border border-hairline rounded-xs shadow-carte text-center mt-4 overflow-hidden bg-white"
    >
      <p class="py-4 px-4 text-base text-center">
        Vous pouvez aussi prendre rendez-vous par téléphone au <a
          href="tel:0607167323"
          class="text-rouge font-bold">06 07 16 73 23</a
        >
      </p>
    </div>
  </div>
</section>

<section class="container mx-auto px-5 sm:px-6 lg:px-8 py-12">
  <div class="lg:w-full mb-6 lg:mb-10">
    <h2 class="mb-3 text-encre">
      Pour en savoir plus sur ID Postur avant de prendre rendez-vous 👇
    </h2>
    <div class="h-1 w-24 bg-rouge"></div>
  </div>
  <div class="flex flex-col md:flex-row justify-center items-stretch gap-8">
    <div class="w-full md:w-1/2">
      <div class="aspect-video overflow-hidden shadow-2xl">
        <iframe
          class="w-full h-full"
          src="https://www.youtube-nocookie.com/embed/5iGajrIt3I0?si=HbiRRXqWhc0Tr2tv"
          title="Vidéo 1 : Aperçu des fonctionnalités ID Postur"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        >
        </iframe>
      </div>
    </div>

    <div class="w-full md:w-1/2">
      <div class="aspect-video overflow-hidden shadow-2xl">
        <iframe
          class="w-full h-full"
          src="https://www.youtube-nocookie.com/embed/9cvgGC2bqQ0?si=DTMPE88Pc0eN6rET"
          title="Vidéo 2 : Cas d'utilisation et bénéfices ID Postur"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
          loading="lazy"
        >
        </iframe>
      </div>
    </div>
  </div>
</section>
