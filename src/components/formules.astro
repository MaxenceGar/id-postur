---

import '../styles/global.css'

---

<section class="bg-gray-100 py-16">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

    <h3 class="text-center my-8 text-2xl font-bold">Nos offres pour le réglage de votre vélo</h3>

    <!-- Grid des offres -->
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">

      <!-- Étude posturale complète -->
      <div class="relative flex flex-col h-full bg-white shadow-sm border border-gray-200">
        <div class="absolute -top-3 left-4 inline-flex items-center bg-[#C00201] px-3 py-1 text-xs font-semibold text-white shadow">
          Offre la plus complète
        </div>
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Étude posturale complète
          </h3>
          <p class="text-sm text-gray-500 mb-4">
            Analyse complète de votre position pour optimiser confort et performance.
          </p>
          <div class="mb-4">
            <span class="text-3xl font-bold text-gray-900">280€</span>
          </div>
          <p class="text-sm font-medium text-gray-700 mb-4">
            ⏱ Durée : <span class="font-semibold">2 heures</span>
          </p>
          <ul class="text-sm text-gray-600 space-y-1 mb-6">
            <li>Équipement à apporter :</li>
            <li>• Vélo</li>
            <li>• Chaussures</li>
            <li>• Cuissard</li>
            <li>• Maillot</li>
            <li>• Pièces spécifiques à votre vélo</li>
          </ul>
          <div class="mt-auto">
            <button class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-white bg-[#C00201] hover:bg-[#C00201]/90 transition">
              Réserver une étude complète
            </button>
          </div>
        </div>
      </div>

      <!-- Étude posturale complète -15 ans -->
      <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Étude posturale complète <span class="text-sm text-[#C00201] font-semibold">(-15 ans)</span>
          </h3>
          <p class="text-sm text-gray-500 mb-4">
            Étude adaptée aux jeunes cyclistes en croissance.
          </p>
          <div class="mb-4">
            <span class="text-3xl font-bold text-gray-900">120€</span>
          </div>
          <p class="text-sm font-medium text-gray-700 mb-4">
            ⏱ Durée : <span class="font-semibold">1 heure</span>
          </p>
          <ul class="text-sm text-gray-600 space-y-1 mb-6">
            <li>Équipement à apporter :</li>
            <li>• Vélo</li>
            <li>• Chaussures</li>
            <li>• Cuissard</li>
            <li>• Maillot</li>
            <li>• Pièces spécifiques à votre vélo</li>
          </ul>
          <div class="mt-auto">
            <button class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition">
              Réserver pour un jeune cycliste
            </button>
          </div>
        </div>
      </div>

      <!-- Réglages nouveau vélo -->
      <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Réglages nouveau vélo
          </h3>
          <p class="text-sm text-gray-500 mb-4">
            Ajustement rapide après changement de vélo.
          </p>
          <div class="mb-4">
            <p class="text-3xl font-bold text-gray-900">50€</p>
            <span class="text-xs font-semibold text-gray-900">Gratuit dans les 6 mois</span>
          </div>
          <p class="text-sm font-medium text-gray-700 mb-4">
            ⏱ Durée : <span class="font-semibold">30 minutes</span>
          </p>
          <ul class="text-sm text-gray-600 space-y-1 mb-6">
            <li>Équipement à apporter :</li>
            <li>• Vélo</li>
            <li>• Chaussures</li>
            <li>• Cuissard</li>
            <li>• Maillot</li>
            <li>• Pièces spécifiques à votre vélo</li>
          </ul>
          <div class="mt-auto">
            <button class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition">
              Ajuster mon nouveau vélo
            </button>
          </div>
        </div>
      </div>

    </div>

    <h3 class="text-center my-8 text-2xl font-bold">Nos offres pour le réglage de vos cales</h3>

    <div class="grid md:grid-cols-1 lg:grid-cols-2 gap-8">

      <!-- Réglages cales -->
      <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Réglages cales
          </h3>
          <p class="text-sm text-gray-500 mb-4">
            Positionnement précis de vos cales pour un pédalage fluide et efficace.
          </p>
          <div class="mb-4">
            <span class="text-3xl font-bold text-gray-900">50€</span>
          </div>
          <p class="text-sm font-medium text-gray-700 mb-4">
            ⏱ Durée : <span class="font-semibold">30 minutes</span>
          </p>
          <ul class="text-sm text-gray-600 space-y-1 mb-6">
            <li>Équipement à apporter :</li>
            <li>• Vélo</li>
            <li>• Chaussures</li>
            <li>• Cuissard</li>
            <li>• Maillot</li>
            <li>• Pièces spécifiques à votre vélo</li>
          </ul>
          <div class="mt-auto">
            <button class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition">
              Prendre rendez-vous
            </button>
          </div>
        </div>
      </div>

      <!-- Réglages changement de cales / nouvelles chaussures -->
      <div class="flex flex-col h-full bg-white shadow-sm border border-gray-200">
        <div class="p-6 flex-1 flex flex-col">
          <h3 class="text-xl font-semibold text-gray-900 mb-2">
            Nouvelles cales ou nouvelles chaussures
          </h3>
          <p class="text-sm text-gray-500 mb-4">
            Ajustement après changement de matériel.
          </p>
          <div class="mb-4">
            <span class="text-3xl font-bold text-gray-900">30€</span>
          </div>
          <p class="text-sm font-medium text-gray-700 mb-4">
            ⏱ Durée : <span class="font-semibold">20 minutes</span>
          </p>
          <ul class="text-sm text-gray-600 space-y-1 mb-6">
            <li>Équipement à apporter :</li>
            <li>• Vélo</li>
            <li>• Chaussures</li>
            <li>• Cuissard</li>
            <li>• Maillot</li>
            <li>• Pièces spécifiques à votre vélo</li>
          </ul>
          <div class="mt-auto">
            <button class="w-full inline-flex justify-center items-center px-4 py-2.5 text-sm font-semibold text-[#C00201] border border-[#C00201] bg-white hover:bg-[#C00201]/5 transition">
              Ajuster mes nouvelles cales
            </button>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
