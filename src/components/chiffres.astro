---
/** Bandeau de chiffres clés, juste sous le hero. */
const chiffres = [
  { valeur: "1000+", libelle: "positions réalisées" },
  { valeur: "25+", libelle: "athlètes pros accompagnés" },
  { valeur: "3 ans", libelle: "d'expérience terrain et analyse" },
  { valeur: "< 1 mm", libelle: "de précision en capture 3D" },
];
---

<section id="avantages" class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10">
  <dl class="grid grid-cols-2 lg:grid-cols-4 rounded-md border border-filet overflow-hidden">
    {
      chiffres.map((c, i) => (
        <div
          class:list={[
            "flex flex-col-reverse justify-end gap-1.5 p-6 md:p-8 border-filet",
            i % 2 === 1 && "border-l",
            i >= 2 && "border-t lg:border-t-0",
            i === 2 && "lg:border-l",
          ]}
        >
          <dt class="text-[15px] text-encre-2">{c.libelle}</dt>
          <dd class="font-id-postur text-4xl md:text-5xl font-semibold tracking-[-0.04em] text-encre">
            {c.valeur}
          </dd>
        </div>
      ))
    }
  </dl>
</section>
