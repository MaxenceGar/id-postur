---
/** Le fondateur, et les athlètes qui lui ont fait confiance. */
const pros = [
  { nom: "Warren Barguil", role: "Cycliste professionnel", photo: "/images/warren-barguil.webp" },
  { nom: "Amandine Fouquenet", role: "Cycliste professionnelle", photo: "/images/AmandineFouquenet.webp" },
  { nom: "Thibault Gernalec", role: "Cycliste professionnel", photo: "/images/thibaultgernalec.webp" },
  { nom: "Yann Guyot", role: "Triathlète", photo: "/images/yannguyot.jpg" },
  { nom: "Robin Lemercier", role: "Triathlète", photo: "/images/robin-lemercier.jpg" },
  { nom: "Florentin Lecamus", role: "Cycliste professionnel", photo: "/images/florentin-lecamus.jpg" },
  { nom: "Swan Gloux", role: "Cycliste professionnel", photo: "/images/Swan-gloux.jpg" },
];
---

<section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-28">
  <div class="grid gap-12 lg:gap-18 lg:grid-cols-[0.8fr_1.2fr] items-center">
    <img
      src="/images/romain-hardy-studio.webp"
      width="640"
      height="640"
      class="w-full max-w-md lg:max-w-none aspect-[6/7] object-cover rounded-md"
      alt="Romain Hardy, fondateur d'ID Postur, dans son studio d'étude posturale"
      loading="lazy"
    />

    <div class="flex flex-col gap-6">
      <p class="pastille">Le fondateur</p>
      <h2 class="text-3xl md:text-5xl leading-[1.08] tracking-[-0.035em] max-w-2xl">
        Le regard d'un ancien <span class="accent">coureur pro</span>.
      </h2>
      <p class="text-[17px] leading-relaxed text-encre-2 max-w-xl">
        <strong class="font-semibold text-encre">ID Postur</strong> est un centre
        d'étude posturale pour le cycliste, fondé en 2023 par
        <strong class="font-semibold text-encre">Romain Hardy</strong>, ancien
        cycliste professionnel. Route, VTT, gravel, triathlon&nbsp;: il met une
        expertise scientifique au service de chaque athlète, pour gagner en
        performance et réduire les douleurs.
      </p>

      <div class="flex flex-col gap-4 border-t border-filet pt-6">
        <p class="text-sm font-semibold text-encre">Ils lui ont fait confiance</p>
        <div class="flex flex-col sm:flex-row sm:items-center gap-4">
          <ul class="flex -space-x-2.5 shrink-0" aria-hidden="true">
            {pros.map((p) => (
              <li><img src={p.photo} alt="" width="48" height="48" loading="lazy" class="size-12 rounded-full object-cover object-top ring-2 ring-white" /></li>
            ))}
          </ul>
          <p class="text-sm leading-relaxed text-encre-2">
            {pros.map((p, i) => (
              <><span class="font-medium text-encre">{p.nom}</span><span class="text-encre-3">{` (${p.role.toLowerCase()})`}</span>{i < pros.length - 2 ? ", " : i === pros.length - 2 ? " et " : "."}</>
            ))}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
