---
import { fr } from "../lib/typo";
import {
  ETUDES_POSTURALES,
  PRESTATIONS_COURTES,
  PRIX_ENTREE_ETUDE,
  formatPrix,
} from "../data/tarifs";

export interface Props {
  /** Slug de la prestation à ne pas afficher (celle de la page courante). */
  exclude?: string;
  title?: string;
  /** Masque la carte « Étude posturale » (sur la page des études elle-même). */
  sansEtude?: boolean;
}

const { exclude, title = "Les autres prestations ID\u00a0Postur", sansEtude = false } = Astro.props;

const IMAGES: Record<string, string> = {
  "/etudes-posturales": "/images/etudes-posturales-studio.webp",
  "/cales": "/images/reglage-cales-pedale.webp",
  "/choix-nouveau-velo": "/images/choix-nouveau-velo-reglage.webp",
  "/rendez-vous-divers": "/images/rendez-vous-ajustement-selle.webp",
};

/** Une seule carte pour les études posturales : elles partagent la même page. */
const etude = ETUDES_POSTURALES[0];

const liens = [
  ...(sansEtude ? [] : [{
    href: etude.page,
    title: "Étude posturale 3D et 2D",
    description:
      "L'analyse complète de votre position sur le vélo, en 3D ou en 2D, pour gagner en confort et en performance.",
    prix: `à partir de ${formatPrix(PRIX_ENTREE_ETUDE)}`,
    duree: `${ETUDES_POSTURALES[1].duration} à ${etude.duration}`,
  }]),
  ...PRESTATIONS_COURTES.filter((p) => p.slug !== exclude).map((p) => ({
    href: p.page,
    title: p.title,
    description: p.description,
    prix: formatPrix(p.price),
    duree: p.duration,
  })),
];
---

<section class="max-w-7xl mx-auto px-5 md:px-8 lg:px-10 py-20 md:py-24 flex flex-col gap-10">
  <div class="flex flex-col gap-4">
    <p class="pastille">Autres prestations</p>
    <h2 class="text-3xl md:text-[2.5rem] leading-[1.06] tracking-[-0.035em]">{fr(title)}</h2>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {
      liens.map((lien) => (
        <a
          href={lien.href}
          class="carte-survol group flex md:flex-col items-center md:items-stretch gap-4 md:gap-0 p-3 md:p-0 rounded-md border border-filet overflow-hidden hover:border-encre-3"
        >
          <img src={IMAGES[lien.href]} alt="" width="600" height="340" loading="lazy" class="size-24 shrink-0 rounded md:rounded-none md:size-auto md:w-full aspect-square md:aspect-[16/9] object-cover" />
          <span class="flex grow flex-col gap-1.5 md:gap-2 md:p-6 min-w-0">
            <span class="font-id-postur text-xl font-semibold tracking-[-0.025em] text-encre">{lien.title}</span>
            <span class="hidden md:block text-sm leading-relaxed text-encre-2">{lien.description}</span>
            <span class="mt-auto flex items-center justify-between gap-3 md:pt-3 text-sm">
              <span class="font-semibold text-encre">{lien.prix} · {lien.duree}</span>
              <span class="grid place-items-center size-8 rounded bg-brume text-encre transition-colors group-hover:bg-encre group-hover:text-white"><span class="fleche" aria-hidden="true"><span>↗</span><span>↗</span></span></span>
            </span>
          </span>
        </a>
      ))
    }
  </div>
</section>
