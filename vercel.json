{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/premiere-ou-nouvelle/",
      "destination": "/etudes-posturales/",
      "permanent": true
    },
    {
      "source": "/etude-posturale-ou-cales/",
      "destination": "/etudes-posturales/",
      "permanent": true
    },
    {
      "source": "/nouveau-velo-ou-reglage/",
      "destination": "/etudes-posturales/",
      "permanent": true
    },
    {
      "source": "/etude-posturale/",
      "destination": "/etudes-posturales/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "prod.id-postur.fr"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
